.zig-cache/
zig-out/
zig-pkg/
*.o

# IDE & System
.DS_Store
.vscode/
build.log

# Node.js / Playwright
node_modules/
package-lock.json
playwright-report/
test-results/

# Generated example outputs
examples/*.png
examples/*.pngb
tools/playground/*.png
tools/playground/*.pngb

# NPM dist (regenerated by `zig build web-bundle`)
npm/pngine/dist/
npm/vite-plugin-pngine/dist/

# Compiler WASM shipped in the npm package (~1.6MB build product of
# `zig build wasm-compiler`, too churny to commit — unlike the 13KB
# executor at npm/pngine/wasm/pngine.wasm, which IS committed + drift-gated)
npm/pngine/wasm/pngine-compiler.wasm

# NPM platform binaries — build products (~43MB) of `zig build npm` +
# npm/pngine/scripts/prepare-publish.sh, regenerated per release, never committed.
# bin/pngine.cjs resolves them at runtime via require.resolve, so a fresh clone
# just needs one `zig build npm && ./npm/pngine/scripts/prepare-publish.sh`.
npm/pngine-*/bin/

# Coverage reports
coverage/

# Environment files
.env
.env.local

# Downloaded vendor libraries
vendor/
.claude/settings.local.json

# Scratch / local-only working files (never commit by accident)
tmp/

# Reference checkouts of other people's repositories. Scratch, never a
# dependency: scripts/convert-meshes.mjs and scripts/extract-webgpu-enums.mjs
# each name the clone they want when it is absent, and both regenerate
# committed artifacts, so a bare clone never needs this directory.
external/
