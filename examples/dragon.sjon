; Stanford dragon — a rotating jade-tinted dragon with Lambertian shading.
; Same machinery as teapot: the indexed `dragon` shape generator, an
; `:index-of` index buffer, a depth texture and draw-indexed, here with a
; position3+normal3+uv2 vertex format (stride 32).

(shader-module :name shader :code """
struct Inputs {
  time: f32,
  canvasW: f32,
  canvasH: f32,
  aspect: f32,
};
@group(0) @binding(0) var<uniform> u: Inputs;

fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0),
    vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1),
    vec4f(0, 0, far * near * nf, 0));
}

struct VSOut {
  @builtin(position) pos: vec4f,
  @location(0) normal: vec3f,
  @location(1) uv: vec2f,
};

@vertex fn vs(
  @location(0) position: vec3f,
  @location(1) normal: vec3f,
  @location(2) uv: vec2f
) -> VSOut {
  let t = u.time;

  // Rotate around Y axis
  let c = cos(t * 0.3);
  let s = sin(t * 0.3);
  let rotY = mat4x4f(
    vec4f(c, 0, s, 0),
    vec4f(0, 1, 0, 0),
    vec4f(-s, 0, c, 0),
    vec4f(0, 0, 0, 1));

  // Scale and center (dragon is roughly [-30, 30] range)
  let scale = 0.03;
  let model = rotY * mat4x4f(
    vec4f(scale, 0, 0, 0),
    vec4f(0, scale, 0, 0),
    vec4f(0, 0, scale, 0),
    vec4f(0, -0.8, 0, 1));

  let view = mat4x4f(
    vec4f(1, 0, 0, 0),
    vec4f(0, 1, 0, 0),
    vec4f(0, 0, 1, 0),
    vec4f(0, 0, -3, 1));

  let proj = perspective(1.0, u.aspect, 0.1, 100.0);
  let mv = view * model;
  let n = normalize((model * vec4f(normal, 0.0)).xyz);

  var out: VSOut;
  out.pos = proj * mv * vec4f(position, 1.0);
  out.normal = n;
  out.uv = uv;
  return out;
}

@fragment fn fs(
  @location(0) normal: vec3f,
  @location(1) uv: vec2f
) -> @location(0) vec4f {
  let lightDir = normalize(vec3f(1.0, 2.0, 3.0));
  let n = normalize(normal);
  let diffuse = max(dot(n, lightDir), 0.0);
  let ambient = 0.12;
  // Jade-like green tint
  let color = vec3f(0.3, 0.7, 0.4);
  let lit = color * (ambient + diffuse * 0.88);
  return vec4f(lit, 1.0);
}
""")

(data :name dragonMesh (dragon :format [position3 normal3 uv2]))

(buffer :name vertexBuffer :size dragonMesh :usage [vertex]
  :mapped-at-creation dragonMesh)

(buffer :name indexBuffer :index-of dragonMesh :usage [index])

(buffer :name uniforms :size 16 :usage [uniform copy-dst])

(texture :name depthTexture :size canvas :format depth24plus :usage [render-attachment])

(queue :name writeUniforms
  (write-buffer :buffer uniforms :offset 0 :data pngine-inputs))

(render-pipeline :name dragonPipeline
  (layout auto)
  (vertex (module shader) (entry vs)
    (buffers
      (vertex-buffer :array-stride 32
        (attribute :shader-location 0 :offset 0 :format float32x3)
        (attribute :shader-location 1 :offset 12 :format float32x3)
        (attribute :shader-location 2 :offset 24 :format float32x2))))
  (fragment (module shader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list) :cull-mode back)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(bind-group :name dragonBindGroup :layout-pipeline dragonPipeline :layout-index 0
  (entry :binding 0 :buffer uniforms))

(render-pass :name drawDragon
  (color-attachment :view context-current-texture :clear-value [0.1 0.1 0.15 1] :load-op clear :store-op store)
  (depth-attachment :view depthTexture :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  :pipeline dragonPipeline
  :vertex-buffers [vertexBuffer]
  :index-buffer indexBuffer
  :bind-groups [dragonBindGroup]
  (draw-indexed :index-count 33306))

(frame :name main :perform [writeUniforms drawDragon])
