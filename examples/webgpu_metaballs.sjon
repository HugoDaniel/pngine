; webgpu_metaballs — after the external `metaballs` sample linked from
; webgpu-samples (toji.github.io/webgpu-metaballs); fresh-authored on the
; webgpu_marching_cubes.sjon machinery. Six balls orbit on golden-angle-
; decorrelated Lissajous paths; each frame the 5-stage compute pipeline
; (clear, density, vertex-gen, index-gen, indirect-args) re-meshes the
; isosurface of the inverse-square field f(p) = sum r_i^2/|p-c_i|^2 - 1 on a
; 33^3 grid and renders it via `(draw-indexed-indirect …)` over the same
; ground plane.
;
; Departures from webgpu_marching_cubes.sjon:
; - The field is positive-inside directly (no SDF negation).
; - Normals are the negated central-difference field gradient; the AO
;   ray-march is dropped (ao = 1) — fresnel shading carries the depth cue.
; - The arcball is replaced by a stateless time-orbit camera, so there is no
;   pointer input and the image at time t is fully deterministic.
; Budget: 6 balls at r~3 give ~700 units^2 of shell over 1^3 cells, about 2k
; emitting cells — far under MAX_VERTICES 65536 / MAX_INDICES 262144; the
; indirect-args stage clamps the index count as the overflow backstop.

; Defines used in buffer :size expressions; :array-stride spells the literal
; 32 although VERTEX_STRIDE compiles byte-identical.
(define :name GRID_TOTAL_VERTS :value 35937)
(define :name MAX_VERTICES :value 65536)
(define :name MAX_INDICES :value 262144)
(define :name VERTEX_ID_MAP_SIZE :value 98304)
(define :name VERTEX_STRIDE :value 32)

; ── Ground Plane (mesh primitive) ──────────────────────────────────────

(data :name groundPlane (plane :format [position3 normal3]))

; ── Buffers ────────────────────────────────────────────────────────────

(buffer :name vertexBuffer :size (* MAX_VERTICES VERTEX_STRIDE)
  :usage [vertex storage])

; GPU-generated u32 indices: no :index-of companion, so the index format is
; declared explicitly (propagates to set_index_buffer).
(buffer :name indexBuffer :size (* MAX_INDICES 4) :usage [index storage]
  :index-format uint32)

(buffer :name atomicCounters :size 16 :usage [storage])

(buffer :name mvpBuffer :size 128 :usage [storage])

(buffer :name indirectDrawBuffer :size 20 :usage [indirect storage])

(buffer :name timeUniforms :size 16 :usage [uniform copy-dst])

(buffer :name groundVB :usage [vertex]
  :data groundPlane)

(buffer :name vertexIdMap :size (* VERTEX_ID_MAP_SIZE 4) :usage [storage])

(buffer :name densityBuffer :size (* GRID_TOTAL_VERTS 4) :usage [storage])

; ── Textures ───────────────────────────────────────────────────────────

(texture :name depthTexture :size canvas :format depth24plus
  :usage [render-attachment])

; ── Queue Operations ───────────────────────────────────────────────────

(queue :name writeTime
  (write-buffer :buffer timeUniforms :offset 0 :data pngine-inputs))




; ── Shader: Indirect Args ─────────────────────────────────────────

(shader-module :name indirectArgsShader :code """
@group(0) @binding(0) var<storage, read_write> counters: array<atomic<u32>, 4>;
@group(0) @binding(1) var<storage, read_write> indirect: array<u32, 5>;

@compute @workgroup_size(1)
fn main() {
  indirect[0] = min(atomicLoad(&counters[1]), 262144u); // indexCount
  indirect[1] = 1u; // instanceCount
  indirect[2] = 0u; // firstIndex
  indirect[3] = 0u; // baseVertex
  indirect[4] = 0u; // firstInstance
}
""")

; ── Shader: Clear ─────────────────────────────────────────────────

(shader-module :name clearShader :code """
@group(0) @binding(0) var<storage, read_write> counters: array<atomic<u32>, 4>;
@group(0) @binding(1) var<storage, read_write> indirect: array<u32, 5>;
@group(0) @binding(2) var<storage, read_write> vidMap: array<atomic<u32>>;

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) gid: vec3u) {
  let id = gid.x;
  // Clear atomic counters and indirect draw buffer
  if (id == 0u) {
    atomicStore(&counters[0], 0u); // vertex count
    atomicStore(&counters[1], 0u); // index count
    atomicStore(&counters[2], 0u);
    atomicStore(&counters[3], 0u);
    indirect[0] = 0u; // indexCount
    indirect[1] = 1u; // instanceCount
    indirect[2] = 0u; // firstIndex
    indirect[3] = 0u; // baseVertex
    indirect[4] = 0u; // firstInstance
  }
  // Clear vertex ID map
  if (id < 98304u) {
    atomicStore(&vidMap[id], 0xFFFFFFFFu);
  }
}
""")

; ── Shader: Index Generation ──────────────────────────────────────

(shader-module :name indexGenShader :code """
@group(0) @binding(0) var<storage, read> density: array<f32>;
@group(0) @binding(1) var<storage, read> vidMap: array<u32>;
@group(0) @binding(2) var<storage, read_write> indices: array<u32>;
@group(0) @binding(3) var<storage, read_write> counters: array<atomic<u32>, 4>;

const N: u32 = 32u;
const NV: u32 = 33u;

fn densityAt(x: u32, y: u32, z: u32) -> f32 {
  return density[z * NV * NV + y * NV + x];
}

const kCorner = array<vec3u, 8>(
  vec3u(0,0,0), vec3u(1,0,0), vec3u(1,1,0), vec3u(0,1,0),
  vec3u(0,0,1), vec3u(1,0,1), vec3u(1,1,1), vec3u(0,1,1)
);

// Maps each of 12 edges to (dx, dy, dz, axis) for the owning cell's primary edge.
// Paul Bourke convention: 0,2,4,6=X-axis(0); 1,3,5,7=Y-axis(1); 8-11=Z-axis(2)
const kEdgeToPrimary = array<vec4u, 12>(
  vec4u(0,0,0, 0), // edge 0:  X at (x,y,z)       [v0→v1]
  vec4u(1,0,0, 1), // edge 1:  Y at (x+1,y,z)     [v1→v2]
  vec4u(0,1,0, 0), // edge 2:  X at (x,y+1,z)     [v2→v3, reversed]
  vec4u(0,0,0, 1), // edge 3:  Y at (x,y,z)       [v3→v0, reversed]
  vec4u(0,0,1, 0), // edge 4:  X at (x,y,z+1)     [v4→v5]
  vec4u(1,0,1, 1), // edge 5:  Y at (x+1,y,z+1)   [v5→v6]
  vec4u(0,1,1, 0), // edge 6:  X at (x,y+1,z+1)   [v6→v7, reversed]
  vec4u(0,0,1, 1), // edge 7:  Y at (x,y,z+1)     [v7→v4, reversed]
  vec4u(0,0,0, 2), // edge 8:  Z at (x,y,z)       [v0→v4]
  vec4u(1,0,0, 2), // edge 9:  Z at (x+1,y,z)     [v1→v5]
  vec4u(1,1,0, 2), // edge 10: Z at (x+1,y+1,z)   [v2→v6]
  vec4u(0,1,0, 2)  // edge 11: Z at (x,y+1,z)     [v3→v7]
);

fn getVertexId(cx: u32, cy: u32, cz: u32, edgeIdx: u32) -> u32 {
  let e = kEdgeToPrimary[edgeIdx];
  let nx = cx + e.x;
  let ny = cy + e.y;
  let nz = cz + e.z;
  let axis = e.w;
  if (nx >= N || ny >= N || nz >= N) { return 0xFFFFFFFFu; }
  return vidMap[axis * N * N * N + nz * N * N + ny * N + nx];
}

const kNumTris = array<u32, 256>(
  0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 2, 1, 2, 2, 3, 2, 3, 3, 4, 2,
  3, 3, 4, 3, 4, 4, 3, 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 3, 2, 3,
  3, 2, 3, 4, 4, 3, 3, 4, 4, 3, 4, 5, 5, 2, 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3,
  4, 3, 4, 4, 3, 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5, 4, 2, 3, 3, 4,
  3, 4, 2, 3, 3, 4, 4, 5, 4, 5, 3, 2, 3, 4, 4, 3, 4, 5, 3, 2, 4, 5, 5, 4, 5,
  2, 4, 1, 1, 2, 2, 3, 2, 3, 3, 4, 2, 3, 3, 4, 3, 4, 4, 3, 2, 3, 3, 4, 3, 4,
  4, 5, 3, 2, 4, 3, 4, 3, 5, 2, 2, 3, 3, 4, 3, 4, 4, 5, 3, 4, 4, 5, 4, 5, 5,
  4, 3, 4, 4, 3, 4, 5, 5, 4, 4, 3, 5, 2, 5, 4, 2, 1, 2, 3, 3, 4, 3, 4, 4, 5,
  3, 4, 4, 5, 2, 3, 3, 2, 3, 4, 4, 5, 4, 5, 5, 2, 4, 3, 5, 4, 3, 2, 4, 1, 3,
  4, 4, 5, 4, 5, 3, 4, 4, 5, 5, 2, 3, 4, 2, 1, 2, 3, 3, 2, 3, 4, 2, 1, 3, 2,
  4, 1, 2, 1, 1, 0
);

