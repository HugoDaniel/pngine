; Fragments, inline: one library, two roots, and the same `override` fixed at
; two different values.
;
; Before fragments a `(constant …)` was authored per stage but applied per
; MODULE, so one piece of shared code could only ever be specialised one way
; (journal §343). Each root now assembles its own text, so `shade` ships twice —
; once with SCALE folded to 2, once to 8 — from one source.

(wgsl :name palette :code """
fn tint(x: f32) -> vec3f { return vec3f(x, x * 0.6, 1.0 - x); }
""")

(wgsl :name shading :imports [palette] :code """
override SCALE: f32 = 1.0;
fn shade(uv: vec2f) -> vec4f { return vec4f(tint(fract(uv.x * SCALE)), 1.0); }
""")

(shader-module :name vs :code """
@vertex fn v(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = array(vec2f(-1.0, -3.0), vec2f(-1.0, 1.0), vec2f(3.0, 1.0));
  return vec4f(p[i], 0.0, 1.0);
}
""")

(shader-module :name coarse :imports [shading] :code """
@fragment fn fs(@builtin(position) c: vec4f) -> @location(0) vec4f { return shade(c.xy * 0.01); }
""")

(shader-module :name fine :imports [shading] :code """
@fragment fn fs(@builtin(position) c: vec4f) -> @location(0) vec4f { return shade(c.xy * 0.01); }
""")

(render-pipeline :name pcoarse :layout auto
  (vertex :module vs :entry v)
  (fragment :module coarse :entry fs
    (constant :name SCALE :value 2)
    (target :format preferred-canvas-format)))

(render-pipeline :name pfine :layout auto
  (vertex :module vs :entry v)
  (fragment :module fine :entry fs
    (constant :name SCALE :value 8)
    (target :format preferred-canvas-format)))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pcoarse
  (draw :vertex-count 3))

(render-pass :name draw2
  (color-attachment :view context-current-texture :load-op load :store-op store)
  :pipeline pfine
  (draw :vertex-count 3))

(frame :name main :perform [draw draw2])
