; frame_select_scenes — three scenes on one control, plus a guarded bloom.
;
; `scene` picks a whole scene through `(select …)` (first case that holds),
; and `bloom` independently lights the guarded glow group. Both are ordinary
; host-set f32 values: setUniform(p, 'scene', 1) or `--control scene=1`. The
; shader reads the same two slots through `control-inputs`, written by the
; small `(queue …)` below, so the pass the guard chose and the value the
; shader drew cannot disagree.
;
; What you see at the defaults (scene 0, bloom 0.2): a warm diamond on a deep
; red field, with a soft glow. scene 1 rotates the diamond onto a green field,
; scene 2 on a blue field; bloom 0 removes the glow entirely.

(define :name SCENE_GATES :value 1)
(define :name SCENE_RING :value 2)
(define :name BLOOM_ON :value 0.001)

(control :name scene)
(control :name bloom :default 0.2)

(shader-module :name m :code """
struct Controls {
  scene : f32,
  bloom : f32,
}
@group(0) @binding(0) var<uniform> controls : Controls;

struct VsOut {
  @builtin(position) pos : vec4f,
  @location(0) uv : vec2f,
}

@vertex fn vs(@builtin(vertex_index) i : u32) -> VsOut {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  let a = controls.scene * 0.35;
  let c = cos(a);
  let s = sin(a);
  let q = vec2f(p[i].x * c - p[i].y * s, p[i].x * s + p[i].y * c) * 0.5;
  var out : VsOut;
  out.pos = vec4f(q, 0.0, 1.0);
  out.uv = (p[i] + 1.0) * 0.5;
  return out;
}

@fragment fn fs(in : VsOut) -> @location(0) vec4f {
  // A diamond that fades at its edge, so the pass clear stays the scene's
  // field colour wherever the shape is not.
  let d = abs(in.uv.x - 0.5) + abs(in.uv.y - 0.5);
  let inside = 1.0 - smoothstep(0.22, 0.26, d);
  return vec4f(0.95, 0.55, 0.18, inside);
}

@vertex fn vsGlow(@builtin(vertex_index) i : u32) -> VsOut {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  var out : VsOut;
  out.pos = vec4f(p[i], 0.0, 1.0);
  out.uv = (p[i] + 1.0) * 0.5;
  return out;
}

@fragment fn fsGlow(in : VsOut) -> @location(0) vec4f {
  let glow = controls.bloom * smoothstep(0.5, 0.0, length(in.uv - vec2f(0.5)));
  return vec4f(vec3f(1.0, 0.45, 0.12) * glow, 0.0);
}
""")

(buffer :name controlBuf :size 16 :usage [uniform copy-dst])
(queue :name writeControls
  (write-buffer :buffer controlBuf :offset 0 :data control-inputs))

(render-pipeline :name scenePipe :layout auto
  (vertex :module m :entry vs)
  (fragment :module m :entry fs
    (color-target :format preferred-canvas-format
      (blend (color :src-factor src-alpha :dst-factor one-minus-src-alpha :operation add)
             (alpha :src-factor src-alpha :dst-factor one-minus-src-alpha :operation add)))))

(render-pipeline :name glowPipe :layout auto
  (vertex :module m :entry vsGlow)
  (fragment :module m :entry fsGlow
    (color-target :format preferred-canvas-format
      (blend (color :src-factor one :dst-factor one :operation add)
             (alpha :src-factor zero :dst-factor one :operation add)))))

(bind-group :name gScene :layout scenePipe :group 0
  (entry :binding 0 :buffer controlBuf))
(bind-group :name gGlow :layout glowPipe :group 0
  (entry :binding 0 :buffer controlBuf))

(render-pass :name linePass :pipeline scenePipe :bind-groups [gScene]
  (color-attachment :view context-current-texture
    :clear-value [0.16 0.03 0.02 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name gatesPass :pipeline scenePipe :bind-groups [gScene]
  (color-attachment :view context-current-texture
    :clear-value [0.02 0.14 0.04 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name ringPass :pipeline scenePipe :bind-groups [gScene]
  (color-attachment :view context-current-texture
    :clear-value [0.02 0.05 0.16 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name bloomPass :pipeline glowPipe :bind-groups [gGlow]
  (color-attachment :view context-current-texture
    :load-op load :store-op store)
  (draw :vertex-count 3))

(select :name show :on scene
  (case :is SCENE_GATES :perform [gatesPass])
  (case :is SCENE_RING :perform [ringPass])
  :else [linePass])

(step-group :name glow :when bloom :above BLOOM_ON :perform [bloomPass])

(frame :name main :before [writeControls] :perform [show glow])
