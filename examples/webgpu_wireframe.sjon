; webgpu_wireframe — port of the webgpu-samples `wireframe` sample: both of
; upstream's wireframe techniques on the teapot mesh, side by side.
;
;   Left  — storage-buffer vertex pulling: the index and vertex buffers are
;           bound as vertex-stage storage, and @builtin(vertex_index) expands
;           each triangle into 3 line-list edges (992 tris → 5952 verts).
;           Teapot indices are u16, so the index buffer is read as
;           array<u32> words and unpacked 16 bits at a time.
;   Right — solid Lambertian teapot plus a barycentric-discard overlay: a
;           second non-indexed draw pulls the same storage buffers, assigns
;           barycentrics from vertex_index % 3, and the fragment discards
;           away from triangle edges. The overlay pipeline carries
;           :depth-bias -1 / :depth-bias-slope-scale -1.0 to layer over the
;           solid pass (triangle topology only — WebGPU forbids depth bias
;           on line topologies, which is why the left half has none).
;
; The split is done in clip space (x' = 0.5·x ∓ 0.5·w with a 0.5·aspect
; projection) rather than with :viewport, so it is independent of canvas
; size. Asset-free: the teapot comes from the compile-time shape generator.
;
; Compat note: the pulling technique needs 2 storage buffers in the vertex
; stage. Core devices default to 8, but compat-mode devices may expose 0 —
; the (limits …) form below requests the split-stage limit explicitly so
; requestDevice fails loudly rather than the pipeline failing quietly.

(limits :max-storage-buffers-in-vertex-stage 2)

(data :name teapotMesh (teapot :format [position3 normal3]))

; Bound as both a vertex buffer (solid pass) and vertex-stage storage
; (pulling passes). Stride 24 B = 6 floats (position3 normal3).
(buffer :name meshVerts :size teapotMesh :usage [vertex storage]
  :mapped-at-creation teapotMesh)

; Bound as both an index buffer (solid pass) and vertex-stage storage
; (pulling passes read it as array<u32> and unpack u16 halves).
(buffer :name meshIndices :index-of teapotMesh :usage [index storage])

(buffer :name uniforms :size 16 :usage [uniform copy-dst])

(texture :name depthTexture :size canvas :format depth24plus :usage [render-attachment])

(queue :name writeUniforms
  (write-buffer :buffer uniforms :offset 0 :data pngine-inputs))

; Shared WGSL prelude (transform shape follows teapot.sjon: rotY(t·0.5),
; y −0.5, view z −4, fovy 1.0 — but scale 0.08 instead of 0.18 and a
; 0.5·aspect projection: the model must fit its half, because the clip-space
; squeeze remaps overflow that a full-canvas frustum would have clipped into
; the neighbouring half).
(shader-module :name solidShader :code """
struct Inputs { time: f32, width: f32, height: f32, aspect: f32 }
@group(0) @binding(0) var<uniform> u: Inputs;

fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0),
    vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1),
    vec4f(0, 0, far * near * nf, 0));
}

fn mvp(t: f32, aspect: f32) -> mat4x4f {
  let c = cos(t * 0.5); let s = sin(t * 0.5);
  let rotY = mat4x4f(
    vec4f(c, 0, s, 0), vec4f(0, 1, 0, 0),
    vec4f(-s, 0, c, 0), vec4f(0, 0, 0, 1));
  let sc = 0.08;
  let model = rotY * mat4x4f(
    vec4f(sc, 0, 0, 0), vec4f(0, sc, 0, 0),
    vec4f(0, 0, sc, 0), vec4f(0, -0.5, 0, 1));
  let view = mat4x4f(
    vec4f(1, 0, 0, 0), vec4f(0, 1, 0, 0),
    vec4f(0, 0, 1, 0), vec4f(0, 0, -4, 1));
  return perspective(1.0, aspect, 0.1, 100.0) * view * model;
}

struct VSOut {
  @builtin(position) pos: vec4f,
  @location(0) normal: vec3f,
}

@vertex fn vs(
  @location(0) position: vec3f,
  @location(1) normal: vec3f
) -> VSOut {
  var clip = mvp(u.time, u.aspect * 0.5) * vec4f(position, 1.0);
  clip.x = 0.5 * clip.x + 0.5 * clip.w; // right half
  var out: VSOut;
  out.pos = clip;
  out.normal = normal;
  return out;
}

@fragment fn fs(@location(0) normal: vec3f) -> @location(0) vec4f {
  let lightDir = normalize(vec3f(1.0, 2.0, 3.0));
  let diffuse = max(dot(normalize(normal), lightDir), 0.0);
  let color = vec3f(0.25, 0.32, 0.45); // dim slate so the overlay pops
  return vec4f(color * (0.2 + diffuse * 0.8), 1.0);
}
""")

; Technique 2 — barycentric-discard overlay (right half). Non-indexed draw
; of 2976 verts pulling both storage buffers.
(shader-module :name baryShader :code """
struct Inputs { time: f32, width: f32, height: f32, aspect: f32 }
@group(0) @binding(0) var<uniform> u: Inputs;
@group(0) @binding(1) var<storage, read> verts: array<f32>;
@group(0) @binding(2) var<storage, read> tris: array<u32>;

fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0),
    vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1),
    vec4f(0, 0, far * near * nf, 0));
}

fn mvp(t: f32, aspect: f32) -> mat4x4f {
  let c = cos(t * 0.5); let s = sin(t * 0.5);
  let rotY = mat4x4f(
    vec4f(c, 0, s, 0), vec4f(0, 1, 0, 0),
    vec4f(-s, 0, c, 0), vec4f(0, 0, 0, 1));
  let sc = 0.08;
  let model = rotY * mat4x4f(
    vec4f(sc, 0, 0, 0), vec4f(0, sc, 0, 0),
    vec4f(0, 0, sc, 0), vec4f(0, -0.5, 0, 1));
  let view = mat4x4f(
    vec4f(1, 0, 0, 0), vec4f(0, 1, 0, 0),
    vec4f(0, 0, 1, 0), vec4f(0, 0, -4, 1));
  return perspective(1.0, aspect, 0.1, 100.0) * view * model;
}

// Teapot indices are u16 packed two-per-word.
fn indexAt(i: u32) -> u32 {
  let w = tris[i / 2u];
  return select(w & 0xffffu, w >> 16u, (i & 1u) == 1u);
}

struct VSOut {
  @builtin(position) pos: vec4f,
  @location(0) bary: vec3f,
}

@vertex fn vs(@builtin(vertex_index) vi: u32) -> VSOut {
  let v = indexAt(vi);
  let p = vec3f(verts[v * 6u], verts[v * 6u + 1u], verts[v * 6u + 2u]);
  var clip = mvp(u.time, u.aspect * 0.5) * vec4f(p, 1.0);
  clip.x = 0.5 * clip.x + 0.5 * clip.w; // right half, over the solid
  var bary = vec3f(0.0);
  bary[vi % 3u] = 1.0;
  var out: VSOut;
  out.pos = clip;
  out.bary = bary;
  return out;
}

@fragment fn fs(@location(0) bary: vec3f) -> @location(0) vec4f {
  let d = min(min(bary.x, bary.y), bary.z);
  let w = fwidth(d) * 1.5;
  if (d > w) { discard; }
  return vec4f(1.0, 0.85, 0.3, 1.0);
}
""")

; Technique 1 — vertex-pulled line-list expansion (left half).
; 992 triangles × 3 edges × 2 endpoints = 5952 vertices.
(shader-module :name linesShader :code """
struct Inputs { time: f32, width: f32, height: f32, aspect: f32 }
@group(0) @binding(0) var<uniform> u: Inputs;
@group(0) @binding(1) var<storage, read> verts: array<f32>;
@group(0) @binding(2) var<storage, read> tris: array<u32>;

fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0),
    vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1),
    vec4f(0, 0, far * near * nf, 0));
}

fn mvp(t: f32, aspect: f32) -> mat4x4f {
  let c = cos(t * 0.5); let s = sin(t * 0.5);
  let rotY = mat4x4f(
    vec4f(c, 0, s, 0), vec4f(0, 1, 0, 0),
    vec4f(-s, 0, c, 0), vec4f(0, 0, 0, 1));
  let sc = 0.08;
  let model = rotY * mat4x4f(
    vec4f(sc, 0, 0, 0), vec4f(0, sc, 0, 0),
    vec4f(0, 0, sc, 0), vec4f(0, -0.5, 0, 1));
  let view = mat4x4f(
    vec4f(1, 0, 0, 0), vec4f(0, 1, 0, 0),
    vec4f(0, 0, 1, 0), vec4f(0, 0, -4, 1));
  return perspective(1.0, aspect, 0.1, 100.0) * view * model;
}

fn indexAt(i: u32) -> u32 {
  let w = tris[i / 2u];
  return select(w & 0xffffu, w >> 16u, (i & 1u) == 1u);
}

@vertex fn vs(@builtin(vertex_index) vi: u32) -> @builtin(position) vec4f {
  let tri = vi / 6u;
  let e = vi % 6u;
  // Edge pattern 0,1 1,2 2,0 → local corner ((e+1)/2) % 3.
  let corner = ((e + 1u) / 2u) % 3u;
  let v = indexAt(tri * 3u + corner);
  let p = vec3f(verts[v * 6u], verts[v * 6u + 1u], verts[v * 6u + 2u]);
  var clip = mvp(u.time, u.aspect * 0.5) * vec4f(p, 1.0);
  clip.x = 0.5 * clip.x - 0.5 * clip.w; // left half
  return clip;
}

@fragment fn fs() -> @location(0) vec4f {
  return vec4f(0.35, 0.85, 0.95, 1.0);
}
""")

(render-pipeline :name solidPipeline
  (layout auto)
  (vertex (module solidShader) (entry vs)
    (buffers
      (vertex-buffer :array-stride 24
        (attribute :shader-location 0 :offset 0 :format float32x3)
        (attribute :shader-location 1 :offset 12 :format float32x3))))
  (fragment (module solidShader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list) :cull-mode back)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(render-pipeline :name baryPipeline
  (layout auto)
  (vertex (module baryShader) (entry vs))
  (fragment (module baryShader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list) :cull-mode back)
  ; Negative bias pulls the overlay toward the camera so it wins the
  ; less-compare against the solid pass it retraces.
  (depth-stencil :format depth24plus :depth-write-enabled false :depth-compare less
    :depth-bias -1 :depth-bias-slope-scale -1.0))

(render-pipeline :name linesPipeline
  (layout auto)
  (vertex (module linesShader) (entry vs))
  (fragment (module linesShader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology line-list))
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(bind-group :name solidBindGroup :layout-pipeline solidPipeline :layout-index 0
  (entry :binding 0 :buffer uniforms))

(bind-group :name baryBindGroup :layout-pipeline baryPipeline :layout-index 0
  (entry :binding 0 :buffer uniforms)
  (entry :binding 1 :buffer meshVerts)
  (entry :binding 2 :buffer meshIndices))

(bind-group :name linesBindGroup :layout-pipeline linesPipeline :layout-index 0
  (entry :binding 0 :buffer uniforms)
  (entry :binding 1 :buffer meshVerts)
  (entry :binding 2 :buffer meshIndices))

; Pass 1 (clears): solid teapot, right half.
(render-pass :name solidPass
  (color-attachment :view context-current-texture
    :clear-value [0.09 0.09 0.12 1] :load-op clear :store-op store)
  (depth-attachment :view depthTexture :depth-clear-value 1.0
    :depth-load-op clear :depth-store-op store)
  :pipeline solidPipeline
  :vertex-buffers [meshVerts]
  :index-buffer meshIndices
  :bind-groups [solidBindGroup]
  (draw-indexed :index-count 2976))

; Pass 2: barycentric-discard overlay retracing the solid (right half).
(render-pass :name baryPass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  (depth-attachment :view depthTexture :depth-load-op load :depth-store-op store)
  :pipeline baryPipeline
  :bind-groups [baryBindGroup]
  (draw :vertex-count 2976))

; Pass 3: vertex-pulled line-list wireframe (left half).
(render-pass :name linesPass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  (depth-attachment :view depthTexture :depth-load-op load :depth-store-op store)
  :pipeline linesPipeline
  :bind-groups [linesBindGroup]
  (draw :vertex-count 5952))

(frame :name main :perform [writeUniforms solidPass baryPass linesPass])
