; test_copy_buffer — exercises copy-buffer-to-buffer, with the result read back
; in the same frame:
;
;   srcBuf  seeded orange via :data
;   queue   copy srcBuf → dstBuf
;   pass    fragment shader returns dstBuf, bound as a uniform
;
; A working copy renders solid orange; a missing one leaves dstBuf
; zero-initialised and renders black.

(data :name orange :float32 [1 0.5 0 1])

; Source: seeded at creation, never written again.
(buffer :name srcBuf :size 16 :usage [copy-src] :data orange)

; Destination: written only by the copy, then read as a uniform.
(buffer :name dstBuf :size 16 :usage [uniform copy-dst])

(shader-module :name code :code """
    @vertex fn fullscreen(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      let p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
      return vec4f(p[i], 0.0, 1.0);
    }

    @group(0) @binding(0) var<uniform> tint: vec4f;

    // Alpha is forced so an all-zero (uncopied) uniform reads as opaque black
    // rather than transparent — the difference must land in the RGB channels the
    // snapshot compares.
    @fragment fn show() -> @location(0) vec4f { return vec4f(tint.rgb, 1.0); }
  """)

(render-pipeline :name pipe
  :layout auto
  (vertex :module code :entry fullscreen)
  (fragment :module code :entry show
    (target :format preferred-canvas-format)))

(bind-group :name bg :layout pipe :group 0
  (entry :binding 0 :buffer dstBuf))

(queue :name copySrcToDst
  (copy-buffer-to-buffer :source srcBuf :source-offset 0
    :destination dstBuf :destination-offset 0 :size 16))

(render-pass :name show
  (color-attachment :view context-current-texture :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe
  :bind-groups [bg]
  (draw :vertex-count 3))

(frame :name main :perform [copySrcToDst show])
