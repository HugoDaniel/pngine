; frame_timeline — a time-only timeline: no controls, no host required.
;
; `(select :on time …)` picks the scene from the engine's own clock, so the
; whole schedule lives in the PNG and the stock player can run it. The case
; boundaries are named constants; a step group runs the short flare only
; during the first second of the tunnel, and the `:else` is the credits.
;
; What you see: 0-12 s a deep blue field, 12-40 s a violet tunnel with a warm
; one-second flare at the cut, then a near-black credits field. Play it with
; `play(p, { loop: 60 })` to see the first scene return at the seam.

(define :name INTRO_END :value 12)
(define :name TUNNEL_END :value 40)
(define :name FLARE_SECONDS :value 1)

(shader-module :name m :code """
struct VsOut {
  @builtin(position) pos : vec4f,
  @location(0) uv : vec2f,
}

@vertex fn vs(@builtin(vertex_index) i : u32) -> VsOut {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  var out : VsOut;
  out.pos = vec4f(p[i], 0.0, 1.0);
  out.uv = (p[i] + 1.0) * 0.5;
  return out;
}

@fragment fn fs(in : VsOut) -> @location(0) vec4f {
  let d = smoothstep(0.75, 0.05, length(in.uv - vec2f(0.5, 0.5)));
  return vec4f(vec3f(1.0), 0.18 * d);
}
""")

(render-pipeline :name p :layout auto
  (vertex :module m :entry vs)
  (fragment :module m :entry fs
    (color-target :format preferred-canvas-format
      (blend (color :src-factor src-alpha :dst-factor one-minus-src-alpha :operation add)
             (alpha :src-factor src-alpha :dst-factor one-minus-src-alpha :operation add)))))

(render-pass :name introPass :pipeline p
  (color-attachment :view context-current-texture
    :clear-value [0.02 0.06 0.16 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name tunnelPass :pipeline p
  (color-attachment :view context-current-texture
    :clear-value [0.08 0.02 0.12 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name flarePass :pipeline p
  (color-attachment :view context-current-texture
    :load-op load :store-op store)
  (draw :vertex-count 3))
(render-pass :name creditsPass :pipeline p
  (color-attachment :view context-current-texture
    :clear-value [0.02 0.02 0.02 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(select :name show :on time
  (case :below INTRO_END :perform [introPass])
  (case :below TUNNEL_END :perform [tunnelPass flare])
  :else [creditsPass])

(step-group :name flare :when time
  :at-least INTRO_END :below (+ INTRO_END FLARE_SECONDS)
  :perform [flarePass])

(frame :name main :perform [show])
