; Frame guards (plan frame-program §4.2/§5) — a step-group with `:when` runs
; its `:perform` steps only when every comparison key holds, and its `:else`
; steps otherwise. Core-only on purpose (no sugar forms), so `test-core`
; compiles it byte-identically under an empty lowering registry.
;
; Exercises: one control declared, a time WINDOW (two keys, both must hold),
; an `:else` arm, and a bare `:when` toggle (no comparison key = nonzero).
; `scene` is host-set (`setUniform(p, 'scene', 1)`); `time` is the engine's
; own control, slot 0.
;
; The golden corpus traces this fixture at several times and control values
; (`frame_guards.t2/t9/scene1/t9s1.trace`): a single trace at time 0 can only
; show the default arms, which is why the lanes exist.

(control :name scene)

(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (color-target :format preferred-canvas-format)))

; Red from t=2 up to (but not including) t=8; blue outside the window.
(render-pass :name redPass :pipeline pipe
  (color-attachment :view context-current-texture :clear-value [0.8 0.1 0.1 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name bluePass :pipeline pipe
  (color-attachment :view context-current-texture :clear-value [0.1 0.1 0.8 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

; The toggle: green only while `scene` is nonzero, no :else.
(render-pass :name greenPass :pipeline pipe
  (color-attachment :view context-current-texture :clear-value [0.1 0.8 0.1 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(step-group :name window :when time :at-least 2 :below 8
  :perform [redPass]
  :else [bluePass])
(step-group :name overlay :when scene :perform [greenPass])

(frame :name main :perform [window overlay])
