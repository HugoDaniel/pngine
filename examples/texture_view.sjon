; Texture view — exercises the explicit (texture-view …) form. A (texture …)
; bound directly gets a default 2d view; sampling a 2d-array / 3d / cube
; texture needs an explicit view whose :dimension matches the WGSL
; binding (here texture_2d_array).
;
;   arr — a 2-layer 2d-array texture (:size [256 256 2], :dimension 2d).
;   arr_view — an explicit view over it (:dimension 2d-array), bound
;              via (entry :texture-view …). The fragment samples layer 0 by a
;              fullscreen triangle.
;
; Nothing writes to the texture, so the output is black; the file is about the
; view descriptor and its binding.

(shader-module :name code :code """
    @group(0) @binding(0) var samp: sampler;
    @group(0) @binding(1) var tex: texture_2d_array<f32>;

    @vertex
    fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      var p = array<vec2f, 3>(vec2f(-1, -1), vec2f(3, -1), vec2f(-1, 3));
      return vec4f(p[i], 0, 1);
    }

    @fragment
    fn fs(@builtin(position) c: vec4f) -> @location(0) vec4f {
      let uv = c.xy / vec2f(256.0);
      return textureSample(tex, samp, uv, 0);
    }
""")

(texture :name arr :size [256 256 2] :dimension 2d
  :format rgba8unorm :usage [texture-binding copy-dst])

(texture-view :name arr_view :texture arr :dimension 2d-array)

(sampler :name samp :mag-filter linear :min-filter linear)

(render-pipeline :name pipe
  :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))

(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :sampler samp)
  (entry :binding 1 :texture-view arr_view))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe :bind-groups [g]
  (draw :vertex-count 3))

(frame :name main :perform [draw])
