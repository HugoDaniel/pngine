; Invalid: a depth24plus-stencil8 attachment that states only its depth ops.
; The format carries both aspects, and WebGPU requires stencilLoadOp and
; stencilStoreOp for the stencil one -- an attachment cannot leave half of its
; own format unaddressed.
;
; The trap is that the document looks complete: the depth ops are all a
; depth-only pass needs, and the extra aspect arrives with the FORMAT, three
; forms away from the attachment that has to answer for it.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name ds :size canvas :format depth24plus-stencil8 :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :format depth24plus-stencil8 :depth-write-enabled true :depth-compare less))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-stencil-attachment :view ds
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
