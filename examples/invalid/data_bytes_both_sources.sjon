; INVALID: a (bytes ...) naming both :file and :base64.
;
; The form declares `(exclusive-group :cardinality exactly-one)`, so this one
; is the SJON validator's, not the emitter's -- the sidecar and the inline text
; are two spellings of the same bytes and a document must pick one.

(data :name palette (bytes :file "test_data_bytes.bin" :base64 "/4AA/wCAgP//AP///////w=="))
(shader-module :name code :code """
    @vertex fn fullscreen(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      let p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
      return vec4f(p[i], 0.0, 1.0);
    }
    @group(0) @binding(0) var<uniform> palette: vec4u;
    @fragment fn show() -> @location(0) vec4f {
      return vec4f(unpack4x8unorm(palette.x).rgb, 1.0);
    }
""")
(buffer :name paletteBuf :size 16 :usage [uniform copy-dst] :data palette)
(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :buffer paletteBuf))
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry fullscreen)
  (fragment :module code :entry show
    (target :format preferred-canvas-format))
  (primitive :topology triangle-list))
(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe :bind-groups [g]
  (draw :vertex-count 3))
(frame :name main :perform [draw])
