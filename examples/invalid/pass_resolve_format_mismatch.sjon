; Invalid: the color attachment renders into msaaTex (rgba8unorm) and resolves
; into resolveTex (rgba16float); a resolve target must have the attachment's
; format, so the pass/pipeline check rejects it.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name msaaTex :size canvas :format rgba8unorm :usage [render-attachment])
(texture :name resolveTex :size canvas :format rgba16float :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format rgba8unorm))
  (multisample :count 4))
(render-pass :name draw :pipeline pipe
  (color-attachment :view msaaTex :resolve-target resolveTex
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
