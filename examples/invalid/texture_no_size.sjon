; INVALID: a (texture ...) that names no size source.
;
; GPUTextureDescriptor.size is REQUIRED, and since 3.0.0 one key carries it:
; `:size` takes an extent vector (`[w]` / `[w h]` / `[w h d]`), the symbol
; `canvas`, or an `(image-bitmap …)` name, and the schema marks it required --
; so the omission is a located `missing_required_key`. It used to be three
; keys (`:size`, `:size-from`, `:width`+`:height`), none of which could carry
; the flag, and naming none of them produced a 256x256 texture out of nowhere.
;
; The corpus had one: examples/webgpu_shadow_mapping.sjon's shadow map, whose
; WGSL says SHADOW_SIZE_F = 1024.0 while the texture was silently 256 square.
; The comment above it had been amended to describe the mismatch as the
; low-resolution half of a deliberate pair, which is what a fabricated default
; looks like after someone finds it and does not fix it.
(shader-module :name code :code """
@group(0) @binding(0) var samp : sampler;
@group(0) @binding(1) var tex : texture_2d<f32>;
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs(@builtin(position) c : vec4f) -> @location(0) vec4f {
  return textureSample(tex, samp, c.xy / 512.0);
}
""")
(texture :name tex :format rgba8unorm :usage [texture-binding copy-dst])
(sampler :name samp)
(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :sampler samp)
  (entry :binding 1 :texture tex))
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe :bind-groups [g]
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
