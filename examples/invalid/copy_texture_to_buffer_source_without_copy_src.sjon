; INVALID: the source texture of a copy-texture-to-buffer was created without
; copy-src. copyTextureToBuffer reverses the usage requirement: the texture
; reads, the buffer writes.
(buffer :name readback :size 264 :usage [copy-dst])
(texture :name source :size [2 2] :format rgba8unorm :usage [copy-dst])
(queue :name copies
  (copy-texture-to-buffer :size [2 2 1]
    (source :texture source)
    (destination :buffer readback :offset 0 :bytes-per-row 256 :rows-per-image 2)))
(frame :name main :perform [copies])
