; A group with no `:layout` derives against a pipeline's AUTO layout. A pipeline
; whose :layout names an explicit (pipeline-layout …) has none: that layout's
; bind-group-layouts are the layout, and pruning against reflection would drop
; entries they still demand. Refused; the escape hatch is naming the
; (bind-group-layout …) as the group's :layout, as the explicit arm always has.
(shader-module :name code :code """
@group(0) @binding(0) var<uniform> cam: vec4f;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = array(vec2f(-1.0, -3.0), vec2f(-1.0, 1.0), vec2f(3.0, 1.0));
  return cam * vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(buffer :name buf :size 16 :usage [uniform copy-dst])
(bind-group-layout :name bgl
  (entry :binding 0 :visibility [vertex] (buffer :type uniform)))
(pipeline-layout :name pl :bind-group-layouts [bgl])
(render-pipeline :name pipe :layout pl
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (target :format preferred-canvas-format)))
(bind-group :name g :group 0
  (entry :binding 0 :buffer buf))
(render-pass :name p
  (color-attachment :view context-current-texture :load-op clear :clear-value [0 0 0 1] :store-op store)
  :pipeline pipe :bind-groups [g] (draw :vertex-count 3))
(frame :name main :perform [p])
