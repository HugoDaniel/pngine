; INVALID: a (render-pipeline ...) with two (vertex ...) sections.
;
; GPURenderPipelineDescriptor has exactly ONE vertex stage. Until SJON 1.3 a
; head-set was a set of names with no counts, so this validated clean and the
; emitter read whichever section `r.child` found first -- the second was
; decoration. `pipeline-section` now carries `(head :name vertex :min 1 :max 1)`,
; and the second section is a located `positional_too_many`.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@vertex fn vs2(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  return vec4f(0.0, 0.0, 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (vertex :module code :entry vs2)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
