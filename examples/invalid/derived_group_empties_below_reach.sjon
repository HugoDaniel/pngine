; A derived instance that prunes to nothing AT OR BELOW the highest group index
; its pipeline reaches is refused. `pipe` reaches @group(1) and nothing at
; @group(0), so its default layout has an EMPTY bind-group layout at index 0
; that WebGPU still requires a (zero-entry) bind group to be set for — and this
; emitter does not build one (probed to abort, §392). The positive counterpart
; is the instance that empties ABOVE the highest reached index, which is simply
; omitted (Emitter_test: "pruning to nothing above the pipeline's highest group").
(shader-module :name code :code """
@group(0) @binding(0) var<uniform> unused: vec4f;
@group(1) @binding(0) var<uniform> cam: vec4f;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = array(vec2f(-1.0, -3.0), vec2f(-1.0, 1.0), vec2f(3.0, 1.0));
  return cam * vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(buffer :name buf0 :size 16 :usage [uniform copy-dst])
(buffer :name buf1 :size 16 :usage [uniform copy-dst])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (target :format preferred-canvas-format)))
(bind-group :name g0 :group 0
  (entry :binding 0 :buffer buf0))
(bind-group :name g1 :group 1
  (entry :binding 0 :buffer buf1))
(render-pass :name p
  (color-attachment :view context-current-texture :load-op clear :clear-value [0 0 0 1] :store-op store)
  :pipeline pipe :bind-groups [g0 g1] (draw :vertex-count 3))
(frame :name main :perform [p])
