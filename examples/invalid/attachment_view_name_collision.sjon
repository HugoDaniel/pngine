; Invalid: plan 09 — a name is one namespace across EVERY named form, and a
; view is no exception. `shared` cannot name both a texture and a texture-view;
; the second declaration is refused, naming the first. (The pass targets a
; different view so the collision is the document's only located diagnostic,
; not an ambiguous-reference advisory on top of it.)
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name shared :size [4 4] :format rgba8unorm :usage [render-attachment])
(texture-view :name shared :texture shared)
(texture :name targetTex :size [4 4] :format rgba8unorm :usage [render-attachment])
(texture-view :name targetView :texture targetTex)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view targetView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
