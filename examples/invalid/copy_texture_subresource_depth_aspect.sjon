; INVALID: a depth-stencil texture→texture copy must carry aspect all on BOTH
; endpoints (the opposite of the write path's single-aspect rule);
; depth-only is refused here.
(texture :name src :size [4 4] :format depth16unorm :usage [copy-src])
(texture :name dst :size [4 4] :format depth16unorm :usage [copy-dst])
(queue :name blit
  (copy-texture-to-texture
    (source :texture src :aspect depth-only)
    (destination :texture dst)))
(frame :name main :perform [blit])
