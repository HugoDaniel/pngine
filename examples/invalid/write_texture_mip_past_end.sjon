; INVALID: the selected mip level is outside the texture's declared mip count.
(data :name texels (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAA=="))
(texture :name tex :size [4 4] :format rgba8unorm :usage [copy-dst] :mip-level-count 2)
(queue :name upload
  (write-texture :texture tex :data texels :mip-level 2 :size [4 4] :bytes-per-row 16))
(frame :name main :perform [upload])
