; The used-but-unbound check is per PIPELINE since §393 — but it must still
; catch the black screen it was written for. Here `litFs` IS the pipeline's
; fragment entry and it reads `extra`, which nothing binds. That is a black
; screen on whoever loads the PNG, and the refusal names the pipeline that
; reaches it.
;
; Its counterpart is `examples/test_unbound_unreached.sjon`, which declares the
; SAME binding and does NOT bind it, and compiles — because the pipeline there
; instantiates an entry that never reaches it. The pair is the rule: what
; decides is the pipeline's own entry points, not the module's.
(shader-module :name code :code """
struct U { m: mat4x4f }
@group(0) @binding(0) var<uniform> cam: U;
@group(0) @binding(1) var<uniform> extra: vec4f;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  return cam.m * vec4f(f32(i), 0.0, 0.0, 1.0);
}
@fragment fn litFs() -> @location(0) vec4f { return extra; }
""")
(buffer :name camBuf :size 64 :usage [uniform copy-dst])
(render-pipeline :name litPipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry litFs (target :format preferred-canvas-format)))
(bind-group :name g :layout litPipe :group 0
  (entry :binding 0 :buffer camBuf))
(render-pass :name p
  (color-attachment :view context-current-texture :load-op clear :clear-value [0 0 0 1] :store-op store)
  :pipeline litPipe :bind-groups [g] (draw :vertex-count 3))
(frame :name main :perform [p])
