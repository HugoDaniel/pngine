; audit C2's neighbour: `define_overflow` pins the :size funnel's located
; reject for an over-u32 expression; every OTHER integer slot reached the same
; narrowing through `evalU32` and surfaced as an unlocated "emit failed".
; Expected: a located diagnostic at the :vertex-count expression.
(shader-module :name code :code "@vertex fn v() -> @builtin(position) vec4f { return vec4f(0); } @fragment fn f() -> @location(0) vec4f { return vec4f(1); }")
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry v)
  (fragment :module code :entry f (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count (* 100000 100000)))
(frame :name main :perform [draw])
