; Invalid: `:size NUM_PARTICLES` — a bare `(define …)` name in a byte-count
; slot. A bare symbol there means "size this buffer from that `(data …)` form",
; so it is rejected; the diagnostic notes that the symbol names a define and
; suggests the working spelling, `(* NUM_PARTICLES 1)`.

(define :name NUM_PARTICLES :value 2048)

(shader-module :name initShader :code """
struct Particle {
  pos : vec2f,
  vel : vec2f,
}

struct Particles {
  particles : array<Particle>,
}

@binding(0) @group(0) var<storage, read_write> data : Particles;

fn hash(n: u32) -> f32 {
  var x = n;
  x = ((x >> 16u) ^ x) * 0x45d9f3bu;
  x = ((x >> 16u) ^ x) * 0x45d9f3bu;
  x = (x >> 16u) ^ x;
  return f32(x) / f32(0xffffffffu);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) id : vec3u) {
  let i = id.x;
  let total = arrayLength(&data.particles);
  if (i >= total) { return; }

  let t = f32(i) / f32(total);
  let angle = t * 6.283185;
  let radius = sqrt(t);

  data.particles[i].pos = vec2f(cos(angle) * radius, sin(angle) * radius);
  data.particles[i].vel = vec2f(
    (hash(i * 2u) - 0.5) * 0.1,
    (hash(i * 2u + 1u) - 0.5) * 0.1
  );
}
""")

(shader-module :name renderShader :code """
@vertex
fn vertexMain(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  var pos = array<vec2f, 3>(
    vec2f(0.0, 0.5),
    vec2f(-0.5, -0.5),
    vec2f(0.5, -0.5)
  );
  return vec4f(pos[i], 0.0, 1.0);
}

@fragment
fn fragMain() -> @location(0) vec4f {
  return vec4f(0.0, 1.0, 1.0, 1.0);  // Cyan = init compute worked
}
""")

(buffer :name particleBuffer :size NUM_PARTICLES :usage [vertex storage])

(render-pipeline :name renderPipeline
  (layout auto)
  (vertex (module renderShader) (entry vertexMain))
  (fragment (module renderShader) (entry fragMain)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list)))

(init :name initParticles :buffer particleBuffer :shader initShader :workgroups 32)

(render-pass :name renderPass
  (color-attachment :view context-current-texture :clear-value [0.0 0.0 0.0 1.0] :load-op clear :store-op store)
  :pipeline renderPipeline
  (draw :vertex-count 3 :instance-count 1 :first-vertex 0 :first-instance 0))

(frame :name main
  :init [initParticles]
  :perform [renderPass])
