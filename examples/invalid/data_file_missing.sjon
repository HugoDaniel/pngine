; Invalid: a (data … :file …) whose file does not exist. The blob reader used
; to say so as an UNLOCATED headline — "(data :name logo) cannot read …" —
; which the terminal printed and `--json` dropped, since the diagnostics array
; carries located entries only. It is now the same located "cannot read
; '<path>': FileNotFound" on the (data …) form that the buffer, wasm-call and
; wasm-data readers give, and `--json`'s `message` carries the headline in
; any case (both found by the docs site's fence gate the same afternoon).
(data :name logo :file "does_not_exist.png" :mime "image/png")
(image-bitmap :name logoImage :data logo)
(texture :name tex :size logoImage :format rgba8unorm :usage [texture-binding copy-dst render-attachment])
(shader-module :name code :code """
@group(0) @binding(0) var t : texture_2d<f32>;
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return textureLoad(t, vec2i(0, 0), 0); }
""")
(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :texture tex))
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe :bind-groups [g]
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
