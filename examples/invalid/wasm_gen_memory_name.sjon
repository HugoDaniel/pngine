; A data WASM that exports `gen` — so the RUNTIME runs it — but exports its
; memory as `m`. The runtime reads the generated bytes out of `exports.memory`,
; falling back to the `env.memory` it handed in as an import; neither finds `m`,
; so the module runs, writes, and the buffer stays zero. Refused at compile time
; instead: this is the one shape where the export name decides whether the
; feature works at all, and it has no runtime symptom but a black canvas.
;
; A module that exports NO memory is fine — it is writing into the imported one.
(buffer :name ramp :file "gen_memory_misnamed.wasm" :usage [storage copy-dst])

(shader-module :name code :code """
@group(0) @binding(0) var<storage, read> ramp: array<f32>;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let x = f32(i & 1u) * 4.0 - 1.0;
  let y = f32((i >> 1u) & 1u) * 4.0 - 1.0;
  return vec4f(x, y, 0, 1);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(ramp[0], ramp[1], ramp[2], 1.0); }
""")
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (target :format preferred-canvas-format)))
(bind-group :name bg :group 0 (entry :binding 0 :buffer ramp))
(render-pass :name draw :pipeline pipe :bind-groups [bg]
  (color-attachment :view context-current-texture :clear-value [0 0 0 1]
    :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
