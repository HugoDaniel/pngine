; 256 `(entry …)` children. The descriptor encodes its entry count in ONE byte,
; which `encodeBindGroupDescriptor` states as an assert — and that cap is the
; DOCUMENT's to reach, so it panicked here instead of refusing (and under
; ReleaseFast, where the assert is elided, truncated the count byte and emitted
; a descriptor whose header disagreed with its body).
;
; The schema bounds `:binding` to 255, which is why this reads like it should
; already be covered: that bound is on the INDICES, not on how many entries
; there are. 255 entries is the largest legal group and compiles; this is the
; one past it (§437, pitfall 89).
(buffer :name ub :size 16 :usage [uniform copy-dst])
(shader-module :name m :code """
@group(0) @binding(0) var<uniform> u : vec4f;
@vertex fn vs() -> @builtin(position) vec4f { return u; }
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(render-pipeline :name p :layout auto
  (vertex :module m :entry vs)
  (fragment :module m :entry fs (target :format preferred-canvas-format)))
(bind-group :name big :layout p :group 0
  (entry :binding 0 :buffer ub)
  (entry :binding 1 :buffer ub)
  (entry :binding 2 :buffer ub)
  (entry :binding 3 :buffer ub)
  (entry :binding 4 :buffer ub)
  (entry :binding 5 :buffer ub)
