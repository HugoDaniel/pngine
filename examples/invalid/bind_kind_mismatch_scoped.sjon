; The bind-kind check narrowed to ask per PIPELINE in §393, and this is the
; negative proving it still bites where it should: ONE pipeline, one module, and
; the group binds a buffer at the slot the shader declares a texture. There is a
; pipeline-scoped row here, so the check reads it and refuses — no
; document-wide join involved.
;
; Its positive counterpart is `examples/test_pass_post_sampler.sjon`, where two
; pipelines number the same slot differently and neither is wrong.
(texture :name tex :size [4 4] :format rgba8unorm :usage [texture-binding copy-dst])
(buffer :name buf :size 16 :usage [uniform copy-dst])
(shader-module :name code :code """
@group(0) @binding(0) var tex: texture_2d<f32>;
@group(0) @binding(1) var samp: sampler;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = array(vec2f(-1.0, -3.0), vec2f(-1.0, 1.0), vec2f(3.0, 1.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs(@builtin(position) c: vec4f) -> @location(0) vec4f {
  return textureSample(tex, samp, c.xy * 0.01);
}
""")
(sampler :name samp :mag-filter linear :min-filter linear)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (color-target :format preferred-canvas-format)))
(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :buffer buf)
  (entry :binding 1 :sampler samp))
(render-pass :name p
  (color-attachment :view context-current-texture :load-op clear :clear-value [0 0 0 1] :store-op store)
  :pipeline pipe :bind-groups [g] (draw :vertex-count 3))
(frame :name main :perform [p])
