; INVALID: a (texture ...) named `canvas`.
;
; `canvas` is a BUILTIN symbol: it is the `texture-size-mode` member that means
; "size this texture to the canvas". A member-set alternative beside a ref kind
; is not a cross-ref claimant, so SJON cannot see the shadowing -- the union
; matches the member arm first and the declaration below is simply never
; consulted. The author who wrote it believes they declared a texture and gets
; silence.
;
; Every builtin that appears in a ref slot is reserved the same way: `auto`,
; `canvas`, `context-current-texture`, `preferred-canvas-format`,
; `pngine-inputs`, `scene-time-inputs`, `pointer-inputs`, `all`, and the four
; wasm-arg builtins. Naming a form after one is a located reject.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name canvas :size [64 64] :format rgba8unorm :usage [texture-binding render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
