; INVALID: depth32float's depth aspect is a validated copy SOURCE but not a
; destination (the same CRD copy table depth24plus reads from).
(data :name texels (bytes :base64 "AAAAAA=="))
(texture :name depth :size [4 4] :format depth32float :usage [copy-dst])
(queue :name upload
  (write-texture :texture depth :data texels :aspect depth-only :size [4 4] :bytes-per-row 8))
(frame :name main :perform [upload])
