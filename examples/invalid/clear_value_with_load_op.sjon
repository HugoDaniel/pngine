; Invalid: a :clear-value beside `:load-op load`. WebGPU IGNORES clearValue
; when the attachment loads, so the document states a colour that never
; happens -- which 3.0.0 makes an error rather than inert input. The emitter owns it, not `(variant :when clear …)`: SJON's
; variants are positional, and the corpus spells `:clear-value` before
; `:load-op` in all 234 of its colour attachments.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name depth :size canvas :format depth24plus :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [1 0 0 1] :load-op load :store-op store)
  (depth-stencil-attachment :view depth
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
