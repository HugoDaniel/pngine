; INVALID: the pass replays a bundle recorded for rgba8unorm into a bgra8unorm
; attachment.
;
; executeBundles requires the pass's layout -- DERIVED from its attachments --
; to equal the layout the bundle declares. The bundle and the pipeline it
; records agree here; the pass is the one that disagrees, and a pass that
; replays bundles states no :pipeline, so nothing else in the document was
; looking at its attachment formats.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0, 0.5, 0.0, 1.0); }
""")
(texture :name colorTex :size canvas :format bgra8unorm :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format rgba8unorm)))
(render-bundle :name tri :pipeline pipe
  :color-formats [rgba8unorm]
  (draw :vertex-count 3))
(render-pass :name draw
  (color-attachment :view colorTex
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :execute-bundles [tri])
(frame :name main :perform [draw])
