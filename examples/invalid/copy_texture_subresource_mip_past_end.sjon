; INVALID: a source mip level past the texture's :mip-level-count. The
; authored key is also what selects the subresource path.
(texture :name src :size [4 4] :format rgba8unorm :usage [copy-src])
(texture :name dst :size [2 2] :format rgba8unorm :usage [copy-dst])
(queue :name blit
  (copy-texture-to-texture
    (source :texture src :mip-level 1)
    (destination :texture dst)))
(frame :name main :perform [blit])
