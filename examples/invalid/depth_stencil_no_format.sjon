; INVALID: a (depth-stencil ...) with no :format.
;
; GPUDepthStencilState.format is REQUIRED in the WebGPU IDL, and the form's own
; schema comment used to call its keys "optional + default-free by
; construction" -- a construction the spec does not share.
;
; Omitting it used to compile, and then the two backends disagreed about what
; the pipeline rendered to: gpu.js hands `desc.depthStencil` to
; createRenderPipeline untouched, so the browser raised a WebGPU validation
; error, while the native path substituted `Depth24Plus` and drew something.
; A document that renders natively and fails in a browser is worse than one
; that fails everywhere.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name depth :size [512 512]
  :format depth24plus :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :depth-write-enabled true :depth-compare less))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-stencil-attachment :view depth :depth-clear-value 1.0
    :depth-load-op clear :depth-store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
