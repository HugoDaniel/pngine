; INVALID: two :size keys. SJON's duplicate_key reject is the schema's; the
; emitter never chooses the first or the last in silence.
(data :name texels (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAA=="))
(texture :name tex :size [2 2] :format rgba8unorm :usage [copy-dst])
(queue :name upload
  (write-texture :texture tex :data texels :size [2 2] :size [2 2] :bytes-per-row 8))
(frame :name main :perform [upload])
