; INVALID: depth24plus has no published copy footprint and its depth aspect is
; not a legal texel-copy DESTINATION. Refused, never assigned four invented
; bytes. The ordinary-colour suite above is green before this one lands.
(data :name texels (bytes :base64 "AAAAAA=="))
(texture :name depth :size [4 4] :format depth24plus :usage [copy-dst])
(queue :name upload
  (write-texture :texture depth :data texels :aspect depth-only :size [4 4] :bytes-per-row 8))
(frame :name main :perform [upload])
