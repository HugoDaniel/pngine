; Invalid: plan 09 — the array-layer sibling of the mip range check. A view's
; :array-layer-count is a u32 the document owns, and `base layer + count` is
; compared against the texture's layer count. The maximum u32 count made the
; ADDITION overflow and panic before the range could be refused; the view is
; out of bounds either way (base layer 1 plus 2^32-1 layers of a 2-layer
; texture), so it must be the located range refusal.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name attachTex :size [4 4 2] :format rgba8unorm :usage [render-attachment])
(texture-view :name attachView :texture attachTex :dimension 2d-array
  :base-array-layer 1 :array-layer-count 4294967295)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view attachView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
