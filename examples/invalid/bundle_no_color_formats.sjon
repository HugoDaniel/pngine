; INVALID: a (render-bundle ...) that never says which color formats it was
; recorded against.
;
; `GPURenderPassLayout.colorFormats` is required, and it is not a formality: a
; bundle is validated against the layout it declares, and replaying it in a
; pass whose attachments disagree is a WebGPU error. Until 3.0.0 the
; key was optional and an absent list meant "count 0" on the wire, which the JS
; runtime silently filled with getPreferredCanvasFormat() -- so a bundle
; recorded for an offscreen rgba16float target replayed as if it had been
; recorded for the canvas, and only the GPU said otherwise.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1, -1), vec2f(3, -1), vec2f(-1, 3));
  return vec4f(p[i], 0, 1);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1, 0, 0, 1); }
""")

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))

(render-bundle :name tri :pipeline pipe (draw :vertex-count 3))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :execute-bundles [tri])

(frame :name main :perform [draw])
