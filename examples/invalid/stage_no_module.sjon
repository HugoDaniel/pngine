; INVALID: a pipeline stage with no :module.
;
; GPUProgrammableStage.module is REQUIRED in the WebGPU IDL.
; It is a scalar member of the stage dictionary, so it is a KEY
; -- the reject is a missing_required_key on the
; (vertex ...) form. It used to be a missing positional `(module ...)` child,
; which said the same thing through a head-set floor.
;
; The vertex stage below names an entry point but no shader module. stageShader
; used to answer 0 for a missing module -- and 0 is a valid shader id, so the
; stage silently bound whichever module was declared FIRST. Here that is
; `other`, which has no `vs` at all: the document compiled clean, passed
; validate, produced a normal-looking MockGPU trace, and aborted on a real GPU
; with "RenderPipeline with '' label is invalid".
(shader-module :name other :code """
@vertex fn zz(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  return vec4f(0.0, 0.0, 0.0, 1.0);
}
""")
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(render-pipeline :name pipe :layout auto
  (vertex :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
