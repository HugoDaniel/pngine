; Invalid: plan 09 — a view over a 4x texture used where the pipeline has no
; multisample state. The sample-count join now follows the view to its source
; texture, so an attachment's view cannot hide a count its base texture carries.
; The CRD anchor is the render-pass-layout equality setPipeline performs
; (`../gpuweb/spec/index.bs:12886-12889` and the comparison at `:13208`): the
; pass's derived sampleCount must equal the pipeline's `multisample.count`.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name msaaTex :size [4 4] :format rgba8unorm :usage [render-attachment]
  :sample-count 4)
(texture-view :name msaaView :texture msaaTex)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view msaaView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
