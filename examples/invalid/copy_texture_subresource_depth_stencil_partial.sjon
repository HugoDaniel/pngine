; INVALID: a depth-stencil texture→texture copy must cover the ENTIRE physical
; subresource (copies.bs:263-266). A 2x2 out of a 4x4 depth mip is refused, even
; though the aspect is `all` and every range would otherwise fit.
(texture :name src :size [4 4] :format depth16unorm :usage [copy-src])
(texture :name dst :size [4 4] :format depth16unorm :usage [copy-dst])
(queue :name blit
  (copy-texture-to-texture :size [2 2 1]
    (source :texture src)
    (destination :texture dst)))
(frame :name main :perform [blit])
