; Invalid: the shader declares @group(0) @binding(0) as texture_2d<u32> (uint
; sample type), but the bound texture is rgba8unorm, a float-class format; the
; shader/binding cross-check rejects the sample-class mismatch. textureLoad is
; used so no sampler binding is needed.
(shader-module :name code :code """
@group(0) @binding(0) var tex: texture_2d<u32>;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f {
  return vec4<f32>(textureLoad(tex, vec2i(0, 0), 0));
}
""")
(texture :name texFloat :format rgba8unorm :size [4 4] :usage [texture-binding])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(bind-group :name g0 :layout pipe :group 0
  (entry :binding 0 :texture texFloat))
(render-pass :name draw :pipeline pipe :bind-groups [g0]
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
