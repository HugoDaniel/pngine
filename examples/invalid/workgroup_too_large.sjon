; Invalid: @workgroup_size(256, 256, 1) — each axis is within its cap, but the
; product (65536) exceeds WebGPU's maxComputeInvocationsPerWorkgroup (256), a
; device limit WGSL validation does not enforce; the compute-pipeline check
; rejects it.
(shader-module :name code :code """
@group(0) @binding(0) var<storage, read_write> data: array<f32>;
@compute @workgroup_size(256, 256, 1) fn main(@builtin(global_invocation_id) id: vec3u) {
  data[id.x] = 1.0;
}
""")
(buffer :name buf :size 256 :usage [storage copy-dst])
(compute-pipeline :name cp :layout auto (compute :module code :entry main))
(bind-group :name g0 :layout cp :group 0
  (entry :binding 0 :buffer buf))
(compute-pass :name step :pipeline cp :bind-groups [g0] (dispatch :workgroups [1]))
(frame :name main :perform [step])
