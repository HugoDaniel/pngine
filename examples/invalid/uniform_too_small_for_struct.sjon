; Invalid: the uniform buffer is 16 bytes but the shader's Uniforms struct is 32
; bytes (two vec4f); the size-adequacy check rejects a buffer smaller than the
; binding the shader reflects.
(buffer :name uniformBuffer :size 16 :usage [uniform copy-dst])
(shader-module :name code :code """
    struct Uniforms {
        a: vec4f,
        b: vec4f,
    }
    @group(0) @binding(0) var<uniform> u: Uniforms;
    @vertex
    fn vertexMain(@builtin(vertex_index) VertexIndex : u32) -> @builtin(position) vec4f {
      var pos = array<vec2f, 3>(vec2(0.0, 0.5), vec2(-0.5, -0.5), vec2(0.5, -0.5));
      return vec4f(pos[VertexIndex], 0.0, 1.0);
    }
    @fragment
    fn fragMain() -> @location(0) vec4f {
      return u.a + u.b;
    }
""")
(bind-group :name uniformGroup :layout pipeline :group 0
  (entry :binding 0 :buffer uniformBuffer))
(render-pipeline :name pipeline :layout auto
  (vertex :module code :entry vertexMain)
  (fragment :module code :entry fragMain (target :format preferred-canvas-format))
  (primitive :topology triangle-list))
(render-pass :name render :pipeline pipeline
  (color-attachment :view context-current-texture :clear-value [0 0 0 0] :load-op clear :store-op store)
  :bind-groups [uniformGroup]
  (draw :vertex-count 3))
(frame :name uniformTooSmall :perform [render])
