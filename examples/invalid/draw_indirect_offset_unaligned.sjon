; INVALID: a (draw-indirect …) whose :offset is not a multiple of 4.
;
; GPURenderPassEncoder.drawIndirect (and drawIndexedIndirect,
; dispatchWorkgroupsIndirect) require indirectOffset % 4 == 0 — the args are
; u32s read in place. The three :offset keys were plain `byte-count`, so
; `:offset 2` validated and compiled; they are
; `byte-count-4-aligned` now and the literal is a located `number_not_multiple`.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(buffer :name args :size 32 :usage [indirect storage])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw-indirect :buffer args :offset 2))
(frame :name main :perform [draw])
