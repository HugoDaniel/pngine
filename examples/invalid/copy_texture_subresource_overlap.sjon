; INVALID: a same-texture copy whose source and destination are the same mip
; and layer. The subresource sets overlap, which WebGPU refuses even before
; the texel ranges are compared.
(texture :name both :size [4 4] :format rgba8unorm :usage [copy-src copy-dst])
(queue :name blit
  (copy-texture-to-texture
    (source :texture both :mip-level 0)
    (destination :texture both)))
(frame :name main :perform [blit])
