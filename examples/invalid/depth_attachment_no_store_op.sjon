; Invalid: a depth attachment with no :depth-store-op. Both depth ops carried
; PNGine defaults (clear/store) while the COLOUR attachment has required both
; since 3.0.0 -- one concept, two policies, in one schema. 3.0.0 makes
; them required, which is symmetry, not new strictness: 69 of the corpus's 70
; depth attachments already stated both.
;
; The requirement is CONDITIONAL, though, which the first cut got wrong: it is
; the view's format that decides, and WebGPU forbids the depth pair outright on
; a format with no depth aspect. So the check is the emitter's (C5), and this
; fixture rejects because the view is depth24plus, not because the key is
; required everywhere.

(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name depth :size canvas :format depth24plus :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-stencil-attachment :view depth
    :depth-clear-value 1.0 :depth-load-op clear)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
