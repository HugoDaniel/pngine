; INVALID: a numeric expression naming a constant no `(define …)` declares.
;
; A bare `NUMM` in a slot is the validator's `not_cross_ref` (S6/S13); inside
; an expression it is the evaluator that fails to find it, and the message
; used to say only "`:size` does not evaluate to a number" — located on the
; expression, silent about which name (audit 09's prose sweep found every doc
; page explaining that message the same unhelpful way). It names the name now.
(shader-module :name cs :code "@compute @workgroup_size(1) fn main() {}")
(define :name NUM :value 64)
(buffer :name b :size (* NUMM 16) :usage [storage])
(compute-pipeline :name cp :layout auto (compute :module cs :entry main))
(bind-group :name g :layout cp :group 0 (entry :binding 0 :buffer b))
(compute-pass :name step :pipeline cp :bind-groups [g] (dispatch :workgroups [1 1 1]))
(frame :name main :perform [step])
