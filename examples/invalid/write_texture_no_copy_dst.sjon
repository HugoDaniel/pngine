; INVALID: a (write-texture …) destination without copy-dst usage. WebGPU
; rejects the queue call, not the resource, so the document compiles and the
; upload silently never happens. Plan 01's calculator names the absent bit.
(data :name texels (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="))
(texture :name tex :size [4 4] :format rgba8unorm :usage [texture-binding])
(queue :name upload
  (write-texture :texture tex :data texels :size [4 4] :bytes-per-row 16))
(frame :name main :perform [upload])
