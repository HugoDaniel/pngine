; `:prune-unused` dropping EVERY entry is refused, not emitted.
;
; A pipeline's default layout has an entry per group index up to the highest one
; its entry points reach. A group that prunes empty is either below that (and
; must still be set, as a zero-entry group, which this emitter does not build) or
; above it (and belongs out of the pass's :bind-groups list instead — an edit
; only the author can make). Emitting a zero-entry group aborts, so saying so at
; compile time is the only honest answer.
;
; Here neither entry point of `pipe` reads anything at @group(0).
(shader-module :name code :code """
@group(0) @binding(0) var<uniform> unused: vec4f;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  let p = array(vec2f(-1.0, -3.0), vec2f(-1.0, 1.0), vec2f(3.0, 1.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(buffer :name buf :size 16 :usage [uniform copy-dst])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs (target :format preferred-canvas-format)))
(bind-group :name g :layout pipe :group 0 :prune-unused true
  (entry :binding 0 :buffer buf))
(render-pass :name p
  (color-attachment :view context-current-texture :load-op clear :clear-value [0 0 0 1] :store-op store)
  :pipeline pipe :bind-groups [g] (draw :vertex-count 3))
(frame :name main :perform [p])
