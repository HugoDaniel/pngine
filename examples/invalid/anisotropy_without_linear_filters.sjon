; Invalid: :max-anisotropy 4 with the default (nearest) filters. WebGPU
; requires magFilter, minFilter AND mipmapFilter to all be linear when
; maxAnisotropy > 1 -- anisotropic filtering is a refinement of linear
; filtering, and there is nothing to refine on a nearest tap.
;
; An easy trap since 3.0.0: pngine used to default the filters to
; linear, so an authored anisotropy came out legal by accident. The defaults
; are the IDL's now (nearest), which makes a sampler that states only
; :max-anisotropy a device error rather than a mistake.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(sampler :name samp :max-anisotropy 4)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
