; INVALID: texture→texture copies are copy-compatible only when the formats are
; identical or differ solely by the -srgb suffix. rgba8unorm → rgba16float is
; neither.
(texture :name src :size [4 4] :format rgba8unorm :usage [copy-src])
(texture :name dst :size [4 4] :format rgba16float :usage [copy-dst])
(queue :name blit
  (copy-texture-to-texture
    (source :texture src :mip-level 0)
    (destination :texture dst)))
(frame :name main :perform [blit])
