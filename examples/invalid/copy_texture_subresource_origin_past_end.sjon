; INVALID: a destination origin component past the selected physical mip
; extent (4 > 4).
(texture :name src :size [4 4] :format rgba8unorm :usage [copy-src])
(texture :name dst :size [4 4] :format rgba8unorm :usage [copy-dst])
(queue :name blit
  (copy-texture-to-texture
    (source :texture src)
    (destination :texture dst :origin [5 0 0])))
(frame :name main :perform [blit])
