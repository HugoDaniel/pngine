; The same rule as draw_graph_multisampled_attachment.sjon, with a `:sample-count`
; the schema will refuse. That is the point: a lowering hook runs BEFORE the
; schema's `:repr u32` check, so this number reaches the hook first, and the hook
; read it with a bare `@intFromFloat` — which TRAPS on anything outside u32.
; A bad `:sample-count` was a compiler panic, and under ReleaseFast a garbage
; sample count instead (§437). The hook now range-tests before the cast and
; leaves the number to the schema, which is what refuses it below.
(shader-module :name m :code """
@group(0) @binding(0) var<uniform> c: vec4f;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1, -1), vec2f(3, -1), vec2f(-1, 3));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return c; }
""")
(buffer :name cb :size 16 :usage [uniform copy-dst])
(texture :name msaaDepth :size canvas :format depth24plus :sample-count 99999999999
  :usage [render-attachment])
(draw-graph
  (stage :name s
    (color-attachment :view context-current-texture
      :clear-value [0 0 0 1] :load-op clear :store-op store)
    (depth-stencil-attachment :view msaaDepth
      :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
    (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less)
    (bind-group :name g :group 0 (entry :binding 0 :buffer cb)))
  (geometry :name a (draw :vertex-count 3)
    (in :stage s (vertex :module m :entry vs) (fragment :module m :entry fs)))
  )
