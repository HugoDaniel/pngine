; Invalid: plan 09 — a render-pass attachment selects ONE mip level. This view
; spans the texture's whole (legal) two-level chain, so it is a usable sampled
; view and an unusable attachment; the refusal says which spelling fixes it.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name attachTex :size [4 4] :format rgba8unorm :usage [render-attachment]
  :mip-level-count 2)
(texture-view :name attachView :texture attachTex :base-mip-level 0 :mip-level-count 2)
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))
(render-pass :name draw :pipeline pipe
  (color-attachment :view attachView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
