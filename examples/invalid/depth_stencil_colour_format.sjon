; Invalid: (depth-stencil :format rgba8unorm …). GPUDepthStencilState.format
; must be a depth-or-stencil format -- a colour format there describes a
; depth/stencil attachment that cannot exist.
;
; A value set, which is normally the schema's job, and it is the emitter's for
; a measured reason: the conformance ratchet models a NARROWED enum kind as a
; support gap (`KNOWN_UNSUPPORTED`), and the ~90 colour formats are not a gap
; here, they are inapplicable. A `depth-stencil-format` member-set would have
; to list every one of them as unsupported to keep the ratchet at zero.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name depth :size canvas :format depth24plus :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :format rgba8unorm :depth-write-enabled true :depth-compare less))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-stencil-attachment :view depth
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
