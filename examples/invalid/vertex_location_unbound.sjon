; Invalid: the vertex shader reads @location(0) and @location(1), but the
; vertex buffer layout declares only the location-0 attribute; the shader/layout
; cross-check rejects the unbound input (@builtin inputs are not counted).
(shader-module :name code :code """
struct VOut {
  @builtin(position) pos : vec4f,
  @location(0) col : vec4f,
};
@vertex fn vs(
  @location(0) position : vec2f,
  @location(1) color : vec4f
) -> VOut {
  var o : VOut;
  o.pos = vec4f(position, 0.0, 1.0);
  o.col = color;
  return o;
}
@fragment fn fs(@location(0) col : vec4f) -> @location(0) vec4f {
  return col;
}
""")
(buffer :name verts :size 256 :usage [vertex])
(render-pipeline :name pipe (layout auto)
  (vertex (module code) (entry vs)
    (buffers
      (vertex-buffer :array-stride 8
        (attribute :shader-location 0 :offset 0 :format float32x2))))
  (fragment (module code) (entry fs)
    (targets (target :format preferred-canvas-format))))
(render-pass :name draw :pipeline pipe :vertex-buffers [verts]
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
