; INVALID: a plain colour format has no stencil aspect either.
(data :name texels (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="))
(texture :name tex :size [4 4] :format rgba8unorm :usage [copy-dst])
(queue :name upload
  (write-texture :texture tex :data texels :aspect stencil-only :size [4 4] :bytes-per-row 16))
(frame :name main :perform [upload])
