; A `:pool` that runs the bind-group id space past the table the native backend
; actually holds (128). Every form here is legal on its own — the pool count is
; under the wire's 255, the entries resolve, the WGSL compiles — so this
; document used to `validate` OK and then die at render with a bare
; `error.InvalidResourceId` naming neither the cap, the resource kind, nor a
; line. r3-03 moved the refusal here, where the author wrote the number.
(shader-module :name code :code """
@group(0) @binding(0) var<uniform> tint : vec4f;

@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  let x = f32(i) - 1.0;
  return vec4f(x, x, 0.0, 1.0);
}

@fragment fn fs() -> @location(0) vec4f { return tint; }
""")

(buffer :name tints :size 16 :usage [uniform copy-dst] :pool 200)

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format)))

(bind-group :name tintGroups :layout pipe :group 0 :pool 200
  (entry :binding 0 :buffer tints :ping-pong 0))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe :bind-groups [tintGroups]
  (draw :vertex-count 3))

(frame :name main :perform [draw])
