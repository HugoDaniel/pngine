; INVALID: a plain colour format has no depth aspect, so aspect depth-only is
; plan 01's invalid-aspect refusal. The schema accepts the tag; only the
; format-aware calculator knows the format has no such aspect.
(data :name texels (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="))
(texture :name tex :size [4 4] :format rgba8unorm :usage [copy-dst])
(queue :name upload
  (write-texture :texture tex :data texels :aspect depth-only :size [4 4] :bytes-per-row 16))
(frame :name main :perform [upload])
