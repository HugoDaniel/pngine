; Invalid: depth ops on a stencil8 attachment. WebGPU requires depthLoadOp and
; depthStoreOp when the VIEW's format has a depth aspect and FORBIDS them when
; it has none -- stencil8 has none, so the pass describes an operation on an
; aspect the texture does not carry.
;
; This direction is why D13's first cut was wrong: making the depth pair
; unconditionally required in the schema made a stencil-only attachment
; unwritable. The rule is conditional on the view's format, which the schema
; cannot reach, so both directions are the emitter's.
(shader-module :name code :code """
@vertex fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  return vec4f(p[i], 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0); }
""")
(texture :name ds :size canvas :format stencil8 :usage [render-attachment])
(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (depth-stencil :format stencil8))
(render-pass :name draw :pipeline pipe
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-stencil-attachment :view ds
    :stencil-clear-value 0 :stencil-load-op clear :stencil-store-op store
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  (draw :vertex-count 3))
(frame :name main :perform [draw])
