; The hand-written twin of examples/draw_graph_after.sjon: the same frame with
; `(draw-graph …)` expanded by hand into the core forms it lowers to.
; `schema/sugar-ledger.mjs` names this file for `(draw-graph …)`'s `:after`, and
; `tests/zig/render/render_test.zig` holds the pair pixel-equal every run
; (`twin_of = "draw_graph_after"`).
;
; `:after` reaches no GPU descriptor at all. It places its steps at the TAIL of
; the frame the graph emits, and the whole of it is visible below as the last
; name in `(frame … :perform …)`. `:before` is the same door at the head, which
; is why this one document witnesses both ends and the twin needs no second
; file.
;
; Most of this file is the sugar document unchanged — both shader modules, the
; uniform buffer, its queue, the border pipeline and the `overlay` pass are
; hand-authored core forms THERE too. What expands is the graph: one stage
; crossed with one geometry gives one `(render-pipeline …)`, one
; `(bind-group …)` and one `(render-pass …)`, all named `<stage>__<geometry>`.
;
; The probe that separates this twin from a wrong one is the order itself:
; move `main__blades` after `overlay` in the frame below and the stage's clear
; wipes the border, which is the same picture as deleting `:after` from the
; sugar. Measured when this landed: 14,460 of 65,536 pixels.
;
; Equivalence reached: PIXEL. An unnamed `(draw-graph …)` emits the document's
; frame, and the emitter walks authored forms grouped by kind against lowered
; forms in emission order, so the payloads differ while the frame does not.

(shader-module :name scene :code """
struct Inputs { time : f32, width : f32, height : f32, aspect : f32 }
@group(0) @binding(0) var<uniform> inputs : Inputs;

struct VsOut { @builtin(position) pos : vec4f, @location(0) tint : vec3f }

@vertex fn vs(@builtin(vertex_index) i : u32,
              @builtin(instance_index) inst : u32) -> VsOut {
  var corner = array<vec2f, 3>(vec2f(0.0, 0.34), vec2f(-0.3, -0.22), vec2f(0.3, -0.22));
  let a = inputs.time * 0.7 + f32(inst) * 2.0943951;
  let c = cos(a);
  let s = sin(a);
  let p = corner[i];
  // Spin the blade about its own centre, then swing it out along the same angle.
  let r = vec2f(p.x * c - p.y * s, p.x * s + p.y * c);
  let off = vec2f(cos(a) * 0.42, sin(a) * 0.42 * inputs.aspect);

  var out : VsOut;
  out.pos = vec4f(r + off, 0.0, 1.0);
  out.tint = vec3f(0.95, 0.55, 0.2) + f32(inst) * vec3f(-0.3, 0.1, 0.35);
  return out;
}

@fragment fn fs(in : VsOut) -> @location(0) vec4f { return vec4f(in.tint, 1.0); }
""")

(shader-module :name border :code """
struct VsOut { @builtin(position) pos : vec4f, @location(0) uv : vec2f }

@vertex fn vs(@builtin(vertex_index) i : u32) -> VsOut {
  var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
  var out : VsOut;
  out.pos = vec4f(p[i], 0.0, 1.0);
  out.uv = p[i] * 0.5 + vec2f(0.5);
  return out;
}

// A border and nothing else: alpha is 1 within 0.06 of an edge and 0 inside, so
// the blend below leaves every pixel the graph drew in the middle untouched.
// That is what makes the overlay legible AS an overlay rather than as a frame
// the graph could have drawn itself.
@fragment fn fs(in : VsOut) -> @location(0) vec4f {
  let d = min(min(in.uv.x, 1.0 - in.uv.x), min(in.uv.y, 1.0 - in.uv.y));
  return vec4f(0.1, 0.85, 0.75, 1.0 - step(0.06, d));
}
""")

(buffer :name uniforms :size 16 :usage [uniform copy-dst])
(queue :name writeUniforms
  (write-buffer :buffer uniforms :offset 0 :data pngine-inputs))

; The tail step, written by hand: its own pipeline, its own blend, and
; `:load-op load` because by the time it runs the canvas already holds the
; graph's output.
(render-pipeline :name borderPipe :layout auto
  (vertex :module border :entry vs)
  (fragment :module border :entry fs
    (target :format preferred-canvas-format
      (blend
        (color :src-factor src-alpha :dst-factor one-minus-src-alpha :operation add)
        (alpha :src-factor one :dst-factor one-minus-src-alpha :operation add))))
  (primitive :topology triangle-list))

(render-pass :name overlay :pipeline borderPipe
  (color-attachment :view context-current-texture :load-op load :store-op store)
  (draw :vertex-count 3))

; ---- the graph: stage `main` x geometry `blades` ---------------------------

; The stage's `(primitive …)` and the geometry's `(in …)` stages, with the
; colour target's format DERIVED from the attachment — `context-current-texture`
; means `preferred-canvas-format`, which the twin has to say out loud.
(render-pipeline :name main__blades__pipe :layout auto
  (vertex :module scene :entry vs)
  (fragment :module scene :entry fs
    (target :format preferred-canvas-format))
  (primitive :topology triangle-list))

; `:prune-unused` is unconditional in the lowering: the stage writes its entry
; list once and each pipeline's auto-layout decides what survives, which is what
; makes CONTRIBUTING pitfall 37 unexpressible in a graph.
(bind-group :name sceneBG__blades :layout main__blades__pipe :group 0
  :prune-unused true
  (entry :binding 0 :buffer uniforms))

; The stage's attachment lands here with its authored load/store ops, because
; this pass is both the FIRST and the LAST of its stage. A stage with two
; geometries would clear on the first and store on the last, loading between.
(render-pass :name main__blades :pipeline main__blades__pipe
  :bind-groups [sceneBG__blades]
  (color-attachment :view context-current-texture
    :clear-value [0.03 0.03 0.06 1] :load-op clear :store-op store)
  (draw :vertex-count 3 :instance-count 3))

; `:before [writeUniforms]` is the head of this list, `:after [overlay]` the
; tail, and the graph's own passes are everything between.
(frame :name draw :perform [writeUniforms main__blades overlay])
