  vec3i(0,2,11),vec3i(8,0,11),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(3,2,11),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(2,3,8),vec3i(2,8,10),vec3i(10,8,9),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(9,10,2),vec3i(0,9,2),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(2,3,8),vec3i(2,8,10),vec3i(0,1,8),vec3i(1,10,8),vec3i(-1,-1,-1),
  vec3i(1,10,2),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(1,3,8),vec3i(9,1,8),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(0,9,1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(0,3,8),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),
  vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1),vec3i(-1,-1,-1)
);

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) gid: vec3u) {
  let id = gid.x;
  if (id >= 32768u) { return; } // 32^3 cells
  let N = 32u;
  let NV = 33u;
  let cz = id / (N * N);
  let cy = (id / N) % N;
  let cx = id % N;

  // Read 8 corner densities and compute cube case
  let kCorner = array<vec3u, 8>(
    vec3u(0,0,0), vec3u(1,0,0), vec3u(1,1,0), vec3u(0,1,0),
    vec3u(0,0,1), vec3u(1,0,1), vec3u(1,1,1), vec3u(0,1,1)
  );
  var cubeCase = 0u;
  for (var i = 0u; i < 8u; i++) {
    let c = kCorner[i];
    let d = densityAt(cx + c.x, cy + c.y, cz + c.z);
    if (d < 0.0) { cubeCase |= (1u << i); }
  }

  let numTris = kNumTris[cubeCase];
  if (numTris == 0u) { return; }

  // Generate triangles
  for (var t = 0u; t < numTris; t++) {
    let tri = kTriTable[cubeCase * 5u + t];
    let e0 = tri.x;
    let e1 = tri.y;
    let e2 = tri.z;
    if (e0 < 0 || e1 < 0 || e2 < 0) { continue; }

    let v0 = getVertexId(cx, cy, cz, u32(e0));
    let v1 = getVertexId(cx, cy, cz, u32(e1));
    let v2 = getVertexId(cx, cy, cz, u32(e2));

    if (v0 == 0xFFFFFFFFu || v1 == 0xFFFFFFFFu || v2 == 0xFFFFFFFFu) { continue; }

    let baseIdx = atomicAdd(&counters[1], 3u);
    if (baseIdx + 2u >= 262144u) { continue; }
    indices[baseIdx] = v0;
    indices[baseIdx + 1u] = v1;
    indices[baseIdx + 2u] = v2;
  }
}
""")

; ── Shader: Ground Render ─────────────────────────────────────────

(shader-module :name groundRenderShader :code """
struct MVPData { matrix: mat4x4f, camPos: vec4f }
@group(0) @binding(0) var<storage, read> mvp: MVPData;

struct VSOut {
  @builtin(position) position: vec4f,
  @location(0) normal: vec3f,
  @location(1) worldPos: vec3f,
}

@vertex
fn vs(@location(0) pos: vec3f, @location(1) normal: vec3f) -> VSOut {
  var out: VSOut;
  let worldPos = vec3f(pos.x, pos.y - 12.0, pos.z);
  out.position = mvp.matrix * vec4f(worldPos, 1.0);
  out.normal = normal;
  out.worldPos = worldPos;
  return out;
}

@fragment
fn fs(in: VSOut) -> @location(0) vec4f {
  let N = normalize(in.normal);
  let L = normalize(vec3f(0.4, 0.8, 0.3));
  let diff = max(dot(N, L), 0.0);
  let ambient = 0.08;
  let color = vec3f(0.35, 0.35, 0.38) * (ambient + diff * 0.5);
  return vec4f(color, 1.0);
}
""")

; ── Shader: Camera (arcball) ──────────────────────────────────────

(shader-module :name cameraShader :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }
struct PointerInputs {
  x: f32, y: f32, clickX: f32, clickY: f32,
  dx: f32, dy: f32, buttons: f32, pressure: f32,
  modifiers: f32, scrollX: f32, scrollY: f32, _pad: f32,
}
struct CameraState { data: array<f32, 32> }
struct MVPData { matrix: mat4x4f, camPos: vec4f }

@group(0) @binding(0) var<uniform> pngine: PngineInputs;
@group(0) @binding(1) var<uniform> pointer: PointerInputs;
@group(0) @binding(2) var<storage, read_write> cam: CameraState;
@group(0) @binding(3) var<storage, read_write> mvp: MVPData;

const EPSILON: f32 = 0.0000001;
const ROTATION_SPEED: f32 = 500.0;
const ZOOM_SPEED: f32 = 0.1;
const PAN_SPEED: f32 = 3.0;
const FRICTION: f32 = 0.999;
const PI: f32 = 3.14159265;

fn rotateVec(v: vec3f, axis: vec3f, angle: f32) -> vec3f {
  let c = cos(angle); let s = sin(angle);
  return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
}
fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0), vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1), vec4f(0, 0, far * near * nf, 0));
}
fn inverseCamera(r: vec3f, u: vec3f, b: vec3f, p: vec3f) -> mat4x4f {
  return mat4x4f(
    vec4f(r.x, u.x, b.x, 0), vec4f(r.y, u.y, b.y, 0),
    vec4f(r.z, u.z, b.z, 0),
    vec4f(-dot(r, p), -dot(u, p), -dot(b, p), 1));
}
fn getRight() -> vec3f { return vec3f(cam.data[0], cam.data[1], cam.data[2]); }
fn getUp() -> vec3f { return vec3f(cam.data[4], cam.data[5], cam.data[6]); }
fn getBack() -> vec3f { return vec3f(cam.data[8], cam.data[9], cam.data[10]); }
fn getTgt() -> vec3f { return vec3f(cam.data[21], cam.data[22], cam.data[23]); }
fn setRight(v: vec3f) { cam.data[0] = v.x; cam.data[1] = v.y; cam.data[2] = v.z; }
fn setUp(v: vec3f) { cam.data[4] = v.x; cam.data[5] = v.y; cam.data[6] = v.z; }
fn setBack(v: vec3f) { cam.data[8] = v.x; cam.data[9] = v.y; cam.data[10] = v.z; }
fn setPos(v: vec3f) { cam.data[12] = v.x; cam.data[13] = v.y; cam.data[14] = v.z; }
fn setAxis(v: vec3f) { cam.data[16] = v.x; cam.data[17] = v.y; cam.data[18] = v.z; }
fn setTgt(v: vec3f) { cam.data[21] = v.x; cam.data[22] = v.y; cam.data[23] = v.z; }

@compute @workgroup_size(1)
fn updateCamera() {
  if (cam.data[25] < 0.5) {
    let initPos = vec3f(0.0, 10.0, 40.0);
    let dist = length(initPos);
    let back = normalize(initPos);
    let worldUp = vec3f(0, 1, 0);
    let right = normalize(cross(worldUp, back));
    let up = normalize(cross(back, right));
    setRight(right); setUp(up); setBack(back); setPos(initPos);
    setAxis(vec3f(0, 1, 0));
    cam.data[19] = 0.0; cam.data[20] = dist;
    setTgt(vec3f(0, 0, 0));
    cam.data[24] = pngine.time; cam.data[25] = 1.0;
    let viewMatrix = inverseCamera(right, up, back, initPos);
    let proj = perspective(PI / 3.0, pngine.aspect, 0.1, 200.0);
    mvp.matrix = proj * viewMatrix;
    mvp.camPos = vec4f(initPos, 1.0);
    return;
  }
  let dt = clamp(pngine.time - cam.data[24], 0.0, 0.1);
  cam.data[24] = pngine.time;
  var right = getRight(); var up = getUp(); var back = getBack();
  var axis = vec3f(cam.data[16], cam.data[17], cam.data[18]);
  var angVel = cam.data[19]; var dist = cam.data[20]; var tgt = getTgt();
  let buttonsI = u32(pointer.buttons); let modsI = u32(pointer.modifiers);
  let leftDown = (buttonsI & 1u) != 0u;
  let middleDown = (buttonsI & 4u) != 0u;
  let spaceHeld = (modsI & 16u) != 0u;
  let isPanning = (leftDown && spaceHeld) || middleDown;
  let isOrbiting = leftDown && !isPanning;
  if (isPanning && (abs(pointer.dx) > EPSILON || abs(pointer.dy) > EPSILON)) {
    let panDelta = right * (-pointer.dx * PAN_SPEED * dist) + up * (pointer.dy * PAN_SPEED * dist);
    tgt += panDelta;
  }
  let ctrlHeld = (modsI & 2u) != 0u;
  if (!ctrlHeld) {
    if (abs(pointer.scrollX) > EPSILON) { tgt += right * (pointer.scrollX * 0.02 * dist); }
    if (abs(pointer.scrollY) > EPSILON) { tgt += up * (-pointer.scrollY * 0.02 * dist); }
  }
  if (isOrbiting) {
    angVel = 0.0;
    let movement = right * pointer.dx + up * (-pointer.dy);
    let crossP = cross(movement, back);
    let mag = length(crossP);
    if (mag > EPSILON) { axis = crossP / mag; angVel = mag * ROTATION_SPEED; }
  } else if (!leftDown && !middleDown) {
    angVel *= pow(1.0 - FRICTION, dt);
  }
  let rotAngle = angVel * dt;
  if (rotAngle > EPSILON) {
    back = normalize(rotateVec(back, axis, rotAngle));
    let worldUp = vec3f(0, 1, 0);
    let newRight = cross(worldUp, back);
    if (length(newRight) > EPSILON) { right = normalize(newRight); }
    up = normalize(cross(back, right));
  }
  if (ctrlHeld && abs(pointer.scrollY) > EPSILON) {
    dist *= 1.0 + pointer.scrollY * ZOOM_SPEED;
    dist = clamp(dist, 0.1, 200.0);
  }
  let position = tgt + back * dist;
  setRight(right); setUp(up); setBack(back); setPos(position);
  setAxis(axis);
  cam.data[19] = angVel; cam.data[20] = dist; setTgt(tgt);
  let viewMatrix = inverseCamera(right, up, back, position);
  let proj = perspective(PI / 3.0, pngine.aspect, 0.1, 200.0);
  mvp.matrix = proj * viewMatrix;
  mvp.camPos = vec4f(position, 1.0);
}
""")

; ── Shader: Density ───────────────────────────────────────────────

(shader-module :name densityShader :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }
@group(0) @binding(0) var<uniform> pngine: PngineInputs;
@group(0) @binding(1) var<storage, read_write> density: array<f32>;

fn sdTorus(p: vec3f, t: vec2f) -> f32 {
  let q = vec2f(length(p.xz) - t.x, p.y);
  return length(q) - t.y;
}

fn udRoundBox(p: vec3f, b: vec3f, r: f32) -> f32 {
  return length(max(abs(p) - b, vec3f(0.0))) - r;
}

fn opSmoothUnion(a: f32, b: f32, k: f32) -> f32 {
  let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
  return mix(b, a, h) - k * h * (1.0 - h);
}

fn rotateY(p: vec3f, a: f32) -> vec3f {
  let c = cos(a); let s = sin(a);
  return vec3f(p.x * c + p.z * s, p.y, -p.x * s + p.z * c);
}

fn sdf(p: vec3f, t: f32) -> f32 {
  let rp = rotateY(p, t * 0.3);
  let box_d = udRoundBox(rp, vec3f(4.0, 4.0, 4.0), 0.5);
  let torus_r = 8.0 + 2.0 * sin(t * 0.7);
  let torus_d = sdTorus(rp, vec2f(torus_r, 2.0));
  return opSmoothUnion(box_d, torus_d, 2.0);
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) gid: vec3u) {
  let id = gid.x;
  if (id >= 35937u) { return; } // 33^3
  let N = 33u;
  let z = id / (N * N);
  let y = (id / N) % N;
  let x = id % N;
  let pos = vec3f(f32(x), f32(y), f32(z)) * 1.0 + vec3f(-16.0);
  density[id] = -sdf(pos, pngine.time); // negate: positive = inside (matches triangle table convention)
}
""")

; ── Shader: Vertex Generation ─────────────────────────────────────

(shader-module :name vertexGenShader :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }
@group(0) @binding(0) var<storage, read> density: array<f32>;
@group(0) @binding(1) var<storage, read_write> vertices: array<f32>;
@group(0) @binding(2) var<storage, read_write> vidMap: array<atomic<u32>>;
@group(0) @binding(3) var<storage, read_write> counters: array<atomic<u32>, 4>;
@group(0) @binding(4) var<uniform> pngine: PngineInputs;

const N: u32 = 32u;
const NV: u32 = 33u;
const GRID_MIN: f32 = -16.0;
const CELL_SIZE: f32 = 1.0;

// SDF functions (duplicated for normal computation)
fn sdTorus(p: vec3f, t: vec2f) -> f32 {
  let q = vec2f(length(p.xz) - t.x, p.y);
  return length(q) - t.y;
}
fn udRoundBox(p: vec3f, b: vec3f, r: f32) -> f32 {
  return length(max(abs(p) - b, vec3f(0.0))) - r;
}
fn opSmoothUnion(a: f32, b: f32, k: f32) -> f32 {
  let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
  return mix(b, a, h) - k * h * (1.0 - h);
}
fn rotateY(p: vec3f, a: f32) -> vec3f {
  let c = cos(a); let s = sin(a);
  return vec3f(p.x * c + p.z * s, p.y, -p.x * s + p.z * c);
}
fn sdf(p: vec3f, t: f32) -> f32 {
  let rp = rotateY(p, t * 0.3);
  let box_d = udRoundBox(rp, vec3f(4.0, 4.0, 4.0), 0.5);
  let torus_r = 8.0 + 2.0 * sin(t * 0.7);
  let torus_d = sdTorus(rp, vec2f(torus_r, 2.0));
  return opSmoothUnion(box_d, torus_d, 2.0);
}

fn densityAt(x: u32, y: u32, z: u32) -> f32 {
  return density[z * NV * NV + y * NV + x];
}

fn computeNormal(pos: vec3f) -> vec3f {
  // Gradient of raw SDF (not negated) points outward from surface
  let eps = 0.5;
  let t = pngine.time;
  return normalize(vec3f(
    sdf(pos + vec3f(eps, 0, 0), t) - sdf(pos - vec3f(eps, 0, 0), t),
    sdf(pos + vec3f(0, eps, 0), t) - sdf(pos - vec3f(0, eps, 0), t),
    sdf(pos + vec3f(0, 0, eps), t) - sdf(pos - vec3f(0, 0, eps), t)
  ));
}

// Simplified AO: sample density in a few directions
fn computeAO(pos: vec3f, normal: vec3f) -> f32 {
  var ao = 0.0;
  let step_size = 1.5;
  for (var i = 1u; i <= 5u; i++) {
    let dist = f32(i) * step_size;
    let sample_pos = pos + normal * dist;
    let d = sdf(sample_pos, pngine.time);
    ao += max(0.0, dist - d) / dist;
  }
  return clamp(1.0 - ao * 0.3, 0.0, 1.0);
}

// Corner offsets for 8 cube vertices
const kCorner = array<vec3u, 8>(
  vec3u(0,0,0), vec3u(1,0,0), vec3u(1,1,0), vec3u(0,1,0),
  vec3u(0,0,1), vec3u(1,0,1), vec3u(1,1,1), vec3u(0,1,1)
);

// Primary edge definitions: (corner0, corner1, axis)
// Edge 0: X-axis (corners 0→1), Edge 3: Y-axis (corners 0→3), Edge 8: Z-axis (corners 0→4)
const kPrimaryEdge = array<vec3u, 3>(
  vec3u(0u, 1u, 0u), // edge 0: X
  vec3u(0u, 3u, 1u), // edge 3: Y
  vec3u(0u, 4u, 2u)  // edge 8: Z
);

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) gid: vec3u) {
  let id = gid.x;
  if (id >= 32768u) { return; } // 32^3 cells
  let cz = id / (N * N);
  let cy = (id / N) % N;
  let cx = id % N;

  // Read 8 corner densities
  var d: array<f32, 8>;
  for (var i = 0u; i < 8u; i++) {
    let c = kCorner[i];
    d[i] = densityAt(cx + c.x, cy + c.y, cz + c.z);
  }

  // Compute cube case (standard Paul Bourke convention: bit i = corner i inside)
  var cubeCase = 0u;
  for (var i = 0u; i < 8u; i++) {
    if (d[i] > 0.0) { cubeCase |= (1u << i); }
  }
  if (cubeCase == 0u || cubeCase == 255u) { return; }

  // Check 3 primary edges
  for (var e = 0u; e < 3u; e++) {
    let c0 = kPrimaryEdge[e].x;
    let c1 = kPrimaryEdge[e].y;
    let axis = kPrimaryEdge[e].z;
    let d0 = d[c0];
    let d1 = d[c1];

    // Edge crosses isosurface if signs differ
    if ((d0 < 0.0) == (d1 < 0.0)) { continue; }

    // Interpolate position
    let t = d0 / (d0 - d1);
    let p0 = vec3f(f32(cx) + f32(kCorner[c0].x), f32(cy) + f32(kCorner[c0].y), f32(cz) + f32(kCorner[c0].z));
    let p1 = vec3f(f32(cx) + f32(kCorner[c1].x), f32(cy) + f32(kCorner[c1].y), f32(cz) + f32(kCorner[c1].z));
    let localPos = mix(p0, p1, vec3f(t));
    let worldPos = localPos * CELL_SIZE + vec3f(GRID_MIN);

    // Compute normal and AO
    let normal = computeNormal(worldPos);
    let ao = computeAO(worldPos, normal);

    // Allocate vertex
    let vertexId = atomicAdd(&counters[0], 1u);
    if (vertexId >= 65536u) { continue; }

    // Write vertex data: [pos.x, pos.y, pos.z, ao, normal.x, normal.y, normal.z, 0]
    let base = vertexId * 8u;
    vertices[base + 0u] = worldPos.x;
    vertices[base + 1u] = worldPos.y;
    vertices[base + 2u] = worldPos.z;
    vertices[base + 3u] = ao;
    vertices[base + 4u] = normal.x;
    vertices[base + 5u] = normal.y;
    vertices[base + 6u] = normal.z;
    vertices[base + 7u] = 0.0;

    // Store vertex ID in map
    let mapIdx = axis * N * N * N + cz * N * N + cy * N + cx;
    atomicStore(&vidMap[mapIdx], vertexId);
  }
}
""")

; ── Shader: Mesh Render ───────────────────────────────────────────

(shader-module :name meshRenderShader :code """
struct MVPData { matrix: mat4x4f, camPos: vec4f }
@group(0) @binding(0) var<storage, read> mvp: MVPData;

struct VSOut {
  @builtin(position) position: vec4f,
  @location(0) worldPos: vec3f,
  @location(1) normal: vec3f,
  @location(2) ao: f32,
}

@vertex
fn vs(@location(0) posAO: vec4f, @location(1) normalPad: vec4f) -> VSOut {
  var out: VSOut;
  out.position = mvp.matrix * vec4f(posAO.xyz, 1.0);
  out.worldPos = posAO.xyz;
  out.normal = normalPad.xyz;
  out.ao = posAO.w;
  return out;
}

@fragment
fn fs(in: VSOut) -> @location(0) vec4f {
  let N = normalize(in.normal);
  let L = normalize(vec3f(0.4, 0.8, 0.3));
  let V = normalize(mvp.camPos.xyz - in.worldPos);
  let H = normalize(L + V);

  // Normal-based color: warm on top, cool on sides, deep underneath
  let ny = N.y * 0.5 + 0.5; // 0=down, 1=up
  let top    = vec3f(0.85, 0.55, 0.35); // warm orange
  let side   = vec3f(0.35, 0.55, 0.70); // steel blue
  let bottom = vec3f(0.20, 0.25, 0.40); // deep indigo
  let mat = mix(mix(bottom, side, smoothstep(0.0, 0.4, ny)), top, smoothstep(0.5, 1.0, ny));

  let NdotL = dot(N, L);
  let diff = max(NdotL, 0.0);
  let back_diff = max(-NdotL, 0.0) * 0.15;
  let spec = pow(max(dot(N, H), 0.0), 48.0);
  let fresnel = pow(1.0 - max(dot(N, V), 0.0), 3.0) * 0.25;
  let ambient = 0.12;
  let color = mat * (ambient + diff * 0.75 + back_diff) + vec3f(0.9) * spec + vec3f(0.4, 0.5, 0.7) * fresnel;
  return vec4f(color * in.ao, 1.0);
}
""")

; ── Compute Pipelines ──────────────────────────────────────────────────

(compute-pipeline :name densityPipeline :module densityShader :entry main)

(compute-pipeline :name cameraPipeline :module cameraShader :entry updateCamera)

(compute-pipeline :name clearPipeline :module clearShader :entry main)

(compute-pipeline :name vertexGenPipeline :module vertexGenShader :entry main)

(compute-pipeline :name indexGenPipeline :module indexGenShader :entry main)

(compute-pipeline :name indirectArgsPipeline :module indirectArgsShader :entry main)


; ── Render Pipelines ───────────────────────────────────────────────────

(render-pipeline :name groundRenderPipeline
  (layout auto)
  (vertex (module groundRenderShader) (entry vs)
    (buffers
      (vertex-buffer :array-stride 24
        (attribute :shader-location 0 :offset 0 :format float32x3)
        (attribute :shader-location 1 :offset 12 :format float32x3))))
  (fragment (module groundRenderShader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list))
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(render-pipeline :name meshRenderPipeline
  (layout auto)
  (vertex (module meshRenderShader) (entry vs)
    (buffers
      (vertex-buffer :array-stride 32
        (attribute :shader-location 0 :offset 0 :format float32x4)
        (attribute :shader-location 1 :offset 16 :format float32x4))))
  (fragment (module meshRenderShader) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list) :cull-mode back)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

; ── Bind Groups ────────────────────────────────────────────────────────

(bind-group :name meshRenderBG :layout-pipeline meshRenderPipeline :layout-index 0
  (entry :binding 0 :buffer mvpBuffer))

(bind-group :name groundRenderBG :layout-pipeline groundRenderPipeline :layout-index 0
  (entry :binding 0 :buffer mvpBuffer))

(bind-group :name vertexGenBG :layout-pipeline vertexGenPipeline :layout-index 0
  (entry :binding 0 :buffer densityBuffer)
  (entry :binding 1 :buffer vertexBuffer)
  (entry :binding 2 :buffer vertexIdMap)
  (entry :binding 3 :buffer atomicCounters)
  (entry :binding 4 :buffer timeUniforms))

(bind-group :name densityBG :layout-pipeline densityPipeline :layout-index 0
  (entry :binding 0 :buffer timeUniforms)
  (entry :binding 1 :buffer densityBuffer))

(bind-group :name indirectArgsBG :layout-pipeline indirectArgsPipeline :layout-index 0
  (entry :binding 0 :buffer atomicCounters)
  (entry :binding 1 :buffer indirectDrawBuffer))

(bind-group :name indexGenBG :layout-pipeline indexGenPipeline :layout-index 0
  (entry :binding 0 :buffer densityBuffer)
  (entry :binding 1 :buffer vertexIdMap)
  (entry :binding 2 :buffer indexBuffer)
  (entry :binding 3 :buffer atomicCounters))

(bind-group :name cameraBG :layout-pipeline cameraPipeline :layout-index 0
  (entry :binding 0 :buffer timeUniforms)
  (entry :binding 1 :buffer pointerBuf)
  (entry :binding 2 :buffer cameraState)
  (entry :binding 3 :buffer mvpBuffer))

(bind-group :name clearBG :layout-pipeline clearPipeline :layout-index 0
  (entry :binding 0 :buffer atomicCounters)
  (entry :binding 1 :buffer indirectDrawBuffer)
  (entry :binding 2 :buffer vertexIdMap))

; ── Compute Passes ─────────────────────────────────────────────────────

(compute-pass :name cameraPass :pipeline cameraPipeline :bind-groups [cameraBG]
  :dispatch [1 1 1])

(compute-pass :name clearPass :pipeline clearPipeline :bind-groups [clearBG]
  :dispatch [384 1 1])

(compute-pass :name densityPass :pipeline densityPipeline :bind-groups [densityBG]
  :dispatch [141 1 1])

(compute-pass :name vertexPass :pipeline vertexGenPipeline :bind-groups [vertexGenBG]
  :dispatch [128 1 1])

(compute-pass :name indexPass :pipeline indexGenPipeline :bind-groups [indexGenBG]
  :dispatch [128 1 1])

(compute-pass :name indirectArgsPass :pipeline indirectArgsPipeline :bind-groups [indirectArgsBG]
  :dispatch [1 1 1])

; ── Render Passes ──────────────────────────────────────────────────────

(render-pass :name renderMeshPass
  (color-attachment :view context-current-texture
    :clear-value [0.18 0.18 0.22 1.0] :load-op clear :store-op store)
  (depth-attachment :view depthTexture
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  :pipeline meshRenderPipeline
  :vertex-buffers [vertexBuffer]
  :index-buffer indexBuffer
  :bind-groups [meshRenderBG]
  (draw-indexed-indirect :buffer indirectDrawBuffer :offset 0))

(render-pass :name renderGroundPass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  (depth-attachment :view depthTexture :depth-load-op load :depth-store-op store)
  :pipeline groundRenderPipeline
  :vertex-buffers [groundVB]
  :bind-groups [groundRenderBG]
  (draw :vertex-count 6))

; ── Frame ──────────────────────────────────────────────────────────────

(frame :name main
  :perform [writeTime
            writePointer
            clearPass
            densityPass
            vertexPass
            indexPass
            indirectArgsPass
            cameraPass
            renderMeshPass
            renderGroundPass])
