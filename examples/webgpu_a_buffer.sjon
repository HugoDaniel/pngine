; A-buffer OIT — port of the webgpu-samples `a-buffer` sample: order-independent
; transparency via per-pixel linked lists. An opaque pass draws 8 instanced
; teapots with depth; a translucent pass draws 8 more in the alternate grid
; cells with :write-mask 0 — its fragments write nothing to the framebuffer,
; instead atomicAdd-allocating linked-list slots and atomicExchange-pushing
; onto per-pixel heads, rejecting fragments behind the opaque depth; a
; composite pass walks each pixel's list, sorts up to 12 layers by depth and
; blends back-to-front.
;
; The opaque depth is bound as an unfilterable-float texture through an
; explicit bind-group layout — auto layout would infer filterable float and
; reject the depth view. All bind groups target their pipeline via
; :layout-pipeline (translucentBG through translucentPipe's layout).
;
; Differences from upstream: the device-limit-driven slice machinery
; (maxStorageBufferBindingSize division, dynamic uniform offsets, per-slice
; scissor + copy-buffer heads reset) collapses to one compile-time slice — a
; fixed 1024x1024 budget with AVG_LAYERS 3 (the linkedList stride is 32 B per
; WGSL layout, so 3*1024^2*32 = 100.7 MB stays under the 128 MiB default
; binding limit). The heads reset is a compute clear pass, the camera is a
; 1-thread compute pass orbiting from time, and there is no scissor: the
; in-shader budget guards discard translucent fragments outside 1024x1024
; instead.

(define :name BUDGET_W :value 1024)
(define :name BUDGET_H :value 1024)
(define :name AVG_LAYERS :value 3)

(limits :max-storage-buffers-in-fragment-stage 2)

(data :name teapotMesh (teapot :format [position3]))
(buffer :name teapotVB :size teapotMesh :usage [vertex]
  :mapped-at-creation teapotMesh)
(buffer :name teapotIB :index-of teapotMesh :usage [index])

(buffer :name inputsBuf :size 16 :usage [uniform copy-dst])
(buffer :name camBuf :size 64 :usage [storage])
(buffer :name heads :size (* (+ 1 (* BUDGET_W BUDGET_H)) 4) :usage [storage])
(buffer :name linkedList :size (* AVG_LAYERS BUDGET_W BUDGET_H 32) :usage [storage])
(texture :name depthTex :size canvas :format depth24plus
  :usage [render-attachment texture-binding])

(queue :name writeInputs
  (write-buffer :buffer inputsBuf :offset 0 :data pngine-inputs))

(shader-module :name cameraCode :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }
struct Camera { mvp : mat4x4f }

@group(0) @binding(0) var<uniform> inputs : PngineInputs;
@group(0) @binding(1) var<storage, read_write> cam : Camera;

fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
  let f = 1.0 / tan(fovy * 0.5);
  let nf = 1.0 / (near - far);
  return mat4x4f(
    vec4f(f / aspect, 0, 0, 0),
    vec4f(0, f, 0, 0),
    vec4f(0, 0, far * nf, -1),
    vec4f(0, 0, far * near * nf, 0));
}
fn lookAt(eye: vec3f, focus: vec3f, up: vec3f) -> mat4x4f {
  let fwd = normalize(focus - eye);
  let s = normalize(cross(fwd, up));
  let u = cross(s, fwd);
  return mat4x4f(
    vec4f(s.x, u.x, -fwd.x, 0),
    vec4f(s.y, u.y, -fwd.y, 0),
    vec4f(s.z, u.z, -fwd.z, 0),
    vec4f(-dot(s, eye), -dot(u, eye), dot(fwd, eye), 1));
}

// Upstream: eye = rotateY(pi * Date.now()/5000) * (0, 5, -100);
// repositioned to rad = time * pi/5.
@compute @workgroup_size(1)
fn main() {
  let rad = inputs.time * 0.6283185;
  let eye = vec3f(-100.0 * sin(rad), 5.0, -100.0 * cos(rad));
  let view = lookAt(eye, vec3f(0.0), vec3f(0.0, 1.0, 0.0));
  cam.mvp = perspective(1.2566, inputs.aspect, 1.0, 2000.0) * view;
}
""")

(shader-module :name clearCode :code """
struct Heads {
  numFragments : u32,
  data : array<u32>,
}
@group(0) @binding(0) var<storage, read_write> heads : Heads;

// Sentinel-fill the per-pixel heads; slot 0 of the allocator resets to 0
// (upstream sentinel-filled it too, silently wasting the first slot).
@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) gid : vec3u) {
  let i = gid.x;
  if (i == 0u) { heads.numFragments = 0u; }
  if (i < 1048576u) { heads.data[i] = 0xffffffffu; }
}
""")

(shader-module :name opaqueCode :code """
struct Camera { mvp : mat4x4f }
@binding(0) @group(0) var<storage, read> cam : Camera;

struct VertexOutput {
  @builtin(position) position : vec4f,
  @location(0) @interpolate(flat) instance : u32,
}

const SCALE = 1.5;

@vertex
fn main_vs(@location(0) position : vec3f,
           @builtin(instance_index) instance : u32) -> VertexOutput {
  var output : VertexOutput;
  // Staggered 4x4 grid (upstream's placement, verbatim).
  const gridWidth = 125.0;
  const cellSize = gridWidth / 4.0;
  let row = instance / 2u;
  let col = instance % 2u;
  let xOffset = -gridWidth / 2.0 + cellSize / 2.0 + 2.0 * cellSize * f32(col) + f32(row % 2u != 0u) * cellSize;
  let zOffset = -gridWidth / 2.0 + cellSize / 2.0 + 2.0 + f32(row) * cellSize;
  let p = position * SCALE;
  let offsetPos = vec4f(p.x + xOffset, p.y, p.z + zOffset, 1.0);
  output.position = cam.mvp * offsetPos;
  output.instance = instance;
  return output;
}

@fragment
fn main_fs(@location(0) @interpolate(flat) instance : u32) -> @location(0) vec4f {
  var colors = array<vec3f, 6>(
      vec3(1.0, 0.0, 0.0),
      vec3(0.0, 1.0, 0.0),
      vec3(0.0, 0.0, 1.0),
      vec3(1.0, 0.0, 1.0),
      vec3(1.0, 1.0, 0.0),
      vec3(0.0, 1.0, 1.0),
  );
  return vec4(colors[instance % 6u], 1.0);
}
""")

(shader-module :name translucentCode :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }
struct Camera { mvp : mat4x4f }

struct Heads {
  numFragments : atomic<u32>,
  data : array<atomic<u32>>,
}

struct LinkedListElement {
  color : vec4f,
  depth : f32,
  next : u32,
}

struct LinkedList {
  data : array<LinkedListElement>,
}

@binding(0) @group(0) var<storage, read> cam : Camera;
@binding(1) @group(0) var<uniform> inputs : PngineInputs;
@binding(2) @group(0) var<storage, read_write> heads : Heads;
@binding(3) @group(0) var<storage, read_write> linkedList : LinkedList;
@binding(4) @group(0) var opaqueDepthTexture : texture_2d<f32>;

const MAX_FRAGS = 3145728u;        // AVG_LAYERS * BUDGET_W * BUDGET_H
const BUDGET = 1024u;
const SCALE = 1.5;

struct VertexOutput {
  @builtin(position) position : vec4f,
  @location(0) @interpolate(flat) instance : u32,
}

@vertex
fn main_vs(@location(0) position : vec3f,
           @builtin(instance_index) instance : u32) -> VertexOutput {
  var output : VertexOutput;
  // The alternate grid cells (row % 2 == 0 vs the opaque pass's != 0).
  const gridWidth = 125.0;
  const cellSize = gridWidth / 4.0;
  let row = instance / 2u;
  let col = instance % 2u;
  let xOffset = -gridWidth / 2.0 + cellSize / 2.0 + 2.0 * cellSize * f32(col) + f32(row % 2u == 0u) * cellSize;
  let zOffset = -gridWidth / 2.0 + cellSize / 2.0 + 2.0 + f32(row) * cellSize;
  let p = position * SCALE;
  let offsetPos = vec4f(p.x + xOffset, p.y, p.z + zOffset, 1.0);
  output.position = cam.mvp * offsetPos;
  output.instance = instance;
  return output;
}

@fragment
fn main_fs(@builtin(position) position : vec4f,
           @location(0) @interpolate(flat) instance : u32) {
  var colors = array<vec3f, 6>(
    vec3(1.0, 0.0, 0.0),
    vec3(0.0, 1.0, 0.0),
    vec3(0.0, 0.0, 1.0),
    vec3(1.0, 0.0, 1.0),
    vec3(1.0, 1.0, 0.0),
    vec3(0.0, 1.0, 1.0),
  );

  let fragCoords = vec2i(position.xy);
  // Budget guard replaces upstream's scissor (native no-op; see header).
  if (u32(fragCoords.x) >= BUDGET || u32(fragCoords.y) >= BUDGET) {
    discard;
  }
  let opaqueDepth = textureLoad(opaqueDepthTexture, fragCoords, 0).x;
  if (position.z >= opaqueDepth) {
    discard;
  }

  let headsIndex = u32(fragCoords.y) * u32(inputs.width) + u32(fragCoords.x);
  let fragIndex = atomicAdd(&heads.numFragments, 1u);
  if (fragIndex < MAX_FRAGS) {
    let lastHead = atomicExchange(&heads.data[headsIndex], fragIndex);
    linkedList.data[fragIndex].depth = position.z;
    linkedList.data[fragIndex].next = lastHead;
    linkedList.data[fragIndex].color = vec4(colors[(instance + 3u) % 6u], 0.3);
  }
}
""")

(shader-module :name compositeCode :code """
struct PngineInputs { time: f32, width: f32, height: f32, aspect: f32 }

struct Heads {
  numFragments : u32,
  data : array<u32>,
}

struct LinkedListElement {
  color : vec4f,
  depth : f32,
  next : u32,
}

struct LinkedList {
  data : array<LinkedListElement>,
}

@binding(0) @group(0) var<uniform> inputs : PngineInputs;
@binding(1) @group(0) var<storage, read_write> heads : Heads;
@binding(2) @group(0) var<storage, read_write> linkedList : LinkedList;

@vertex
fn main_vs(@builtin(vertex_index) vertIndex : u32) -> @builtin(position) vec4f {
  var position = array<vec2f, 6>(
    vec2(-1.0, -1.0),
    vec2(1.0, -1.0),
    vec2(1.0, 1.0),
    vec2(-1.0, -1.0),
    vec2(1.0, 1.0),
    vec2(-1.0, 1.0),
  );
  return vec4(position[vertIndex], 0.0, 1.0);
}

const maxLayers = 12u;

@fragment
fn main_fs(@builtin(position) position : vec4f) -> @location(0) vec4f {
  let fragCoords = vec2i(position.xy);
  let headsIndex = u32(fragCoords.y) * u32(inputs.width) + u32(fragCoords.x);

  var layers : array<LinkedListElement, maxLayers>;
  var numLayers = 0u;
  var elementIndex = heads.data[headsIndex];

  while (elementIndex != 0xFFFFFFFFu && numLayers < maxLayers) {
    layers[numLayers] = linkedList.data[elementIndex];
    numLayers++;
    elementIndex = linkedList.data[elementIndex].next;
  }

  if (numLayers == 0u) {
    discard;
  }

  for (var i = 1u; i < numLayers; i++) {
    let toInsert = layers[i];
    var j = i;
    while (j > 0u && toInsert.depth > layers[j - 1u].depth) {
      layers[j] = layers[j - 1u];
      j--;
    }
    layers[j] = toInsert;
  }

  var color = vec4(layers[0].color.a * layers[0].color.rgb, layers[0].color.a);
  for (var i = 1u; i < numLayers; i++) {
    let mixed = mix(color.rgb, layers[i].color.rgb, layers[i].color.aaa);
    color = vec4(mixed, color.a);
  }
  return color;
}
""")

(compute-pipeline :name cameraPipe :module cameraCode :entry main)
(compute-pipeline :name clearPipe :module clearCode :entry main)

(render-pipeline :name opaquePipe
  (layout auto)
  (vertex (module opaqueCode) (entry main_vs)
    (buffers
      (vertex-buffer :array-stride 12
        (attribute :shader-location 0 :offset 0 :format float32x3))))
  (fragment (module opaqueCode) (entry main_fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list))
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

; Explicit BGL: the opaque depth is sampled as unfilterable-float, which
; auto layout cannot infer for texture_2d<f32>.
(bind-group-layout :name translucentBGL
  (entry :binding 0 :visibility [vertex] (buffer :type read-only-storage))
  (entry :binding 1 :visibility [fragment] (buffer :type uniform))
  (entry :binding 2 :visibility [fragment] (buffer :type storage))
  (entry :binding 3 :visibility [fragment] (buffer :type storage))
  (entry :binding 4 :visibility [fragment]
    (texture :sample-type unfilterable-float :view-dimension 1)))
(pipeline-layout :name translucentPL :bind-group-layouts [translucentBGL])

(render-pipeline :name translucentPipe :pipeline-layout translucentPL
  (vertex (module translucentCode) (entry main_vs)
    (buffers
      (vertex-buffer :array-stride 12
        (attribute :shader-location 0 :offset 0 :format float32x3))))
  (fragment (module translucentCode) (entry main_fs)
    (targets (target :format preferred-canvas-format :write-mask 0)))
  (primitive (topology triangle-list)))

(render-pipeline :name compositePipe
  (layout auto)
  (vertex (module compositeCode) (entry main_vs))
  (fragment (module compositeCode) (entry main_fs)
    (targets (target :format preferred-canvas-format
      (blend (color :src-factor one :dst-factor one-minus-src-alpha :operation add)
             (alpha :src-factor one :dst-factor zero :operation add)))))
  (primitive (topology triangle-list)))

(bind-group :name cameraBG :layout-pipeline cameraPipe :layout-index 0
  (entry :binding 0 :buffer inputsBuf)
  (entry :binding 1 :buffer camBuf))

(bind-group :name clearBG :layout-pipeline clearPipe :layout-index 0
  (entry :binding 0 :buffer heads))

(bind-group :name opaqueBG :layout-pipeline opaquePipe :layout-index 0
  (entry :binding 0 :buffer camBuf))

(bind-group :name translucentBG :layout-pipeline translucentPipe :layout-index 0
  (entry :binding 0 :buffer camBuf)
  (entry :binding 1 :buffer inputsBuf)
  (entry :binding 2 :buffer heads)
  (entry :binding 3 :buffer linkedList)
  (entry :binding 4 :texture depthTex))

(bind-group :name compositeBG :layout-pipeline compositePipe :layout-index 0
  (entry :binding 0 :buffer inputsBuf)
  (entry :binding 1 :buffer heads)
  (entry :binding 2 :buffer linkedList))

(compute-pass :name cameraPass :pipeline cameraPipe :bind-groups [cameraBG]
  :dispatch [1 1 1])

(compute-pass :name clearHeads :pipeline clearPipe :bind-groups [clearBG]
  :dispatch-workgroups (ceil (/ (* BUDGET_W BUDGET_H) 256)))

(render-pass :name opaquePass
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (depth-attachment :view depthTex :depth-clear-value 1.0
    :depth-load-op clear :depth-store-op store)
  :pipeline opaquePipe :bind-groups [opaqueBG]
  :vertex-buffers [teapotVB] :index-buffer teapotIB
  (draw-indexed :index-count 2976 :instance-count 8))

(render-pass :name translucentPass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  :pipeline translucentPipe :bind-groups [translucentBG]
  :vertex-buffers [teapotVB] :index-buffer teapotIB
  (draw-indexed :index-count 2976 :instance-count 8))

(render-pass :name compositePass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  :pipeline compositePipe :bind-groups [compositeBG]
  (draw :vertex-count 6))

(frame :name main
  :perform [writeInputs cameraPass clearHeads
            opaquePass translucentPass compositePass])
