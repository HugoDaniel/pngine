; Attachment view — colour — selects one mip level.
;
; `attachTex` has two levels. The render pass's colour attachment names
; `mipView`, an explicit (texture-view …) over level 1, so the pass renders
; into that 2x2 subresource instead of the texture's default (level 0) view.
; The emitter selects PNGB begin_render_pass_views (0x81) for the whole pass;
; a pass with only textures keeps the legacy record byte-for-byte.
;
; Nothing presents: the result stays in the selected subresource. Offscreen
; attachments are the point (the webgpu-generate-mipmap pattern this unblocks),
; not a canvas image.

(shader-module :name code :code """
    @vertex
    fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
      var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
      return vec4f(p[i], 0.0, 1.0);
    }

    @fragment
    fn fs() -> @location(0) vec4f { return vec4f(1.0, 0.5, 0.0, 1.0); }
""")

(texture :name attachTex :size [8 8] :format rgba8unorm
  :usage [render-attachment] :mip-level-count 2)
(texture-view :name mipView :texture attachTex
  :base-mip-level 1 :mip-level-count 1)

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))

(render-pass :name draw :pipeline pipe
  (color-attachment :view mipView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(frame :name main :perform [draw])
