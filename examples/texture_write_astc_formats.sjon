; Plan 07 tranche C: every ASTC format through the raw block upload path.
; Each texture is two whole texel blocks per axis, so its size is 2W x 2H
; for the shape WxH in the format name; every block is 16 bytes, making one
; tightly packed 32-byte block row and a 64-byte two-block image. The row
; stride is deliberately NOT 256-aligned: that is a buffer-copy rule, not a
; writeTexture rule.
(data :name blocks (bytes :base64 "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="))

(texture :name a4x4 :size [8 8] :format astc-4x4-unorm :usage [copy-dst])
(texture :name as4x4 :size [8 8] :format astc-4x4-unorm-srgb :usage [copy-dst])
(texture :name a5x4 :size [10 8] :format astc-5x4-unorm :usage [copy-dst])
(texture :name as5x4 :size [10 8] :format astc-5x4-unorm-srgb :usage [copy-dst])
(texture :name a5x5 :size [10 10] :format astc-5x5-unorm :usage [copy-dst])
(texture :name as5x5 :size [10 10] :format astc-5x5-unorm-srgb :usage [copy-dst])
(texture :name a6x5 :size [12 10] :format astc-6x5-unorm :usage [copy-dst])
(texture :name as6x5 :size [12 10] :format astc-6x5-unorm-srgb :usage [copy-dst])
(texture :name a6x6 :size [12 12] :format astc-6x6-unorm :usage [copy-dst])
(texture :name as6x6 :size [12 12] :format astc-6x6-unorm-srgb :usage [copy-dst])
(texture :name a8x5 :size [16 10] :format astc-8x5-unorm :usage [copy-dst])
(texture :name as8x5 :size [16 10] :format astc-8x5-unorm-srgb :usage [copy-dst])
(texture :name a8x6 :size [16 12] :format astc-8x6-unorm :usage [copy-dst])
(texture :name as8x6 :size [16 12] :format astc-8x6-unorm-srgb :usage [copy-dst])
(texture :name a8x8 :size [16 16] :format astc-8x8-unorm :usage [copy-dst])
(texture :name as8x8 :size [16 16] :format astc-8x8-unorm-srgb :usage [copy-dst])
(texture :name a10x5 :size [20 10] :format astc-10x5-unorm :usage [copy-dst])
(texture :name as10x5 :size [20 10] :format astc-10x5-unorm-srgb :usage [copy-dst])
(texture :name a10x6 :size [20 12] :format astc-10x6-unorm :usage [copy-dst])
(texture :name as10x6 :size [20 12] :format astc-10x6-unorm-srgb :usage [copy-dst])
(texture :name a10x8 :size [20 16] :format astc-10x8-unorm :usage [copy-dst])
(texture :name as10x8 :size [20 16] :format astc-10x8-unorm-srgb :usage [copy-dst])
(texture :name a10x10 :size [20 20] :format astc-10x10-unorm :usage [copy-dst])
(texture :name as10x10 :size [20 20] :format astc-10x10-unorm-srgb :usage [copy-dst])
(texture :name a12x10 :size [24 20] :format astc-12x10-unorm :usage [copy-dst])
(texture :name as12x10 :size [24 20] :format astc-12x10-unorm-srgb :usage [copy-dst])
(texture :name a12x12 :size [24 24] :format astc-12x12-unorm :usage [copy-dst])
(texture :name as12x12 :size [24 24] :format astc-12x12-unorm-srgb :usage [copy-dst])

(queue :name upload
  (write-texture :texture a4x4 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [8 8])
  (write-texture :texture as4x4 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [8 8])
  (write-texture :texture a5x4 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [10 8])
  (write-texture :texture as5x4 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [10 8])
  (write-texture :texture a5x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [10 10])
  (write-texture :texture as5x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [10 10])
  (write-texture :texture a6x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [12 10])
  (write-texture :texture as6x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [12 10])
  (write-texture :texture a6x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [12 12])
  (write-texture :texture as6x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [12 12])
  (write-texture :texture a8x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 10])
  (write-texture :texture as8x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 10])
  (write-texture :texture a8x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 12])
  (write-texture :texture as8x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 12])
  (write-texture :texture a8x8 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 16])
  (write-texture :texture as8x8 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [16 16])
  (write-texture :texture a10x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 10])
  (write-texture :texture as10x5 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 10])
  (write-texture :texture a10x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 12])
  (write-texture :texture as10x6 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 12])
  (write-texture :texture a10x8 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 16])
  (write-texture :texture as10x8 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 16])
  (write-texture :texture a10x10 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 20])
  (write-texture :texture as10x10 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [20 20])
  (write-texture :texture a12x10 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [24 20])
  (write-texture :texture as12x10 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [24 20])
  (write-texture :texture a12x12 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [24 24])
  (write-texture :texture as12x12 :data blocks :bytes-per-row 32 :rows-per-image 2 :size [24 24]))
(frame :name main :perform [upload])
