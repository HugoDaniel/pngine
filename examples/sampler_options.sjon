; Sampler options — exercises the full (sampler …) key set: address-mode-u/v/w,
; mipmap-filter, lod-min/max-clamp and max-anisotropy. A fullscreen triangle
; samples a canvas-sized texture with UVs that sweep past [0,1], so the
; per-axis address modes act on the sampled coordinates. The texture is never
; written, so the visible output is black; the file is about the descriptor.
;
; The three axes use three different modes (repeat / mirror-repeat /
; clamp-to-edge) so each is encoded independently. max-anisotropy 4 requires
; linear mag/min/mipmap filters (WebGPU validation), so all three are linear.

(shader-module :name code :code """
    @group(0) @binding(0) var samp: sampler;
    @group(0) @binding(1) var tex: texture_2d<f32>;

    @vertex
    fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      var p = array<vec2f, 3>(vec2f(-1, -1), vec2f(3, -1), vec2f(-1, 3));
      return vec4f(p[i], 0, 1);
    }

    @fragment
    fn fs(@builtin(position) c: vec4f) -> @location(0) vec4f {
      // UVs sweep [0,3) so every address mode is exercised outside [0,1].
      let uv = c.xy / vec2f(170.0);
      return textureSample(tex, samp, uv);
    }
""")

(texture :name tex :size canvas :format rgba8unorm :usage [texture-binding copy-dst])

(sampler :name samp
  :mag-filter linear :min-filter linear :mipmap-filter linear
  :address-mode-u repeat :address-mode-v mirror-repeat :address-mode-w clamp-to-edge
  :lod-min-clamp 0 :lod-max-clamp 8
  :max-anisotropy 4)

(render-pipeline :name pipe
  (layout auto)
  (vertex (module code) (entry vs))
  (fragment (module code) (entry fs)
    (targets (target :format preferred-canvas-format))))

(bind-group :name g :layout-pipeline pipe :layout-index 0
  (entry :binding 0 :sampler samp)
  (entry :binding 1 :texture tex))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe :bind-groups [g]
  (draw :vertex-count 3))

(frame :name main :perform [draw])
