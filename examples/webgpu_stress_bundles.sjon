(render-pass :name pass0
  (color-attachment :view context-current-texture :clear-value [0.03 0.03 0.05 1] :load-op clear :store-op store)
  (timestamp-writes :query-set tsQS :beginning-of-pass-write-index 0 :end-of-pass-write-index 1)
  :execute-bundles [b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14])
