  (resolve-query-set :query-set tsQS :first-query 0 :query-count 4 :destination resolveBuf :destination-offset 0)
  (copy-buffer-to-buffer :source resolveBuf :destination readbackBuf :size 32))

(frame :name main :perform [pass0 pass1 pass2 pass3 resolveOps])
