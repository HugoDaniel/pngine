; test_data_bytes — `(data … (bytes :file …))`: verbatim bytes from a sidecar.
;
; The sidecar is a four-entry RGBA8 palette, 16 bytes, one packed u32 per
; colour. No other `(data …)` source can carry it: `:float32` would spend 64
; bytes on values that are single bytes, and `:file` would wrap them in
; `[mime_len][mime]` and refuse to size the buffer.
;
; The fragment shader unpacks entry 0 (0xFF0080FF) and renders solid orange.
; Wrong bytes, or bytes that never arrived, render black.

(data :name palette (bytes :file "test_data_bytes.bin"))

; No `:size` — the entry sizes the buffer, which is the half `(data … :file …)`
; deliberately cannot do.
(buffer :name paletteBuf :usage [uniform copy-dst] :data palette)

(shader-module :name code :code """
    @vertex fn fullscreen(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      let p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
      return vec4f(p[i], 0.0, 1.0);
    }

    @group(0) @binding(0) var<uniform> palette: vec4u;

    // Alpha is forced so an all-zero (never filled) buffer reads as opaque
    // black rather than transparent — the difference must land in the RGB
    // channels the snapshot compares.
    @fragment fn show() -> @location(0) vec4f {
      return vec4f(unpack4x8unorm(palette.x).rgb, 1.0);
    }
""")

(bind-group :name g :layout pipe :group 0
  (entry :binding 0 :buffer paletteBuf))

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry fullscreen)
  (fragment :module code :entry show
    (color-target :format preferred-canvas-format))
  (primitive :topology triangle-list))

(render-pass :name draw
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  :pipeline pipe :bind-groups [g]
  (draw :vertex-count 3))

(frame :name main :perform [draw])
