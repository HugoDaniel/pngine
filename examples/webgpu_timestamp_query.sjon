; webgpu_timestamp_query — a rotating black cube whose render pass is
; bracketed by GPU timestamp queries. `(timestamp-writes …)` on the pass
; records a timestamp at its start and end into a 2-entry `(query-set …)`;
; a queue step then resolves both into a query-resolve buffer and copies
; them to a map-read readback buffer.
;
; A payload cannot consume its own readback, so displaying the numbers is
; the host page's job. The JS runtime delivers each readback as an array of
; Numbers (nanoseconds) through the `onQueryResult` option:
;   const p = await pngine(url, { canvas, onQueryResult: ([t0, t1]) => {
;     hud.textContent = `pass GPU time: ${((t1 - t0) / 1e3).toFixed(1)} us`;
;   }});
; Chrome quantizes timestamps (steps of 65.536 us observed); treat the values
; as indicative. The query family is a no-op in the native `--frame`
; renderer, so the readback only happens in the browser.
;
; Vertex strides and offsets are literals (40 / 0 / 16 / 32): a byte-count
; slot takes a number or an expression but not a bare define name. The draw's
; :vertex-count is a count slot, so it takes the define directly.

(define :name CUBE_VERTEX_COUNT :value 36)

(data :name cubeVertexArray (cube :format [position4 color4 uv2]))

(buffer :name verticesBuffer :size cubeVertexArray :usage [vertex]
  :mapped-at-creation cubeVertexArray)

(buffer :name uniforms :size 16 :usage [uniform copy-dst])

; Two timestamps: one at the start of the pass, one at the end.
(query-set :name tsQS :type timestamp :count 2)

; resolveBuf receives the resolved query values (query-resolve usage);
; readbackBuf is the map-read copy the host can map and read.
(buffer :name resolveBuf :size 16 :usage [query-resolve copy-src])
(buffer :name readbackBuf :size 16 :usage [map-read copy-dst])

(texture :name depthTexture :size canvas :format depth24plus :usage [render-attachment])

(queue :name writeUniforms
  (write-buffer :buffer uniforms :offset 0 :data pngine-inputs))

(shader-module :name code :code """
    struct PngineInputs {
      time: f32,
      width: f32,
      height: f32,
      aspect: f32,
    }
    @group(0) @binding(0) var<uniform> pngine: PngineInputs;

    fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
      let f = 1.0 / tan(fovy * 0.5);
      let nf = 1.0 / (near - far);
      return mat4x4f(
        vec4f(f / aspect, 0, 0, 0),
        vec4f(0, f, 0, 0),
        vec4f(0, 0, (far + near) * nf, -1),
        vec4f(0, 0, 2 * far * near * nf, 0),
      );
    }

    fn tr(t: vec3f) -> mat4x4f {
      return mat4x4f(
        vec4f(1, 0, 0, 0),
        vec4f(0, 1, 0, 0),
        vec4f(0, 0, 1, 0),
        vec4f(t, 1),
      );
    }

    // Rotation around arbitrary axis (normalized)
    fn rotateAxis(axis: vec3f, angle: f32) -> mat4x4f {
      let c = cos(angle);
      let s = sin(angle);
      let t2 = 1.0 - c;
      let x = axis.x; let y = axis.y; let z = axis.z;
      return mat4x4f(
        vec4f(t2*x*x + c,   t2*x*y + s*z, t2*x*z - s*y, 0),
        vec4f(t2*x*y - s*z, t2*y*y + c,   t2*y*z + s*x, 0),
        vec4f(t2*x*z + s*y, t2*y*z - s*x, t2*z*z + c,   0),
        vec4f(0, 0, 0, 1),
      );
    }

    struct VertexOutput {
      @builtin(position) position: vec4f,
    }

    @vertex fn vs(
      @location(0) position: vec4f,
      @location(1) color: vec4f,
      @location(2) uv: vec2f,
    ) -> VertexOutput {
      let t = pngine.time;

      // Camera at Z=-4, 72 degree FOV (2*PI/5)
      let proj = perspective(1.2566370, pngine.aspect, 1.0, 100.0);
      let view = tr(vec3f(0, 0, -4));

      // Rotation axis varies with time (matches original sample)
      let axis = normalize(vec3f(sin(t), cos(t), 0));
      let rot = rotateAxis(axis, 1.0);

      let mvp = proj * view * rot;

      var out: VertexOutput;
      out.position = mvp * position;
      return out;
    }

    @fragment fn fs() -> @location(0) vec4f {
      return vec4f(0, 0, 0, 1);
    }
  """)

(render-pipeline :name pipeline
  (layout auto)
  (vertex (module code) (entry vs)
    (buffers
      (vertex-buffer :array-stride 40
        (attribute :shader-location 0 :offset 0 :format float32x4)
        (attribute :shader-location 1 :offset 16 :format float32x4)
        (attribute :shader-location 2 :offset 32 :format float32x2))))
  (fragment (module code) (entry fs)
    (targets (target :format preferred-canvas-format)))
  (primitive (topology triangle-list) :cull-mode back)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(bind-group :name uniformBindGroup :layout-pipeline pipeline :layout-index 0
  (entry :binding 0 :buffer uniforms))

(render-pass :name renderPass
  (color-attachment :view context-current-texture :clear-value [242 242 242 255] :load-op clear :store-op store)
  (depth-attachment :view depthTexture :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  (timestamp-writes :query-set tsQS :begin 0 :end 1)
  :pipeline pipeline
  :vertex-buffers [verticesBuffer]
  :bind-groups [uniformBindGroup]
  (draw :vertex-count CUBE_VERTEX_COUNT))

(queue :name resolveOps
  (resolve-query-set :query-set tsQS :first-query 0 :query-count 2 :destination resolveBuf :destination-offset 0)
  (copy-buffer-to-buffer :source resolveBuf :source-offset 0 :destination readbackBuf :destination-offset 0 :size 16))

(frame :name main :perform [writeUniforms renderPass resolveOps])
