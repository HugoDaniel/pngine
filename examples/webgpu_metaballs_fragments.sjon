; webgpu_metaballs_fragments — the second instance of the program
; webgpu_marching_cubes_fragments.sjon is the first instance of. Six balls
; orbit on golden-angle-decorrelated Lissajous paths and every frame the same
; five compute stages re-mesh the isosurface of the inverse-square field
; f(p) = sum r_i²/|p-c_i|² - 1 on a 33³ grid, over the same ground plane.
;
; Read it against its twin. The forms differ only where the camera does, and
; the WGSL differs only in the two fragments this document declares itself:
;
; - lib/mc_field_metaballs.wgsl is positive-inside directly, so `field` needs
;   no sign flip, and `ambientOcclusion` returns 1.0 — an AO ray-march is
;   something only a distance function can do, and the shared vertex generator
;   does not have to know which document it was compiled into.
; - The palette below is cold where the twin's is warm.
; - The arcball is replaced by a stateless time-orbit camera, so there is no
;   pointer input and the image at time t is fully deterministic.
;
; Budget: 6 balls at r~3 give ~700 units² of shell over 1³ cells, about 2k
; emitting cells — far under MAX_VERTICES 65536 / MAX_INDICES 262144; the
; indirect-args stage clamps the index count as the overflow backstop.
;
; Defines used in buffer :size expressions; :array-stride spells the literal
; 32 although VERTEX_STRIDE compiles byte-identical.

(define :name GRID_TOTAL_VERTS :value 35937)
(define :name MAX_VERTICES :value 65536)
(define :name MAX_INDICES :value 262144)
(define :name VERTEX_ID_MAP_SIZE :value 98304)
(define :name VERTEX_STRIDE :value 32)

; ── Ground Plane (mesh primitive) ──────────────────────────────────────

(data :name groundPlane (plane :format [position3 normal3]))

; ── Buffers ────────────────────────────────────────────────────────────

(buffer :name vertexBuffer :size (* MAX_VERTICES VERTEX_STRIDE)
  :usage [vertex storage])

; GPU-generated u32 indices: no :index-of companion, so the index format is
; declared explicitly (propagates to set_index_buffer).
(buffer :name indexBuffer :size (* MAX_INDICES 4) :usage [index storage]
  :index-format uint32)

(buffer :name atomicCounters :size 16 :usage [storage])

(buffer :name mvpBuffer :size 128 :usage [storage])

(buffer :name indirectDrawBuffer :size 20 :usage [indirect storage])

(buffer :name timeUniforms :size 16 :usage [uniform copy-dst])

(buffer :name groundVB :usage [vertex]
  :data groundPlane)

(buffer :name vertexIdMap :size (* VERTEX_ID_MAP_SIZE 4) :usage [storage])

(buffer :name densityBuffer :size (* GRID_TOTAL_VERTS 4) :usage [storage])

; ── Textures ───────────────────────────────────────────────────────────

(texture :name depthTexture :size canvas :format depth24plus
  :usage [render-attachment])

; ── Queue Operations ───────────────────────────────────────────────────

(queue :name writeTime
  (write-buffer :buffer timeUniforms :offset 0 :data pngine-inputs))




; ── Shader: Indirect Args ─────────────────────────────────────────

; ── The library ────────────────────────────────────────────────────────
;
; The same eleven files webgpu_marching_cubes_fragments.sjon imports, and two
; of this document's own: a different scalar field, and a different palette.

(wgsl :name mcInputs :file "./lib/mc_inputs.wgsl")
(wgsl :name mcMvp :file "./lib/mc_mvp.wgsl")
(wgsl :name mcGrid :file "./lib/mc_grid.wgsl" :requires [density])
(wgsl :name mcNormal :file "./lib/mc_normal.wgsl" :requires [field pngine])
(wgsl :name fieldInstance :file "./lib/mc_field_metaballs.wgsl")

; Glossy metaball palette: cyan tops, deep teal body, indigo underside.
(wgsl :name palette :code """
const kTop = vec3f(0.45, 0.85, 0.80);
const kSide = vec3f(0.10, 0.45, 0.55);
const kBottom = vec3f(0.12, 0.15, 0.35);
""")

(shader-module :name indirectArgsShader :file "./lib/mc_indirect_args.wgsl")

; ── Shader: Clear ─────────────────────────────────────────────────

(shader-module :name clearShader :file "./lib/mc_clear.wgsl")

; ── Shader: Index Generation ──────────────────────────────────────

(shader-module :name indexGenShader :file "./lib/mc_index_gen.wgsl" :imports [mcGrid])

; ── Shader: Ground Render ─────────────────────────────────────────

(shader-module :name groundRenderShader :file "./lib/mc_ground_render.wgsl" :imports [mcMvp])

; ── Shader: Camera (time orbit) ───────────────────────────────────

(wgsl :name perspective :file "./lib/perspective.wgsl")

(wgsl :name inverseCamera :file "./lib/inverse_camera.wgsl")

(shader-module :name cameraShader :imports [mcInputs mcMvp perspective inverseCamera] :code """
@group(0) @binding(0) var<uniform> pngine: PngineInputs;
@group(0) @binding(1) var<storage, read_write> mvp: MVPData;

const PI: f32 = 3.14159265;

// Stateless slow orbit — replaces the donor's arcball (write_pointer_uniform
// was its only native stub; time is fully deterministic for parity).
@compute @workgroup_size(1)
fn updateCamera() {
  let t = pngine.time;
  let ang = t * 0.15;
  let eye = vec3f(sin(ang) * 40.0, 12.0 + 4.0 * sin(t * 0.07), cos(ang) * 40.0);
  let back = normalize(eye);
  let worldUp = vec3f(0.0, 1.0, 0.0);
  let right = normalize(cross(worldUp, back));
  let up = normalize(cross(back, right));
  let viewMatrix = inverseCamera(right, up, back, eye);
  let proj = perspective(PI / 3.0, pngine.aspect, 0.1, 200.0);
  mvp.matrix = proj * viewMatrix;
  mvp.camPos = vec4f(eye, 1.0);
}
""")

; ── Shader: Density ───────────────────────────────────────────────

(shader-module :name densityShader :file "./lib/mc_density.wgsl" :imports [mcInputs fieldInstance])

; ── Shader: Vertex Generation ─────────────────────────────────────

(shader-module :name vertexGenShader :file "./lib/mc_vertex_gen.wgsl"
  :imports [mcInputs mcGrid mcNormal fieldInstance])

; ── Shader: Mesh Render ───────────────────────────────────────────

(shader-module :name meshRenderShader :file "./lib/mc_mesh_render.wgsl" :imports [mcMvp palette])

; ── Compute Pipelines ──────────────────────────────────────────────────

(compute-pipeline :name densityPipeline :layout auto (compute :module densityShader :entry main))

(compute-pipeline :name cameraPipeline :layout auto (compute :module cameraShader :entry updateCamera))

(compute-pipeline :name clearPipeline :layout auto (compute :module clearShader :entry main))

(compute-pipeline :name vertexGenPipeline :layout auto (compute :module vertexGenShader :entry main))

(compute-pipeline :name indexGenPipeline :layout auto (compute :module indexGenShader :entry main))

(compute-pipeline :name indirectArgsPipeline :layout auto (compute :module indirectArgsShader :entry main))


; ── Render Pipelines ───────────────────────────────────────────────────

(render-pipeline :name groundRenderPipeline
  :layout auto
  (vertex :module groundRenderShader :entry vs
    (vertex-buffer :array-stride 24
      (attribute :shader-location 0 :offset 0 :format float32x3)
      (attribute :shader-location 1 :offset 12 :format float32x3)))
  (fragment :module groundRenderShader :entry fs
    (color-target :format preferred-canvas-format))
  (primitive :topology triangle-list)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

(render-pipeline :name meshRenderPipeline
  :layout auto
  (vertex :module meshRenderShader :entry vs
    (vertex-buffer :array-stride 32
      (attribute :shader-location 0 :offset 0 :format float32x4)
      (attribute :shader-location 1 :offset 16 :format float32x4)))
  (fragment :module meshRenderShader :entry fs
    (color-target :format preferred-canvas-format))
  (primitive :topology triangle-list :cull-mode back)
  (depth-stencil :format depth24plus :depth-write-enabled true :depth-compare less))

; ── Bind Groups ────────────────────────────────────────────────────────

(bind-group :name meshRenderBG :layout meshRenderPipeline :group 0
  (entry :binding 0 :buffer mvpBuffer))

(bind-group :name groundRenderBG :layout groundRenderPipeline :group 0
  (entry :binding 0 :buffer mvpBuffer))

(bind-group :name vertexGenBG :layout vertexGenPipeline :group 0
  (entry :binding 0 :buffer densityBuffer)
  (entry :binding 1 :buffer vertexBuffer)
  (entry :binding 2 :buffer vertexIdMap)
  (entry :binding 3 :buffer atomicCounters)
  (entry :binding 4 :buffer timeUniforms))

(bind-group :name densityBG :layout densityPipeline :group 0
  (entry :binding 0 :buffer timeUniforms)
  (entry :binding 1 :buffer densityBuffer))

(bind-group :name indirectArgsBG :layout indirectArgsPipeline :group 0
  (entry :binding 0 :buffer atomicCounters)
  (entry :binding 1 :buffer indirectDrawBuffer))

(bind-group :name indexGenBG :layout indexGenPipeline :group 0
  (entry :binding 0 :buffer densityBuffer)
  (entry :binding 1 :buffer vertexIdMap)
  (entry :binding 2 :buffer indexBuffer)
  (entry :binding 3 :buffer atomicCounters))

(bind-group :name cameraBG :layout cameraPipeline :group 0
  (entry :binding 0 :buffer timeUniforms)
  (entry :binding 1 :buffer mvpBuffer))

(bind-group :name clearBG :layout clearPipeline :group 0
  (entry :binding 0 :buffer atomicCounters)
  (entry :binding 1 :buffer indirectDrawBuffer)
  (entry :binding 2 :buffer vertexIdMap))

; ── Compute Passes ─────────────────────────────────────────────────────

(compute-pass :name cameraPass :pipeline cameraPipeline :bind-groups [cameraBG]
  (dispatch :workgroups [1 1 1]))

(compute-pass :name clearPass :pipeline clearPipeline :bind-groups [clearBG]
  (dispatch :workgroups [384 1 1]))

(compute-pass :name densityPass :pipeline densityPipeline :bind-groups [densityBG]
  (dispatch :workgroups [141 1 1]))

(compute-pass :name vertexPass :pipeline vertexGenPipeline :bind-groups [vertexGenBG]
  (dispatch :workgroups [128 1 1]))

(compute-pass :name indexPass :pipeline indexGenPipeline :bind-groups [indexGenBG]
  (dispatch :workgroups [128 1 1]))

(compute-pass :name indirectArgsPass :pipeline indirectArgsPipeline :bind-groups [indirectArgsBG]
  (dispatch :workgroups [1 1 1]))

; ── Render Passes ──────────────────────────────────────────────────────

(render-pass :name renderMeshPass
  (color-attachment :view context-current-texture
    :clear-value [0.18 0.18 0.22 1.0] :load-op clear :store-op store)
  (depth-stencil-attachment :view depthTexture
    :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  :pipeline meshRenderPipeline
  :vertex-buffers [vertexBuffer]
  :index-buffer indexBuffer
  :bind-groups [meshRenderBG]
  (draw-indexed-indirect :buffer indirectDrawBuffer :offset 0))

(render-pass :name renderGroundPass
  (color-attachment :view context-current-texture :load-op load :store-op store)
  (depth-stencil-attachment :view depthTexture :depth-load-op load :depth-store-op store)
  :pipeline groundRenderPipeline
  :vertex-buffers [groundVB]
  :bind-groups [groundRenderBG]
  (draw :vertex-count 6))

; ── Frame ──────────────────────────────────────────────────────────────

(frame :name main
  :perform [writeTime
            clearPass
            densityPass
            vertexPass
            indexPass
            indirectArgsPass
            cameraPass
            renderMeshPass
            renderGroundPass])
