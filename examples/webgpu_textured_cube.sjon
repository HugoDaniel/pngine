; webgpu_textured_cube — port of the webgpu-samples `texturedCube` sample: the
; `cube` shape generator (position4+color4+uv2, 36 vertices) drawn through a
; textured pipeline (sampler + sampled texture) with depth testing and
; backface culling. The image `assets/Di-3d.png` is read at compile time,
; embedded in the payload, decoded into an `(image-bitmap …)` and uploaded
; with `(copy-external-image-to-texture …)`; the texture is sized from that
; bitmap (`:size <image-bitmap>`).
;
; Notes:
;  - The FOV is spelled out in the WGSL as `(2 * PI) / 5`: a `(define …)`
;    feeds numeric slots and never rewrites shader text. PI, TAU and E are the
;    only names substituted into WGSL.
;  - `:clear-value [128 128 128 255]` clears to opaque white, not mid-grey:
;    clear channels are floats in 0..1 and every component >= 1 saturates.
;  - Vertex strides and offsets are literals (40 / 0 / 16 / 32) for
;    legibility; a byte-count slot takes a bare define name or an expression
;    just as well.

(shader-module :name code :code """
    struct PngineInputs {
      time: f32,
      width: f32,
      height: f32,
      aspect: f32,
    }
    @group(0) @binding(0) var<uniform> pngine: PngineInputs;
    @group(0) @binding(1) var mySampler: sampler;
    @group(0) @binding(2) var myTexture: texture_2d<f32>;

    struct VertexOutput {
      @builtin(position) Position: vec4f,
      @location(0) fragUV: vec2f,
      @location(1) fragPosition: vec4f,
    }

    fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4x4f {
      let f = 1.0 / tan(fovy * 0.5);
      let nf = 1.0 / (near - far);
      return mat4x4f(
        vec4f(f / aspect, 0, 0, 0),
        vec4f(0, f, 0, 0),
        vec4f(0, 0, (far + near) * nf, -1),
        vec4f(0, 0, 2 * far * near * nf, 0),
      );
    }

    @vertex
    fn vs(
      @location(0) position: vec4f,
      @location(1) color: vec4f,
      @location(2) uv: vec2f
    ) -> VertexOutput {
      let now = pngine.time;
      let proj = perspective((2 * PI) / 5, pngine.aspect, 1.0, 100.0);

      // View: translate z=-4
      let view = mat4x4f(
        vec4f(1, 0, 0, 0), vec4f(0, 1, 0, 0),
        vec4f(0, 0, 1, 0), vec4f(0, 0, -4, 1));

      // Rotation around (sin(t), cos(t), 0) axis by 1 radian
      let axis = normalize(vec3f(sin(now), cos(now), 0));
      let c = cos(1.0); let s = sin(1.0); let t2 = 1.0 - c;
      let x = axis.x; let y = axis.y; let z = axis.z;
      let rot = mat4x4f(
        vec4f(t2*x*x+c, t2*x*y-s*z, t2*x*z+s*y, 0),
        vec4f(t2*x*y+s*z, t2*y*y+c, t2*y*z-s*x, 0),
        vec4f(t2*x*z-s*y, t2*y*z+s*x, t2*z*z+c, 0),
        vec4f(0, 0, 0, 1));

      let mvp = proj * view * rot;

      var out: VertexOutput;
      out.Position = mvp * position;
      out.fragUV = uv;
      out.fragPosition = 0.5 * (position + vec4f(1));
      return out;
    }

    @fragment
    fn fs(
      @location(0) fragUV: vec2f,
      @location(1) fragPosition: vec4f
    ) -> @location(0) vec4f {
      return textureSample(myTexture, mySampler, fragUV) * fragPosition;
    }
""")

(data :name cubeVertexArray (cube :format [position4 color4 uv2]))

(buffer :name verticesBuffer :usage [vertex]
  :data cubeVertexArray)

(buffer :name uniforms :size 16 :usage [uniform copy-dst])

; Image blob (read from disk) + its decoded bitmap. The bitmap's size feeds
; the cube texture (:size naming an image-bitmap) and a queue action uploads it.
(data :name cubeImageData :file "assets/Di-3d.png" :mime "image/png")
(image-bitmap :name cubeImage :data cubeImageData)

(texture :name cubeTexture :size cubeImage :format rgba8unorm
  :usage [texture-binding copy-dst render-attachment])

(sampler :name linearSampler :mag-filter linear :min-filter linear)

(texture :name depthTexture :size canvas :format depth24plus :usage [render-attachment])

(render-pipeline :name pipeline
  :layout auto
  (vertex :module code :entry vs
    (vertex-buffer :array-stride 40
      (attribute :shader-location 0 :offset 0 :format float32x4)
      (attribute :shader-location 1 :offset 16 :format float32x4)
      (attribute :shader-location 2 :offset 32 :format float32x2)))
  (fragment :module code :entry fs
    (target :format preferred-canvas-format))
  (primitive :topology triangle-list :cull-mode back)
  (depth-stencil :depth-write-enabled true :depth-compare less :format depth24plus))

(bind-group :name mainBindGroup :layout pipeline :group 0
  (entry :binding 0 :buffer uniforms)
  (entry :binding 1 :sampler linearSampler)
  (entry :binding 2 :texture cubeTexture))

(queue :name writeUniforms
  (write-buffer :buffer uniforms :offset 0 :data pngine-inputs))

(queue :name copyTexture
  (copy-external-image-to-texture (source :image cubeImage) (destination :texture cubeTexture)))

(render-pass :name drawCube
  (color-attachment :view context-current-texture :clear-value [128 128 128 255] :load-op clear :store-op store)
  (depth-stencil-attachment :view depthTexture :depth-clear-value 1.0 :depth-load-op clear :depth-store-op store)
  :pipeline pipeline
  :vertex-buffers [verticesBuffer]
  :bind-groups [mainBindGroup]
  (draw :vertex-count 36))

(frame :name main :perform [copyTexture writeUniforms drawCube])
