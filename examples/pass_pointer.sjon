; `(pass …)` pointer demo — a glow follows the pointer and pulses while a
; button is held. A single fragment pass that references both `pngine` and
; `pointer`, so the sugar emits a uniform buffer (binding 0) and a pointer
; buffer (binding 1) and a prelude declaring both structs.

(pass-graph
  (pass :name main :code """
    @fragment fn fs(@builtin(position) pos: vec4f) -> @location(0) vec4f {
      let uv = pos.xy / vec2f(pngine.width, pngine.height);
      let p = vec2f(pointer.x, pointer.y);
      let dist = length(uv - p);
      let glow = .015 / (dist + .001);
      let click = step(0., pointer.clickX);
      let pulse = 1. + click * .5 * sin(pngine.time * 12.);
      var col = vec3f(.2, .6, 1.) * glow * pulse;
      col += vec3f(1., .3, .1) * smoothstep(.03, 0., abs(dist - .1 * click));
      return vec4f(col, 1);
    }
  """))
