; Mip-chain canvas fixture, hand-written — plan 08 slice 3's pixel evidence.
;
; The core twin of examples/mip_chain_view.sjon: every form those two sugar
; declarations lower to is written out here instead, then the SAME
; level-0 upload, viewer resources, canvas pass and frame order are attached.
; This file imports no sugar tier and contains no sugar form — `zig build
; test-core` proves it compiles with an empty lowering registry, and the render
; corpus holds it pixel-identical to the sugar document.
;
; Both textures upload their own level-0 checker; levels 1 through 3 are the
; complete per-level views, sampler, shader, pipelines, bind groups and passes
; below. The presenter samples mip level 0..3 in the four cells of each panel:
; mipTex left, npotTex right, with nearest filtering so the 100×100 NPOT level
; 0 maps deterministically into the same cell width.
;
; Expected RGBA after the backend's BGRA-to-RGBA readback swizzle:
;   A = [32 96 160 255], B = [96 160 32 255], mean = [64 128 96 255].

(data :name potLevel0 (bytes :base64 ""))
(data :name npotLevel0 (bytes :base64 ""))

; ---- source textures -------------------------------------------------------

(texture :name mipTex :size [64 64] :format rgba8unorm
  :mip-level-count 4
  :usage [texture-binding render-attachment copy-dst])

(texture :name npotTex :size [100 100] :format rgba8unorm
  :mip-level-count 4
  :usage [texture-binding render-attachment copy-dst])

; ---- fillMips: 64×64, levels 1..3 ------------------------------------------

(texture-view :name fillMips__src1 :texture mipTex :dimension 2d
  :base-mip-level 0 :mip-level-count 1)
(texture-view :name fillMips__dst1 :texture mipTex :dimension 2d
  :base-mip-level 1 :mip-level-count 1)
(texture-view :name fillMips__src2 :texture mipTex :dimension 2d
  :base-mip-level 1 :mip-level-count 1)
(texture-view :name fillMips__dst2 :texture mipTex :dimension 2d
  :base-mip-level 2 :mip-level-count 1)
(texture-view :name fillMips__src3 :texture mipTex :dimension 2d
  :base-mip-level 2 :mip-level-count 1)
(texture-view :name fillMips__dst3 :texture mipTex :dimension 2d
  :base-mip-level 3 :mip-level-count 1)

(sampler :name fillMips__sampler :mag-filter linear :min-filter linear)

(shader-module :name fillMips__shader :code """struct VSOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f }
@vertex fn vs(@builtin(vertex_index) i: u32) -> VSOut {
  var o: VSOut;
  let x = f32(i & 1u) * 4.0 - 1.0;
  let y = f32((i >> 1u) & 1u) * 4.0 - 1.0;
  o.pos = vec4f(x, y, 0, 1);
  o.uv = vec2f(x * .5 + .5, .5 - y * .5);
  return o;
}
@group(0) @binding(0) var tex: texture_2d<f32>;
@group(0) @binding(1) var smp: sampler;
@fragment fn fs(in: VSOut) -> @location(0) vec4f {
  return textureSample(tex, smp, in.uv);
}""")

(render-pipeline :name fillMips__pipe :layout auto
  (vertex :module fillMips__shader :entry vs)
  (fragment :module fillMips__shader :entry fs
    (color-target :format rgba8unorm)))

(bind-group :name fillMips__bg1 :layout fillMips__pipe :group 0
  (entry :binding 0 :texture-view fillMips__src1)
  (entry :binding 1 :sampler fillMips__sampler))
(bind-group :name fillMips__bg2 :layout fillMips__pipe :group 0
  (entry :binding 0 :texture-view fillMips__src2)
  (entry :binding 1 :sampler fillMips__sampler))
(bind-group :name fillMips__bg3 :layout fillMips__pipe :group 0
  (entry :binding 0 :texture-view fillMips__src3)
  (entry :binding 1 :sampler fillMips__sampler))

(render-pass :name fillMips__pass1 :pipeline fillMips__pipe
  :bind-groups [fillMips__bg1]
  (color-attachment :view fillMips__dst1
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name fillMips__pass2 :pipeline fillMips__pipe
  :bind-groups [fillMips__bg2]
  (color-attachment :view fillMips__dst2
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name fillMips__pass3 :pipeline fillMips__pipe
  :bind-groups [fillMips__bg3]
  (color-attachment :view fillMips__dst3
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(step-group :name fillMips
  :perform [fillMips__pass1 fillMips__pass2 fillMips__pass3])

; ---- fillMipsNpot: 100×100, levels 1..3 -----------------------------------

(texture-view :name fillMipsNpot__src1 :texture npotTex :dimension 2d
  :base-mip-level 0 :mip-level-count 1)
(texture-view :name fillMipsNpot__dst1 :texture npotTex :dimension 2d
  :base-mip-level 1 :mip-level-count 1)
(texture-view :name fillMipsNpot__src2 :texture npotTex :dimension 2d
  :base-mip-level 1 :mip-level-count 1)
(texture-view :name fillMipsNpot__dst2 :texture npotTex :dimension 2d
  :base-mip-level 2 :mip-level-count 1)
(texture-view :name fillMipsNpot__src3 :texture npotTex :dimension 2d
  :base-mip-level 2 :mip-level-count 1)
(texture-view :name fillMipsNpot__dst3 :texture npotTex :dimension 2d
  :base-mip-level 3 :mip-level-count 1)

(sampler :name fillMipsNpot__sampler :mag-filter linear :min-filter linear)

(shader-module :name fillMipsNpot__shader :code """struct VSOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f }
@vertex fn vs(@builtin(vertex_index) i: u32) -> VSOut {
  var o: VSOut;
  let x = f32(i & 1u) * 4.0 - 1.0;
  let y = f32((i >> 1u) & 1u) * 4.0 - 1.0;
  o.pos = vec4f(x, y, 0, 1);
  o.uv = vec2f(x * .5 + .5, .5 - y * .5);
  return o;
}
@group(0) @binding(0) var tex: texture_2d<f32>;
@group(0) @binding(1) var smp: sampler;
@fragment fn fs(in: VSOut) -> @location(0) vec4f {
  return textureSample(tex, smp, in.uv);
}""")

(render-pipeline :name fillMipsNpot__pipe :layout auto
  (vertex :module fillMipsNpot__shader :entry vs)
  (fragment :module fillMipsNpot__shader :entry fs
    (color-target :format rgba8unorm)))

(bind-group :name fillMipsNpot__bg1 :layout fillMipsNpot__pipe :group 0
  (entry :binding 0 :texture-view fillMipsNpot__src1)
  (entry :binding 1 :sampler fillMipsNpot__sampler))
(bind-group :name fillMipsNpot__bg2 :layout fillMipsNpot__pipe :group 0
  (entry :binding 0 :texture-view fillMipsNpot__src2)
  (entry :binding 1 :sampler fillMipsNpot__sampler))
(bind-group :name fillMipsNpot__bg3 :layout fillMipsNpot__pipe :group 0
  (entry :binding 0 :texture-view fillMipsNpot__src3)
  (entry :binding 1 :sampler fillMipsNpot__sampler))

(render-pass :name fillMipsNpot__pass1 :pipeline fillMipsNpot__pipe
  :bind-groups [fillMipsNpot__bg1]
  (color-attachment :view fillMipsNpot__dst1
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name fillMipsNpot__pass2 :pipeline fillMipsNpot__pipe
  :bind-groups [fillMipsNpot__bg2]
  (color-attachment :view fillMipsNpot__dst2
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))
(render-pass :name fillMipsNpot__pass3 :pipeline fillMipsNpot__pipe
  :bind-groups [fillMipsNpot__bg3]
  (color-attachment :view fillMipsNpot__dst3
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(step-group :name fillMipsNpot
  :perform [fillMipsNpot__pass1 fillMipsNpot__pass2 fillMipsNpot__pass3])

; ---- presenter: both chains, four level cells each -------------------------

(texture-view :name presentPot :texture mipTex :dimension 2d
  :base-mip-level 0 :mip-level-count 4)
(texture-view :name presentNpot :texture npotTex :dimension 2d
  :base-mip-level 0 :mip-level-count 4)

(sampler :name presentSampler :mag-filter nearest :min-filter nearest)

(shader-module :name presentShader :code """struct VSOut { @builtin(position) pos: vec4f, @location(0) uv: vec2f }
@vertex fn vs(@builtin(vertex_index) i: u32) -> VSOut {
  var o: VSOut;
  let x = f32(i & 1u) * 4.0 - 1.0;
  let y = f32((i >> 1u) & 1u) * 4.0 - 1.0;
  o.pos = vec4f(x, y, 0, 1);
  o.uv = vec2f(x * .5 + .5, .5 - y * .5);
  return o;
}
@group(0) @binding(0) var potTex: texture_2d<f32>;
@group(0) @binding(1) var npotTex: texture_2d<f32>;
@group(0) @binding(2) var smp: sampler;

@fragment fn fs(in: VSOut) -> @location(0) vec4f {
  let right = in.uv.x >= 0.5;
  let panel = vec2f(fract(in.uv.x * 2.0), in.uv.y);
  let cell = floor(panel * 2.0);
  let level = u32(cell.x) + u32(cell.y) * 2u;
  let local = fract(panel * 2.0);
  if (right) {
    return textureSampleLevel(npotTex, smp, local, f32(level));
  }
  return textureSampleLevel(potTex, smp, local, f32(level));
}""")

(render-pipeline :name presentPipe :layout auto
  (vertex :module presentShader :entry vs)
  (fragment :module presentShader :entry fs
    (color-target :format preferred-canvas-format)))

(bind-group :name presentBg :layout presentPipe :group 0
  (entry :binding 0 :texture-view presentPot)
  (entry :binding 1 :texture-view presentNpot)
  (entry :binding 2 :sampler presentSampler))

; ---- level 0: the only explicit writes --------------------------------------

(queue :name upload
  (write-texture :texture mipTex :data potLevel0 :mip-level 0
    :bytes-per-row 256 :rows-per-image 64 :size [64 64])
  (write-texture :texture npotTex :data npotLevel0 :mip-level 0
    :bytes-per-row 400 :rows-per-image 100 :size [100 100]))

(render-pass :name present :pipeline presentPipe
  :bind-groups [presentBg]
  (color-attachment :view context-current-texture
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

; ---- the frame: fill both chains, then present them ------------------------

(frame :name main :perform [upload fillMips fillMipsNpot present])
