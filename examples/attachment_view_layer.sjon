; Attachment view — colour — selects one array layer.
;
; `attachTex` is a 2-layer 2d texture. The 2d-array view names layer 1 only
; (`:base-array-layer 1 :array-layer-count 1`); a 2d-array view that omitted
; the count would default to every remaining layer and be refused as an
; attachment (one layer per pass), which is the invitation to write these two
; keys. The selected view, not the base texture, is what the pass writes.

(shader-module :name code :code """
    @vertex
    fn vs(@builtin(vertex_index) i : u32) -> @builtin(position) vec4f {
      var p = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));
      return vec4f(p[i], 0.0, 1.0);
    }

    @fragment
    fn fs() -> @location(0) vec4f { return vec4f(0.0, 0.5, 1.0, 1.0); }
""")

(texture :name attachTex :size [4 4 2] :format rgba8unorm :usage [render-attachment])
(texture-view :name layerView :texture attachTex :dimension 2d-array
  :base-array-layer 1 :array-layer-count 1)

(render-pipeline :name pipe :layout auto
  (vertex :module code :entry vs)
  (fragment :module code :entry fs
    (color-target :format rgba8unorm)))

(render-pass :name draw :pipeline pipe
  (color-attachment :view layerView
    :clear-value [0 0 0 1] :load-op clear :store-op store)
  (draw :vertex-count 3))

(frame :name main :perform [draw])
