; PNGine WebGPU schema.
;
; Single source of truth for what a PNGine `.sjon` document may contain. The
; compiler (`src/dsl_sjon/Compiler.zig`) preloads this manifest once
; (`sjon.preloadSchema`) and hands it to every `Host.validateDocument`, so
; the user document parses at offset 0 and the data forms below are validated
; against this plugin with no filesystem (works on wasm32-freestanding). It is
; `@embedFile`'d via the `pngine_schema` build import and feeds the web editor's
; TS / JSON-Schema export.
;
; It grew in phases (the core forms first, then shapes, textures, depth/stencil
; and indexed draws, then samplers, imageBitmap, MRT/blend/MSAA, queries, copies
; and `(pass …)`); every one of those is here now, and 3.0.0 re-shaped the
; whole file against the WebGPU IDL.
;
; ---- Defaults policy — three DISTINCT notions, never conflated ----
;   1. Schema `:default V` is a PNGine OPINION. On key absence SJON materializes V
;      into the effective view (→ HostResult.materialized_defaults), so the emitter
;      always bakes a concrete value into the bytecode. Use it where PNGine commits
;      to a value even when WebGPU has none. Note this is NOT a licence to default
;      a REQUIRED member: `load-op` used to be the example here, and it was the
;      wrong one — WebGPU requires loadOp precisely so the author states it, and
;      3.0.0 made it required here too.
;   2. A key with NO `:default`, left absent, defers to WebGPU's OWN spec default at
;      runtime — the emitter writes nothing and PNGine invents nothing.
;   3. js_codegen's omit-when-default (`--html`) is a SIZE ENCODING, not a semantic
;      source: it may drop a descriptor field ONLY when the emitted value equals
;      WebGPU's spec default (e.g. a buffer-binding offset 0 / size = rest-of-buffer),
;      leaning on WebGPU to refill it identically. A materialized OPINION that differs
;      from the WebGPU default (a pass-lowered sampler's `linear` filters, or an
;      authored `:default` on a key whose IDL default is something else) is
;      NEVER omitted. (loadOp/storeOp/clearValue used to be the example: they
;      are required / default-less since 3.0.0.)
(plugin :name pngine :version "0.1.0"

  ; ---- numeric refinements ----
  ; `:unit (unit-shape :reject true)` closes the silent `1.0f → 0` defect: SJON
  ; lexes a trailing letter as a unit suffix (`number_with_unit`), which a plain
  ; `:underlying number` slot would accept and the reader would drop to 0. Reject
  ; makes it a validation error (`unit_not_allowed`) with a span on the literal.
  ; `:repr (repr-shape :type u32)` tags these as GPU u32: the validator rejects an
  ; out-of-range / non-integer LITERAL (`repr_out_of_range`) before the emitter
  ; silently wraps it, and SJON's exporter emits the branded `U32` TS alias so the
  ; editor gets real per-field GPU types. Repr checks literals only — expressions
  ; (`:size (* NUM 4 4)`) and define-refs are evaluated later, untouched here.
  ;
  ; ---- the `x` / `x-value` pair ----
  ; Every numeric kind here comes in two: `x-value` carries the bounds and the
  ; repr, and `x` is `(scalar-or-ref-shape :base x-value :ref define-ref)` — a
  ; literal, a bounded expression, or a bare `(define …)` name. KEYS NAME `x`.
  ; The pair is `count` / `count-value`'s, applied to the rest: a number slot
  ; is "literal | expression | checked reference" everywhere, because an author
  ; who can write `:vertex-count NUM_PARTICLES` and not `:size NUM_PARTICLES`
  ; is looking at an accident, not a rule.
  ;
  ; This could not be written until SJON's union reporting changed. A `scalar-or-ref`
  ; desugars to a union, and a union that matched nothing used to report only
  ; its ALTERNATIVE NAMES — so adding the reference arm would have retired every
  ; bound below it: `:max-anisotropy 32` would have said "no alternative
  ; matched: anisotropy-value | define-ref" where it used to name 1..16. SJON
  ; reports the arm the value's SHAPE selected, so the bounds still speak. The
  ; three inline tests in Compiler.zig are the ratchet.
  ;
  ; Two numeric slots have no `define-ref` arm, and neither is an oversight:
  ; `write-mask` (its symbol arm is the closed member set `all`) and a
  ; `(wasm-call :args […])` element (`wasm-arg`, whose symbol arm is the
  ; builtin set `canvas-width` …). A third alternative would put a bare name
  ; within reach of TWO arms, and SJON's rule declines to guess between them —
  ; the slot would lose the report it just gained. A constant is written
  ; `(* MASK 1)` / `(* SCALE 1)` there.
  (value-kind :name byte-count-value
    :description "Non-negative integer byte size / offset / stride."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name byte-count
    :description "Byte size / offset / stride: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base byte-count-value :ref define-ref))
  ; WebGPU's alignment rules on byte offsets and sizes, as `:multiple-of`
  ; bounds (SJON 1.2.0). Like every numeric-bounds, these judge a LITERAL; an
  ; expression (`:offset (* N 4)`) is evaluated by the emitter, untouched here.
  (value-kind :name byte-count-4-aligned-value
    :description "Byte offset / size that WebGPU requires to be a multiple of 4."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true :multiple-of 4)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name byte-count-4-aligned
    :description "A 4-aligned byte offset / size: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base byte-count-4-aligned-value :ref define-ref))
  (value-kind :name byte-count-256-aligned-value
    :description "Byte offset that WebGPU requires to be a multiple of 256."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true :multiple-of 256)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name byte-count-256-aligned
    :description "A 256-aligned byte offset: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base byte-count-256-aligned-value :ref define-ref))
  (value-kind :name pool-size-value
    :description "Ping-pong pool size (1..255). The ceiling is the wire's: the
                 pool index is a byte everywhere it is encoded, so a larger pool
                 cannot be addressed. Bounds a LITERAL; the emitter re-checks the
                 expression spelling (`:pool (* 100 3)`), which repr cannot see."
    :underlying number
    :numeric (numeric-bounds :min 1 :max 255 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name pool-size
    :description "Ping-pong pool size: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base pool-size-value :ref define-ref))
  (value-kind :name binding-index-value
    :description "Non-negative binding / group / pool index. The PNGB wire stores these as u8, so 255 is the ceiling (WebGPU's own maxBindingsPerBindGroup default is 1000, but PNGine's uniform table and descriptor encoding are byte-indexed)."
    :underlying number
    :numeric (numeric-bounds :min 0 :max 255 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name binding-index
    :description "Binding / group / pool index: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base binding-index-value :ref define-ref))
  (value-kind :name count-value
    :description "Non-negative integer draw / dispatch count (literals + expressions)."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  ; A count may also be a bare `(define …)` reference, e.g.
  ; `:instance-count NUM_PARTICLES`. The reference half is a cross-ref to the
  ; define form (SJON 1.2.0 `scalar-or-ref-shape :ref`), so a misspelt constant is
  ; a located `union_no_branch_matched` at validation — it used to be an
  ; unlocated "emit failed" from the emitter's env lookup. The emitter still
  ; resolves the symbol through its expr env; the schema only guarantees the
  ; name exists.
  (value-kind :name define-ref
    :description "Reference to a declared (define :name …) constant."
    :underlying symbol
    :cross-ref (cross-ref :target define))
  ; The unbounded real: the element kind of every numeric vector (clear
  ; colors, blend constants, float lists) and, since 3.0.0, the
  ; `(define …)` value. No bounds to keep, but the unit reject stays — `:base
  ; number` (the primitive shortcut) took `1f` and the reader used its
  ; magnitude, one reading of the `1.0f` defect the scalar slots close.
  ;
  ; On `(define :value …)` the rule holds in full: a constant is a real, negative
  ; and fractional allowed, and the SLOT that reads it decides integrality and
  ; range at use — `0.5` is `:vertex-count`'s located reject and legal in
  ; `:clear-value`. The reference arm lets a constant name another constant,
  ; declared before or after it; the emitter resolves the set document-wide
  ; and refuses a cycle with a span.
  (value-kind :name real-value
    :description "An unbounded real literal: negative and fractional allowed; a unit suffix is rejected."
    :underlying number
    :unit (unit-shape :reject true))
  (value-kind :name real
    :description "An unbounded real: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base real-value :ref define-ref))
  (value-kind :name count
    :description "Draw / dispatch count: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base count-value :ref define-ref))
  ; ---- the domain names ----
  ; `count` names a draw / dispatch count and `byte-count` names bytes; a slot
  ; that is neither — a sample count, a query index or count, a stencil
  ; reference or clear value, a pixel rect, a texel origin, a pool offset — is
  ; the general `u32`, and a bitmask is `mask32` (hex literals read as the
  ; number they spell: `0xFF` is 255, `pngine inspect` shows the decimal). Same
  ; bounds and repr as `count`; the name says the domain, and the exported
  ; `.d.ts` alias follows it.
  (value-kind :name u32-value
    :description "Non-negative integer that rides the wire as u32."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name u32
    :description "A non-negative integer: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base u32-value :ref define-ref))
  (value-kind :name query-count-value
    :description "Number of queries in a (query-set …): an integer in [1, 4096] (GPUQuerySetDescriptor.count's createQuerySet bound)."
    :underlying number
    :numeric (numeric-bounds :min 1 :max 4096 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name query-count
    :description "Query-set size: a literal, a bounded expression, or a bare (define …) reference, at most 4096."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base query-count-value :ref define-ref))
  (value-kind :name mask32-value
    :description "32-bit bitmask (0..0xFFFFFFFF); a hex literal reads as the number it spells."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name mask32
    :description "A 32-bit bitmask: a literal (hex welcome), a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base mask32-value :ref define-ref))
  ; A WebGPU device-limit value. Non-negative integer, u32-range in the schema
  ; (the PNGB wire carries u64 for forward-compat). Passed VERBATIM to
  ; requiredLimits at device creation — an unsatisfiable request fails loud there
  ; (the promise rejects / native exits nonzero), never silently clamps.
  (value-kind :name device-limit-value
    :description "A WebGPU device limit value: a non-negative integer (u32-range; the wire is u64)."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name device-limit
    :description "A WebGPU device limit: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base device-limit-value :ref define-ref))
  (value-kind :name unorm-value
    :description "A float in [0,1] (the depth clear value)."
    :underlying number
    :numeric (numeric-bounds :min 0 :max 1)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name unorm
    :description "A float in [0,1] (the depth clear value): a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base unorm-value :ref define-ref))
  ; WebGPU's three bias terms are two different types, and conflating them cost
  ; this schema a value: `GPUDepthBiasValue` is a `long` (signed 32-bit) while
  ; `depthBiasSlopeScale` / `depthBiasClamp` are floats. One `f32`-repr kind for
  ; all three let `:depth-bias -1` through the schema and into a u32 read, which
  ; dropped it silently (webgpu_wireframe's wireframe pass layered over the solid
  ; one by exactly that -1, and shipped without it).
  (value-kind :name depth-bias-int-value
    :description "Constant depth bias: a signed integer (GPUDepthBiasValue is a long)."
    :underlying number
    :numeric (numeric-bounds :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type i32))
  (value-kind :name depth-bias-int
    :description "Constant depth bias: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base depth-bias-int-value :ref define-ref))
  (value-kind :name depth-bias-value
    :description "Depth bias slope-scale / clamp: a real."
    :underlying number
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name depth-bias
    :description "Depth bias slope-scale / clamp: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base depth-bias-value :ref define-ref))
  (value-kind :name lod-clamp-value
    :description "Sampler mip level-of-detail clamp (non-negative real; WebGPU defaults lodMinClamp 0, lodMaxClamp 32)."
    :underlying number
    :numeric (numeric-bounds :min 0)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name lod-clamp
    :description "Sampler LOD clamp: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base lod-clamp-value :ref define-ref))
  (value-kind :name anisotropy-value
    :description "Sampler max anisotropy (integer in [1,16]; values > 1 require linear mag/min/mipmap filters)."
    :underlying number
    :numeric (numeric-bounds :min 1 :max 16 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name anisotropy
    :description "Sampler max anisotropy: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base anisotropy-value :ref define-ref))
  ; Digit-leading spellings (`1d`, `2d-array`) lex as unit-bearing numbers; SJON
  ; 1.2.0 lets a symbol member-set declare them and matches on the parsed
  ; (magnitude, unit) pair, so the value reaches the emitter as a
  ; `number_with_unit` node, not a symbol — read it with `Reader.memberSpelling`
  ; and map through `values.textureDimensionCode` / `viewDimensionCode`
  ; (`Emitter.dimensionCode`), never `Reader.symbol` (which returns null on it).
  (value-kind :name texture-dimension
    :description "GPUTextureDimension, spelled as the WebGPU spec spells it: 1d, 2d (default), 3d."
    :underlying symbol
    :members (member-set
      (member :name 1d :description "One-dimensional texture.")
      (member :name 2d :description "Two-dimensional texture (the default); with a third :size element > 1 it is a 2d array.")
      (member :name 3d :description "Three-dimensional (volume) texture; the third :size element is its slice count.")))
  (value-kind :name subresource-count-value
    :description "Positive integer texture subresource count (≥ 1) — mip levels or array/3d layers. Absent: a texture allocates 1; a texture view exposes every level/layer from its base."
    :underlying number
    :numeric (numeric-bounds :min 1 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name subresource-count
    :description "Texture subresource count: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base subresource-count-value :ref define-ref))
  (value-kind :name subresource-index-value
    :description "Zero-based texture subresource index (≥ 0) — a texture view's base mip level or base array layer. Defaults to 0. (subresource-count is ≥ 1; a base index is ≥ 0.)"
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name subresource-index
    :description "Texture subresource index: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base subresource-index-value :ref define-ref))
  (value-kind :name view-dimension
    :description "GPUTextureViewDimension, spelled as the WebGPU spec spells it: 1d, 2d, 2d-array, cube, cube-array, 3d."
    :underlying symbol
    :members (member-set
      (member :name 1d :description "One-dimensional view (texture_1d).")
      (member :name 2d :description "Two-dimensional view (texture_2d) — the default.")
      (member :name 2d-array :description "Array of 2d layers (texture_2d_array).")
      (member :name cube :description "Cube map — six 2d layers (texture_cube).")
      (member :name cube-array :description "Array of cube maps — 6·N layers (texture_cube_array).")
      (member :name 3d :description "Volume view (texture_3d).")))
  (value-kind :name texture-aspect
    :description "GPUTextureAspect — which aspect(s) of a depth/stencil texture a view exposes."
    :underlying symbol
    :members (member-set
      (member :name all :description "All available aspects (color, or depth+stencil).")
      (member :name stencil-only :description "Only the stencil aspect of a depth-stencil texture.")
      (member :name depth-only :description "Only the depth aspect of a depth-stencil texture.")))

  ; ---- cross-reference symbols (resolved across the source + lowered forest) ----
  (value-kind :name module-ref
    :description "Reference to a declared (shader-module :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target shader-module))
  (value-kind :name buffer-ref
    :description "Reference to a declared (buffer :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target buffer))
  (value-kind :name data-ref
    :description "Reference to a declared (data :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target data))
  (value-kind :name render-pipeline-ref
    :description "Reference to a declared (render-pipeline :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target render-pipeline))
  (value-kind :name compute-pipeline-ref
    :description "Reference to a declared (compute-pipeline :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target compute-pipeline))
  (value-kind :name bind-group-ref
    :description "Reference to a declared (bind-group :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target bind-group))
  (value-kind :name render-bundle-ref
    :description "Reference to a declared (render-bundle :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target render-bundle))
  (value-kind :name queue-ref
    :description "Reference to a declared (queue :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target queue))
  (value-kind :name compute-pass-ref
    :description "Reference to a declared (compute-pass :name …), including one lowered from (init …) sugar."
    :underlying symbol
    :cross-ref (cross-ref :target compute-pass))
  ; `pipeline-ref` = `(cross-ref :target [render-pipeline compute-pipeline])`
  ; lived here until the descriptor cut. Its ONE consumer was the bind-group's
  ; `:layout-pipeline`, and `bind-group-layout-spec` below is the same group
  ; plus `bind-group-layout` — so the render/compute one-namespace property
  ; that closed the shared-namespace hole is unchanged, and keeping both meant two buckets over
  ; overlapping target sets reporting ONE collision twice.
  ;
  ; A bind group's `:layout` names the layout it is built against: a pipeline's
  ; auto-derived layout, or an explicit (bind-group-layout …). One key, because
  ; GPUBindGroupDescriptor.layout is one member — it was two mutually
  ; exclusive keys and an exactly-one group.
  ;
  ; A TARGET GROUP (`:target [a b c]`), never a union of ref kinds. A union
  ; resolves first-match while the emitter's tables are separate id spaces, so a
  ; render-pipeline and a bind-group-layout sharing a name would resolve one way
  ; here and bind the other downstream — the same hole, closed for `pipeline-ref`
  ; and `frame-step` the same way on 2026-08-17. As a group the three forms are
  ; ONE namespace: the collision is a `duplicate_cross_ref_target` at the second
  ; declaration, so a reference here resolves to exactly one form by
  ; construction, and the emitter's "did it resolve to a pipeline?" test is a
  ; lookup in its own tables rather than a guess.
  (value-kind :name bind-group-layout-spec
    :description "The layout a bind group is built against: a render-/compute-pipeline whose auto-layout it targets, or an explicit (bind-group-layout …). One namespace across the three."
    :underlying symbol
    :cross-ref (cross-ref :target [render-pipeline compute-pipeline bind-group-layout]))

  ; ---- runtime builtin data sources (write-buffer :data) ----
  (value-kind :name builtin-data-source
    :description "Runtime-provided uniform data the player writes each frame."
    :underlying symbol
    :members (member-set
      (member :name pngine-inputs :description "16 B: time, canvasWidth, canvasHeight, aspect (all f32).")
      (member :name scene-time-inputs :description "12 B: time, canvasWidth, canvasHeight (all f32) — the first 12 bytes of pngine-inputs. True scene timing is not modelled yet.")
      (member :name pointer-inputs :description "48 B: x, y, clickX, clickY, dx, dy, buttons, pressure, modifiers, scrollX, scrollY, _pad (all f32).")))
  ; The two ref arms are ONE cross-ref target group, never a union of two ref
  ; kinds: a union resolves first-match while the emitter looks the name up in
  ; separate id tables. A group gives one namespace — a
  ; `(data …)` and a `(wasm-call …)` that share a name collide at the second
  ; declaration, so "which table" is decided by the document, not by arm order.
  (value-kind :name data-or-wasm-ref
    :description "Reference to a declared (data :name …) or (wasm-call :name …). One namespace across the two."
    :underlying symbol
    :cross-ref (cross-ref :target [data wasm-call]))
  (value-kind :name write-buffer-source
    :description "write-buffer :data source: a runtime builtin, a (data …) reference, or a (wasm-call …) whose result is written each frame."
    :underlying union
    :union (union-shape :alternatives [builtin-data-source data-or-wasm-ref]))

  ; `byte-size` was `[byte-count data-ref]` — a union whose ref arm meant "size
  ; this buffer from that data without filling it". Every corpus use of it also
  ; carried `:mapped-at-creation <the same data>`, naming one thing twice, and
  ; `:data` sizes the buffer now. The arm is gone; a buffer's `:size` is a byte
  ; count.

  ; ---- enums ----
  (value-kind :name buffer-usage
    :description "GPUBufferUsage flag — what the buffer may be used for."
    :underlying symbol
    :members (member-set
      (member :name vertex :description "Usable as a vertex buffer in draw calls.")
      (member :name index :description "Usable as an index buffer in indexed draws.")
      (member :name uniform :description "Bindable as a uniform buffer (var<uniform>).")
      (member :name storage :description "Bindable as a read/write storage buffer (var<storage>).")
      (member :name copy-dst :description "Destination of copies and write-buffer ops.")
      (member :name copy-src :description "Source of copy operations.")
      (member :name indirect :description "Holds indirect draw/dispatch arguments.")
      (member :name query-resolve :description "Receives resolve-query-set results.")
      (member :name map-read :description "Mappable for CPU readback; combines with copy-dst and nothing else.")
      (member :name map-write :description "Mappable for CPU upload (write); combines with copy-src and nothing else.")))
  (value-kind :name primitive-topology
    :description "GPUPrimitiveTopology — how vertices are assembled into primitives."
    :underlying symbol
    :members (member-set
      (member :name triangle-list :description "Each triplet of vertices is a triangle.")
