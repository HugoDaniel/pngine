    :description "An override's value: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base override-value :ref define-ref))
  (value-kind :name layout-mode
    :description "Pipeline layout mode: auto derives bind-group layouts from the WGSL."
