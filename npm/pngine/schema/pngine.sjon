      (member :name texture-binding :description "Bindable as a sampled texture in shaders.")
      (member :name storage-binding :description "Bindable as a storage texture in shaders.")
      (member :name render-attachment :description "Usable as a color or depth/stencil attachment.")))
  (value-kind :name texture-size-mode
    :description "Texture sizing: `canvas` tracks the canvas size at runtime."
    :underlying symbol
    :members (member-set
      (member :name canvas :description "Track the canvas size at runtime (resizes with it).")))
  ; One dimension of a GPUExtent3D. `:min 1`, not `:min 0`: a zero-texel
  ; dimension is invalid GPU in every direction, and the keys this replaces
  ; (`:width`/`:height`, typed `byte-count`) accepted 0 and encoded it.
  (value-kind :name extent-value
    :description "One dimension of a GPUExtent3D, in texels (at least 1)."
    :underlying number
    :numeric (numeric-bounds :min 1 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name extent
    :description "One GPUExtent3D dimension: a literal, a bounded expression, or a bare (define …) reference."
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base extent-value :ref define-ref))
  ; GPUExtent3D's sequence form: [w], [w h], [w h d]. The missing dimensions are
  ; WebGPU's own defaults (height 1, depthOrArrayLayers 1), not pngine's — which
  ; is why they are absent rather than materialized (see the defaults policy at
  ; the top of this file). A vector, because a sequence of scalars is a vector;
  ; three keys, because it was three keys.
  (value-kind :name extent3
    :description "Texture size as [width], [width height], or [width height depth-or-array-layers]; the missing dimensions default to 1."
    :underlying vector
    :vector (vector-shape :element extent :min-len 1 :max-len 3))
  ; GPUTextureDescriptor.size is ONE required member, so it is one required key
  ; over the three things a pngine texture may be sized by. Three
  ; different underlyings — vector, symbol member, cross-ref — so the union
  ; cannot be ambiguous. `texture-size-mode` precedes `image-bitmap-ref` because
  ; both are symbols and `canvas` must be read as the mode; the emitter's
  ; reserved-name check keeps a form from claiming the name.
  (value-kind :name texture-size
    :description "Texture size: an [w h d] extent, `canvas` to track the canvas, or an (image-bitmap …) to take the decoded image's size."
    :underlying union
    :union (union-shape :alternatives [extent3 texture-size-mode image-bitmap-ref]))
  (value-kind :name index-format
    :description "GPUIndexFormat — byte width of index-buffer entries."
    :underlying symbol
    :members (member-set
      (member :name uint16 :description "16-bit indices (primitive-restart value 0xFFFF).")
      (member :name uint32 :description "32-bit indices (primitive-restart value 0xFFFFFFFF).")))
  (value-kind :name cull-mode
