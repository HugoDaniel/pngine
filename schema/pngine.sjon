; PNGine WebGPU schema — Phase 1 vertical slice.
;
; Single source of truth for what a PNGine `.sjon` document may contain. The
; compiler (`src/dsl_sjon/Compiler.zig`) prepends this manifest to the user
; source and runs `Host.validateDocument`, so the data forms below are validated
; against this plugin with no filesystem (works on wasm32-freestanding). It is
; `@embedFile`'d via the `pngine_schema` build import and feeds the web editor's
; TS / JSON-Schema export.
;
; Phase 1 covered the minimal core (define, shader-module, data-float32, buffer,
; queue, bind-group, render/compute pipeline + pass, frame, `init` sugar via the
; `pngine/init-v1` hook). Phase 2a adds shape generators (cube…dragon), textures
; (depth subset), depth/stencil pipeline state, and indexed draws. Samplers,
; imageBitmap, MRT/blend/MSAA and `(pass …)` land in later Phase 2 sub-waves.
;
; ---- Defaults policy (F6) — three DISTINCT notions, never conflated ----
;   1. Schema `:default V` is a PNGine OPINION. On key absence SJON materializes V
;      into the effective view (→ HostResult.materialized_defaults), so the emitter
;      always bakes a concrete value into the bytecode. Use it where PNGine commits
;      to a value even when WebGPU has none — e.g. `load-op :default clear` (WebGPU
;      REQUIRES loadOp; there is no spec default, so the opinion must ship).
;   2. A key with NO `:default`, left absent, defers to WebGPU's OWN spec default at
;      runtime — the emitter writes nothing and PNGine invents nothing.
;   3. js_codegen's omit-when-default (`--html`) is a SIZE ENCODING, not a semantic
;      source: it may drop a descriptor field ONLY when the emitted value equals
;      WebGPU's spec default (e.g. a buffer-binding offset 0 / size = rest-of-buffer),
;      leaning on WebGPU to refill it identically. A materialized OPINION that differs
;      from the WebGPU default (loadOp/storeOp/clearValue) is NEVER omitted.
(plugin :name pngine :version "0.1.0"

  ; ---- numeric refinements ----
  ; `:unit (unit-shape :reject true)` closes the silent `1.0f → 0` defect: SJON
  ; lexes a trailing letter as a unit suffix (`number_with_unit`), which a plain
  ; `:underlying number` slot would accept and the reader would drop to 0. Reject
  ; makes it a validation error (`unit_not_allowed`) with a span on the literal.
  ; `:repr (repr-shape :type u32)` tags these as GPU u32: the validator rejects an
  ; out-of-range / non-integer LITERAL (`repr_out_of_range`) before the emitter
  ; silently wraps it, and SJON's exporter emits the branded `U32` TS alias so the
  ; editor gets real per-field GPU types. Repr checks literals only — expressions
  ; (`:size (* NUM 4 4)`) and define-refs are evaluated later, untouched here.
  (value-kind :name byte-count
    :description "Non-negative integer byte size / offset / stride."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name pool-size
    :description "Ping-pong pool size (1..255). The ceiling is the wire's: the
                 pool index is a byte everywhere it is encoded, so a larger pool
                 cannot be addressed. Bounds a LITERAL; the emitter re-checks the
                 expression spelling (`:pool (* 100 3)`), which repr cannot see."
    :underlying number
    :numeric (numeric-bounds :min 1 :max 255 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name binding-index
    :description "Non-negative binding / group / pool index. The PNGB wire stores these as u8, so 255 is the ceiling (WebGPU's own maxBindingsPerBindGroup default is 1000, but PNGine's uniform table and descriptor encoding are byte-indexed)."
    :underlying number
    :numeric (numeric-bounds :min 0 :max 255 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name count-value
    :description "Non-negative integer draw / dispatch count (literals + expressions)."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  ; A count may also be a bare `#define` reference (a symbol the emitter
  ; resolves through the expr env), e.g. `:instance-count NUM_PARTICLES`.
  (value-kind :name count
    :description "Draw / dispatch count: a literal, a bounded expression, or a bare (define …) reference."
    :underlying union
    :union (union-shape :alternatives [count-value symbol]))
  ; A WebGPU device-limit value. Non-negative integer, u32-range in the schema
  ; (the PNGB wire carries u64 for forward-compat). Passed VERBATIM to
  ; requiredLimits at device creation — an unsatisfiable request fails loud there
  ; (the promise rejects / native exits nonzero), never silently clamps.
  (value-kind :name device-limit-value
    :description "A WebGPU device limit value: a non-negative integer (u32-range; the wire is u64)."
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name unorm
    :description "Clear-color component in [0,1]."
    :underlying number
    :numeric (numeric-bounds :min 0 :max 1)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name depth-bias-value
    :description "Depth bias term: constant (int) or slope-scale / clamp (real)."
    :underlying number
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name lod-clamp
    :description "Sampler mip level-of-detail clamp (non-negative real; WebGPU defaults lodMinClamp 0, lodMaxClamp 32)."
    :underlying number
    :numeric (numeric-bounds :min 0)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type f32))
  (value-kind :name anisotropy-value
    :description "Sampler max anisotropy (integer in [1,16]; values > 1 require linear mag/min/mipmap filters)."
    :underlying number
    :numeric (numeric-bounds :min 1 :max 16 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name texture-dimension
    :description "GPUTextureDimension as an integer: 1 = 1d, 2 = 2d (default), 3 = 3d. (`1d`/`2d`/`3d` are not bare symbols in SJON — they lex as number+unit — so the count is authored numerically.)"
    :underlying number
    :numeric (numeric-bounds :min 1 :max 3 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name subresource-count
    :description "Positive integer texture subresource count (≥ 1) — mip levels or array/3d layers. Defaults to 1."
    :underlying number
    :numeric (numeric-bounds :min 1 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name subresource-index
    :description "Zero-based texture subresource index (≥ 0) — a texture view's base mip level or base array layer. Defaults to 0. (subresource-count is ≥ 1; a base index is ≥ 0.)"
    :underlying number
    :numeric (numeric-bounds :min 0 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name view-dimension
    :description "GPUTextureViewDimension as an integer: 0 = 1d, 1 = 2d, 2 = 2d-array, 3 = cube, 4 = cube-array, 5 = 3d. (Authored numerically because `1d`/`2d`/`2d-array`/`3d` lex as number+unit in SJON, not symbols — keeping the whole enum numeric beats mixing symbolic `cube` with numeric `2d`.)"
    :underlying number
    :numeric (numeric-bounds :min 0 :max 5 :integer true)
    :unit (unit-shape :reject true)
    :repr (repr-shape :type u32))
  (value-kind :name texture-aspect
    :description "GPUTextureAspect — which aspect(s) of a depth/stencil texture a view exposes."
    :underlying symbol
    :members (member-set
      (member :name all :description "All available aspects (color, or depth+stencil).")
      (member :name stencil-only :description "Only the stencil aspect of a depth-stencil texture.")
      (member :name depth-only :description "Only the depth aspect of a depth-stencil texture.")))

  ; ---- cross-reference symbols (resolved across the source + lowered forest) ----
  (value-kind :name module-ref
    :description "Reference to a declared (shader-module :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target shader-module))
  (value-kind :name buffer-ref
    :description "Reference to a declared (buffer :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target buffer))
  (value-kind :name data-ref
    :description "Reference to a declared (data :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target data))
  (value-kind :name render-pipeline-ref
    :description "Reference to a declared (render-pipeline :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target render-pipeline))
  (value-kind :name compute-pipeline-ref
    :description "Reference to a declared (compute-pipeline :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target compute-pipeline))
  (value-kind :name wasm-call-ref
    :description "Reference to a declared (wasm-call :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target wasm-call))
  (value-kind :name bind-group-ref
    :description "Reference to a declared (bind-group :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target bind-group))
  (value-kind :name render-bundle-ref
    :description "Reference to a declared (render-bundle :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target render-bundle))
  (value-kind :name queue-ref
    :description "Reference to a declared (queue :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target queue))
  (value-kind :name render-pass-ref
    :description "Reference to a declared (render-pass :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target render-pass))
  (value-kind :name compute-pass-ref
    :description "Reference to a declared (compute-pass :name …), including one lowered from (init …) sugar."
    :underlying symbol
    :cross-ref (cross-ref :target compute-pass))
  ; A bind-group's :layout-pipeline may target either pipeline kind; the union
  ; tries render first, then falls through to compute on cross-ref miss.
  (value-kind :name pipeline-ref
    :description "Reference to a declared render- or compute-pipeline."
    :underlying union
    :union (union-shape :alternatives [render-pipeline-ref compute-pipeline-ref]))

  ; ---- runtime builtin data sources (write-buffer :data) ----
  (value-kind :name builtin-data-source
    :description "Runtime-provided uniform data the player writes each frame."
    :underlying symbol
    :members (member-set
      (member :name pngine-inputs :description "16 B: time, canvasWidth, canvasHeight, aspect (all f32).")
      (member :name scene-time-inputs :description "12 B: time, canvasWidth, canvasHeight (all f32) — the first 12 bytes of pngine-inputs. True scene timing is a planned extension (docs/plans/spec/01).")
      (member :name pointer-inputs :description "48 B: x, y, clickX, clickY, dx, dy, buttons, pressure, modifiers, scrollX, scrollY, _pad (all f32).")))
  (value-kind :name write-buffer-source
    :description "write-buffer :data source: a runtime builtin or a (data …) reference."
    :underlying union
    :union (union-shape :alternatives [builtin-data-source data-ref]))

  ; ---- size: a byte count / expression OR a data-ref the buffer is sized from ----
  (value-kind :name byte-size
    :description "Buffer size: an integer / expression, or a (data …) reference."
    :underlying union
    :union (union-shape :alternatives [byte-count data-ref]))

  ; ---- enums ----
  (value-kind :name buffer-usage
    :description "GPUBufferUsage flag — what the buffer may be used for."
    :underlying symbol
    :members (member-set
      (member :name vertex :description "Usable as a vertex buffer in draw calls.")
      (member :name index :description "Usable as an index buffer in indexed draws.")
      (member :name uniform :description "Bindable as a uniform buffer (var<uniform>).")
      (member :name storage :description "Bindable as a read/write storage buffer (var<storage>).")
      (member :name copy-dst :description "Destination of copies and write-buffer ops.")
      (member :name copy-src :description "Source of copy operations.")
      (member :name indirect :description "Holds indirect draw/dispatch arguments.")
      (member :name query-resolve :description "Receives resolve-query-set results.")
      (member :name map-read :description "Mappable for CPU readback.")
      (member :name map-write :description "Mappable for CPU upload (write).")))
  (value-kind :name primitive-topology
    :description "GPUPrimitiveTopology — how vertices are assembled into primitives."
    :underlying symbol
    :members (member-set
      (member :name triangle-list :description "Each triplet of vertices is a triangle.")
      (member :name triangle-strip :description "Each vertex after the first two forms a triangle with the previous two.")
      (member :name line-list :description "Each pair of vertices is a line.")
      (member :name line-strip :description "Each vertex after the first extends a line from the previous one.")
      (member :name point-list :description "Each vertex is a point.")))
  (value-kind :name load-op
    :description "GPULoadOp — what happens to an attachment at render-pass start."
    :underlying symbol
    :members (member-set
      (member :name clear :description "Clear the attachment to the clear value at pass start.")
      (member :name load :description "Preserve the attachment's existing contents.")))
  (value-kind :name store-op
    :description "GPUStoreOp — what happens to an attachment at render-pass end."
    :underlying symbol
    :members (member-set
      (member :name store :description "Keep the pass result in the attachment.")
      (member :name discard :description "Discard the result (the attachment reads back as cleared).")))
  (value-kind :name vertex-format
    :description "GPUVertexFormat — wire format of one vertex attribute."
    :underlying symbol
    :members (member-set
      ; 8-bit
      (member :name uint8 :description "One 8-bit unsigned int (1 B) → u32.")
      (member :name uint8x2 :description "Two 8-bit unsigned ints (2 B) → vec2u.")
      (member :name uint8x4 :description "Four 8-bit unsigned ints (4 B) → vec4u.")
      (member :name sint8 :description "One 8-bit signed int (1 B) → i32.")
      (member :name sint8x2 :description "Two 8-bit signed ints (2 B) → vec2i.")
      (member :name sint8x4 :description "Four 8-bit signed ints (4 B) → vec4i.")
      (member :name unorm8 :description "One 8-bit unsigned normalized (1 B) → f32 in [0,1].")
      (member :name unorm8x2 :description "Two 8-bit unsigned normalized (2 B) → vec2f in [0,1].")
      (member :name unorm8x4 :description "Four 8-bit unsigned normalized (4 B) → vec4f in [0,1].")
      (member :name snorm8 :description "One 8-bit signed normalized (1 B) → f32 in [-1,1].")
      (member :name snorm8x2 :description "Two 8-bit signed normalized (2 B) → vec2f in [-1,1].")
      (member :name snorm8x4 :description "Four 8-bit signed normalized (4 B) → vec4f in [-1,1].")
      ; 16-bit
      (member :name uint16 :description "One 16-bit unsigned int (2 B) → u32.")
      (member :name uint16x2 :description "Two 16-bit unsigned ints (4 B) → vec2u.")
      (member :name uint16x4 :description "Four 16-bit unsigned ints (8 B) → vec4u.")
      (member :name sint16 :description "One 16-bit signed int (2 B) → i32.")
      (member :name sint16x2 :description "Two 16-bit signed ints (4 B) → vec2i.")
      (member :name sint16x4 :description "Four 16-bit signed ints (8 B) → vec4i.")
      (member :name unorm16 :description "One 16-bit unsigned normalized (2 B) → f32 in [0,1].")
      (member :name unorm16x2 :description "Two 16-bit unsigned normalized (4 B) → vec2f in [0,1].")
      (member :name unorm16x4 :description "Four 16-bit unsigned normalized (8 B) → vec4f in [0,1].")
      (member :name snorm16 :description "One 16-bit signed normalized (2 B) → f32 in [-1,1].")
      (member :name snorm16x2 :description "Two 16-bit signed normalized (4 B) → vec2f in [-1,1].")
      (member :name snorm16x4 :description "Four 16-bit signed normalized (8 B) → vec4f in [-1,1].")
      (member :name float16 :description "One 16-bit float (2 B) → f32.")
      (member :name float16x2 :description "Two 16-bit floats (4 B) → vec2f.")
      (member :name float16x4 :description "Four 16-bit floats (8 B) → vec4f.")
      ; 32-bit
      (member :name float32 :description "One 32-bit float (4 B) → f32.")
      (member :name float32x2 :description "Two 32-bit floats (8 B) → vec2f.")
      (member :name float32x3 :description "Three 32-bit floats (12 B) → vec3f.")
      (member :name float32x4 :description "Four 32-bit floats (16 B) → vec4f.")
      (member :name uint32 :description "One 32-bit unsigned int (4 B) → u32.")
      (member :name uint32x2 :description "Two 32-bit unsigned ints (8 B) → vec2u.")
      (member :name uint32x3 :description "Three 32-bit unsigned ints (12 B) → vec3u.")
      (member :name uint32x4 :description "Four 32-bit unsigned ints (16 B) → vec4u.")
      (member :name sint32 :description "One 32-bit signed int (4 B) → i32.")
      (member :name sint32x2 :description "Two 32-bit signed ints (8 B) → vec2i.")
      (member :name sint32x3 :description "Three 32-bit signed ints (12 B) → vec3i.")
      (member :name sint32x4 :description "Four 32-bit signed ints (16 B) → vec4i.")
      ; packed
      (member :name unorm10-10-10-2 :description "Packed 10/10/10/2-bit unsigned normalized (4 B) → vec4f in [0,1].")
      (member :name unorm8x4-bgra :description "Four 8-bit unsigned normalized in BGRA order (4 B) → vec4f in [0,1].")))
  (value-kind :name step-mode
    :description "GPUVertexStepMode — whether a vertex buffer advances per vertex or per instance."
    :underlying symbol
    :members (member-set
      (member :name vertex :description "Advance by array-stride per vertex (resets each instance).")
      (member :name instance :description "Advance by array-stride per instance.")))
  (value-kind :name entry-point
    :description "Shader entry-point function name (a WGSL @vertex/@fragment/@compute fn)."
    :underlying symbol)
  ; Follows `entry-point`: a free symbol naming something inside opaque WGSL,
  ; which the EMITTER cross-checks against reflection. SJON cannot check it —
  ; the override declarations live inside a `:code` string the validator does
  ; not parse (see docs/plans/constants/05-lowered-reflection.md for the route
  ; that would change that, and why it is blocked upstream).
  (value-kind :name override-name
    :description "A WGSL `override` identifier, as written in the shader. An @id(N)-annotated override is still named by its identifier here — pngine resolves the value at compile time, so the numeric id never reaches a runtime."
    :underlying symbol)
  ; Deliberately NOT :repr-tagged. A constant's width is whatever its WGSL
  ; `override` declares (f32/u32/i32/bool), which the schema cannot see; the
  ; emitter type-checks the value against the reflected type instead. A repr
  ; tag here would be a guess that rejects valid documents.
  (value-kind :name override-value
    :description "The value to specialise a WGSL `override` with: an integer or real literal, or a bounded expression over (define …) constants. A bool override takes 0 or 1."
    :underlying number
    :unit (unit-shape :reject true))
  (value-kind :name layout-mode
    :description "Pipeline layout mode: auto derives bind-group layouts from the WGSL."
    :underlying symbol
    :members (member-set :values [auto]))

  ; ---- builtin symbol sets the emitter maps to runtime encodings ----
  (value-kind :name view-source
    :description "Builtin attachment view: context-current-texture is the canvas's current texture."
    :underlying symbol
    :members (member-set
      (member :name context-current-texture :description "The canvas's current swapchain texture.")))
  (value-kind :name color-target-format
    :description "Color target format. preferred-canvas-format resolves to the platform's canvas format at runtime."
    :underlying symbol
    :members (member-set
      (member :name preferred-canvas-format :description "Resolved at runtime to the platform's canvas format (bgra8unorm on macOS, rgba8unorm elsewhere).")
      (member :name bgra8unorm :description "4×8-bit unorm, BGRA order; common canvas format.")
      (member :name rgba8unorm :description "4×8-bit unorm; renderable, filterable, blendable.")
      (member :name rgba16float :description "4×16-bit float; renderable, filterable, blendable; HDR-capable.")
      (member :name r32uint :description "1×32-bit unsigned int; renderable, not blendable (e.g. a primitive-id MRT pick target).")
      ; ---- base-renderable color / srgb / packed (RENDER_ATTACHMENT without a device feature) ----
      (member :name r8unorm :description "1×8-bit unorm; renderable, filterable, blendable.")
      (member :name r8uint :description "1×8-bit unsigned int; renderable, not blendable.")
      (member :name r8sint :description "1×8-bit signed int; renderable, not blendable.")
      (member :name rg8unorm :description "2×8-bit unorm; renderable, filterable, blendable.")
      (member :name rg8uint :description "2×8-bit unsigned int; renderable, not blendable.")
      (member :name rg8sint :description "2×8-bit signed int; renderable, not blendable.")
      (member :name rgba8unorm-srgb :description "4×8-bit unorm, sRGB-encoded; renderable, filterable, blendable.")
      (member :name rgba8uint :description "4×8-bit unsigned int; renderable, not blendable.")
      (member :name rgba8sint :description "4×8-bit signed int; renderable, not blendable.")
      (member :name r16uint :description "1×16-bit unsigned int; renderable, not blendable.")
      (member :name r16sint :description "1×16-bit signed int; renderable, not blendable.")
      (member :name r16float :description "1×16-bit float; renderable, filterable, blendable.")
      (member :name rg16uint :description "2×16-bit unsigned int; renderable, not blendable.")
      (member :name rg16sint :description "2×16-bit signed int; renderable, not blendable.")
      (member :name rg16float :description "2×16-bit float; renderable, filterable, blendable.")
      (member :name r32sint :description "1×32-bit signed int; renderable, not blendable.")
      (member :name r32float :description "1×32-bit float; renderable; blendable only with the float32-blendable feature.")
      (member :name rg32uint :description "2×32-bit unsigned int; renderable, not blendable.")
      (member :name rg32sint :description "2×32-bit signed int; renderable, not blendable.")
      (member :name rg32float :description "2×32-bit float; renderable; blendable only with the float32-blendable feature.")
      (member :name rgba16uint :description "4×16-bit unsigned int; renderable, not blendable.")
      (member :name rgba16sint :description "4×16-bit signed int; renderable, not blendable.")
      (member :name rgba32uint :description "4×32-bit unsigned int; renderable, not blendable.")
      (member :name rgba32sint :description "4×32-bit signed int; renderable, not blendable.")
      (member :name rgba32float :description "4×32-bit float; renderable; blendable only with the float32-blendable feature.")
      (member :name rgb10a2uint :description "Packed 10/10/10/2-bit unsigned int; renderable, not blendable.")
      (member :name rgb10a2unorm :description "Packed 10/10/10/2-bit unorm; renderable, filterable, blendable.")
      ; ---- feature-gated render targets (the runtime requests the feature so they render where the adapter allows) ----
      (member :name r8snorm :description "1×8-bit signed norm; render-attachment + blendable need texture-formats-tier1.")
      (member :name rg8snorm :description "2×8-bit signed norm; render-attachment + blendable need texture-formats-tier1.")
      (member :name rgba8snorm :description "4×8-bit signed norm; render-attachment + blendable need texture-formats-tier1.")
      (member :name rg11b10ufloat :description "Packed 11/11/10-bit unsigned float; render-attachment needs rg11b10ufloat-renderable (implied by texture-formats-tier1).")
      (member :name bgra8unorm-srgb :description "4×8-bit unorm, BGRA, sRGB; renderable; needs core-features-and-limits (present on any core, non-compat device).")
      (member :name r16unorm :description "1×16-bit unorm; renderable + blendable with texture-formats-tier1.")
      (member :name r16snorm :description "1×16-bit signed norm; renderable + blendable with texture-formats-tier1.")
      (member :name rg16unorm :description "2×16-bit unorm; renderable + blendable with texture-formats-tier1.")
      (member :name rg16snorm :description "2×16-bit signed norm; renderable + blendable with texture-formats-tier1.")
      (member :name rgba16unorm :description "4×16-bit unorm; renderable + blendable with texture-formats-tier1.")
      (member :name rgba16snorm :description "4×16-bit signed norm; renderable + blendable with texture-formats-tier1.")))

  ; ---- query sets: GPU timestamp / occlusion queries ----
  (value-kind :name query-type
    :description "GPUQueryType — what a query in the set measures."
    :underlying symbol
    :members (member-set
      (member :name occlusion :description "Counts samples passing depth/stencil within an (occlusion-query …) bracket.")
      (member :name timestamp :description "Records a GPU timestamp in nanoseconds (64-bit).")))
  (value-kind :name query-set-ref
    :description "Reference to a declared (query-set :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target query-set))
  (value-kind :name timestamp-writes-item :underlying form :heads (head-set :names [timestamp-writes]))
  ; Heads admitted positionally inside an (occlusion-query …) bracket.
  (value-kind :name occlusion-draw-item :underlying form :heads (head-set :names [draw draw-indexed]))

  ; ---- Phase 2a: textures, shape generators, depth/stencil, indexed draws ----
  (value-kind :name texture-ref
    :description "Reference to a declared (texture :name …)."
    :underlying symbol
    :cross-ref (cross-ref :target texture))
