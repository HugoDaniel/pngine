      (member :name rgb9e5ufloat :description "Packed 9/9/9-bit float, shared 5-bit exponent; filterable, not renderable.")
      ; ---- feature-gated (encoded unconditionally; the runtime requests the device feature so they render where the adapter allows) ----
      (member :name bgra8unorm-srgb :description "4×8-bit unorm, BGRA order, sRGB-encoded; needs core-features-and-limits (present on any core, non-compat device).")
      (member :name r16unorm :description "1×16-bit unorm; needs texture-formats-tier1. Renderable + blendable when enabled.")
      (member :name r16snorm :description "1×16-bit signed norm; needs texture-formats-tier1. Renderable + blendable when enabled.")
