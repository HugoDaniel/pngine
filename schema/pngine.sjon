  (value-kind :name address-mode
    :description "GPUAddressMode — behavior of texture coordinates outside [0,1]."
    :underlying symbol
    :members (member-set
      (member :name clamp-to-edge :description "Clamp coordinates to the edge texel.")
      (member :name repeat :description "Wrap around to the opposite side.")
      (member :name mirror-repeat :description "Wrap, mirroring the texture on odd repeats.")))
  (value-kind :name compare-function
    :description "GPUCompareFunction — predicate for depth / stencil / sampler comparison tests."
    :underlying symbol
    :members (member-set
      (member :name never :description "Never passes.")
      (member :name less :description "Passes if provided value < stored value.")
      (member :name equal :description "Passes if provided value = stored value.")
      (member :name less-equal :description "Passes if provided value <= stored value.")
      (member :name greater :description "Passes if provided value > stored value.")
      (member :name not-equal :description "Passes if provided value != stored value.")
      (member :name greater-equal :description "Passes if provided value >= stored value.")
      (member :name always :description "Always passes.")))
  (value-kind :name stencil-operation
    :description "GPUStencilOperation — how the stencil value is updated after a test."
    :underlying symbol
    :members (member-set
      (member :name keep :description "Keep the current stencil value.")
      (member :name zero :description "Set the stencil value to 0.")
      (member :name replace :description "Set the stencil value to the pass's stencil-reference.")
      (member :name invert :description "Bitwise-invert the current stencil value.")
      (member :name increment-clamp :description "Increment, clamping at the maximum value.")
      (member :name decrement-clamp :description "Decrement, clamping at 0.")
      (member :name increment-wrap :description "Increment, wrapping to 0 past the maximum.")
